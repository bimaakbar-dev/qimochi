---
// src/layouts/BlogLayout.astro

import Layout from "./Layout.astro";
import PageFrame from "@/components/PageFrame.astro";
import ScrollToTop from "@docs/mobile/ScrollToTop.astro";

const $ = {
  main: "w-full min-w-0 flex-1",
  left: [
    "w-full min-w-0 px-2 pb-(--safe-bottom) lg:h-[calc(100vh-var(--header-height))]",
    "sticky top-(--header-height)",
    "hidden lg:block",
    "overflow-y-auto"
  ].join(" "),
  right: [
    "w-full min-w-0 px-2 pb-(--safe-bottom) lg:h-[calc(100vh-var(--header-height))]",
    "sticky top-(--header-height)",
    "hidden lg:block",
    "overflow-y-auto"
  ].join(" "),
}
---
<Layout>
  <PageFrame>
    <aside class={$.left}>
      <slot name="left" />
    </aside>
    <main id="main-content" class={$.main}>
      <slot />
    </main>
    <aside class={$.right}>
      <slot name="right" />
    </aside>
  </PageFrame>
  <ScrollToTop />
</Layout>
