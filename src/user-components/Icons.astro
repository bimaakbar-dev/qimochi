    <path d="M5 12l6 6" />
    <path d="M5 12l6 -6" />
  `,
  'arrow-right':  `
    <path d="M5 12l14 0" />
    <path d="M13 18l6 -6" />
    <path d="M13 6l6 6" />
  `,
  'chevron-down': '<path d="M6 9l6 6l6 -6" />',
  'download':     '<path d="M8 2v8M4 7l4 4 4-4M3 14h10" />',
  'search':       `
