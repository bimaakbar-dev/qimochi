  | 'pause'
  | 'arrow-left'
  | 'arrow-right'
  | 'chevron-down'
  | 'download'
  | 'search'
  | 'menu'
  | 'close'
  | 'external'
  | 'star'
  | 'tv'
  | 'list'
  | 'book'
  | 'rss'
  | 'bookmark'
  | 'bookmark-filled'
  | 'share'
  | 'user'
  | 'prev'
  | 'next';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 16 } = Astro.props;

const paths: Record<IconName, string> = {
