---
import { URLS } from '~/constants';
import LinkButton from '~/user-components/LinkButton.astro';
import ReportButton from './ReportToggle.astro';

interface Props {
  slug?: string;
  episodeNumber?: number;
  totalEpisodes?: number;
  server?: string;
  quality?: string;
}

const {
  slug = '',
  episodeNumber = 1,
  totalEpisodes = 0,
  server = '',
  quality = '',
} = Astro.props;

const hasPrev = episodeNumber > 1;
const hasNext = episodeNumber < totalEpisodes;
const prevEp = hasPrev ? episodeNumber - 1 : null;
const nextEp = hasNext ? episodeNumber + 1 : null;
---

<nav class="action-bar" aria-label="Navigasi episode">
  {hasPrev ? (
    <LinkButton
      href={URLS.watch(slug, prevEp!)}
      variant="outline"
      size="md"
      icon="prev"
    >
      Ep {prevEp}
    </LinkButton>
  ) : (
    <LinkButton
      variant="outline"
      size="md"
      icon="prev"
      disabled
    >
      Ep —
    </LinkButton>
  )}
  
  <ReportButton
    slug={slug}
    episode={episodeNumber}
    server={server}
    quality={quality}
  />

  {hasNext ? (
    <LinkButton
      href={URLS.watch(slug, nextEp!)}
      variant="outline"
      size="md"
      icon="next"
      iconPos="suffix"
    >
      Ep {nextEp}
    </LinkButton>
  ) : (
    <LinkButton
      variant="outline"
      size="md"
      icon="next"
      iconPos="suffix"
      disabled
    >
      Ep —
    </LinkButton>
  )}
</nav>

<style>
  .action-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
  }
</style>