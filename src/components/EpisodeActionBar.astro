---
import Icon from '~/user-components/Icons.astro';
import { URLS } from '~/constants';

interface NavItem {
  number: number;
  title?: string | null;
  duration?: number | null;
}

interface Props {
  slug?: string;
  animeTitle?: string;
  currentEpisode?: number;
  totalEpisodes?: number;
  prevEpisode?: NavItem | null;
  nextEpisode?: NavItem | null;
  thumbnail?: string;
  class?: string;
}

const {
  slug = '',
  animeTitle = '',
  currentEpisode = 1,
  totalEpisodes = 0,
  prevEpisode = null,
  nextEpisode = null,
  thumbnail = '',
  class: className,
} = Astro.props;

const watchBase = URLS.watch(slug, 1);

function formatDur(d?: number | null): string | null {
  if (typeof d !== 'number' || d <= 0) return null;
  return `${d}m`;
}

function epLabel(item: NavItem): string {
  return item.title
    ? `E${item.number} – ${item.title}`
    : `Episode ${item.number}`;
}

const prevDur = formatDur(prevEpisode?.duration);
const nextDur = formatDur(nextEpisode?.duration);
---

<nav
  class:list={['ep-nav', className]}
  data-action-bar
  data-watch-base={watchBase}
  data-slug={slug}
  aria-label="Navigasi episode"
>
  <div class="ep-nav__stack">
    <div
      class="ep-nav__slot"
      data-nav-prev-wrap
      hidden={!prevEpisode}
    >
      <span class="ep-nav__label">Episode Sebelumnya</span>
      <a
        class="ep-nav__card"
        href={prevEpisode ? URLS.watch(slug, prevEpisode.number) : undefined}
        data-nav-prev
        data-episode-nav={prevEpisode ? String(prevEpisode.number) : undefined}
        aria-label={prevEpisode ? `Episode sebelumnya, Ep ${prevEpisode.number}` : undefined}
      >
        <div class="ep-nav__thumb">
          {thumbnail ? (
            <img src={thumbnail} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="ep-nav__thumb-fallback" aria-hidden="true">
              {prevEpisode ? String(prevEpisode.number).padStart(2, '0') : ''}
            </div>
          )}
          {prevDur && <span class="ep-nav__dur">{prevDur}</span>}
        </div>
        <div class="ep-nav__body">
          <span class="ep-nav__title" data-nav-prev-label>
            {prevEpisode ? epLabel(prevEpisode) : ''}
          </span>
          <span class="ep-nav__meta">Sub Indo</span>
        </div>
      </a>
    </div>
    <div
      class="ep-nav__slot"
      data-nav-next-wrap
      hidden={!nextEpisode}
    >
      <span class="ep-nav__label">Episode Berikutnya</span>
      <a
        class="ep-nav__card"
        href={nextEpisode ? URLS.watch(slug, nextEpisode.number) : undefined}
        data-nav-next
        data-episode-nav={nextEpisode ? String(nextEpisode.number) : undefined}
        aria-label={nextEpisode ? `Episode berikutnya, Ep ${nextEpisode.number}` : undefined}
      >
        <div class="ep-nav__thumb">
          {thumbnail ? (
            <img src={thumbnail} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="ep-nav__thumb-fallback" aria-hidden="true">
              {nextEpisode ? String(nextEpisode.number).padStart(2, '0') : ''}
            </div>
          )}
          {nextDur && <span class="ep-nav__dur">{nextDur}</span>}
        </div>
        <div class="ep-nav__body">
          <span class="ep-nav__title" data-nav-next-label>
            {nextEpisode ? epLabel(nextEpisode) : ''}
          </span>
          <span class="ep-nav__meta">Sub Indo</span>
        </div>
      </a>
    </div>
  </div>

  <div class="ep-nav__tools">
    <button
      type="button"
      class="ep-nav__see-all"
      data-open-episodes-modal
      aria-haspopup="dialog"
    >
      <span>Lihat Semua Episode</span>
    </button>
  </div>
</nav>

<style>
  .ep-nav {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    width: 100%;
  }

  .ep-nav__stack {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .ep-nav__slot {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .ep-nav__slot[hidden] { display: none; }

  .ep-nav__label {
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
    line-height: 1.2;
    padding-left: 2px;
  }

  .ep-nav__card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2);
    background: transparent;
    color: inherit;
    text-decoration: none;
    transition:
      background var(--t-fast),
      border-color var(--t-fast);
    min-width: 0;
  }

  .ep-nav__card:hover {
    background: var(--bg-surface);
  }

  .ep-nav__card:hover .ep-nav__title {
    color: var(--accent);
  }

  .ep-nav__thumb {
    position: relative;
    width: 7rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface);
    flex-shrink: 0;
  }

  .ep-nav__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ep-nav__thumb-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-montserrat);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .ep-nav__dur {
    position: absolute;
    right: var(--s-2);
    bottom: var(--s-2);
    z-index: 2;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.78);
    color: var(--text-inverted);
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .ep-nav__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .ep-nav__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    overflow: hidden;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    transition: color var(--t-fast);
  }

  .ep-nav__meta {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.2;
  }

  .ep-nav__tools {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .ep-nav__see-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    font-family: inherit;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all var(--t-fast);
  }

  .ep-nav__see-all:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>

<script>
  interface NavItem {
    number: number;
    title: string | null;
    duration: number | null;
  }

  interface MountData {
    slug: string;
    current: number;
    total: number;
    thumbnail: string;
    prev: NavItem | null;
    next: NavItem | null;
  }

  interface ActionBarAPI {
    mount(root: HTMLElement, data: MountData): void;
  }

  function resolveNav(root: HTMLElement): HTMLElement | null {
    if (root.hasAttribute('data-action-bar')) return root;
    return root.querySelector<HTMLElement>('[data-action-bar]');
  }

  function urlFor(watchBase: string, ep: number): string {
    if (!watchBase) return '#';
    return ep <= 1 ? watchBase : `${watchBase}?ep=${ep}`;
  }

  function titleText(item: NavItem): string {
    return item.title
      ? `E${item.number} – ${item.title}`
      : `Episode ${item.number}`;
  }

  function durText(item: NavItem): string | null {
    if (typeof item.duration !== 'number' || item.duration <= 0) return null;
    return `${item.duration}m`;
  }

  function renderSlot(
    slot: HTMLElement | null,
    item: NavItem | null,
    watchBase: string,
    kind: 'prev' | 'next',
    thumbnail: string
  ): void {
    if (!slot) return;

    if (!item) {
      slot.hidden = true;
      return;
    }

    slot.hidden = false;

    const card = slot.querySelector<HTMLAnchorElement>('.ep-nav__card');
    if (!card) return;

    const img = card.querySelector<HTMLImageElement>('.ep-nav__thumb img');
    const fallbackEl = card.querySelector<HTMLElement>('.ep-nav__thumb-fallback');
    const durEl = card.querySelector<HTMLElement>('.ep-nav__dur');
    const titleEl = card.querySelector<HTMLElement>(
      '[data-nav-prev-label], [data-nav-next-label]'
    );
    const metaEl = card.querySelector<HTMLElement>('.ep-nav__meta');

    card.href = urlFor(watchBase, item.number);
    card.setAttribute('data-episode-nav', String(item.number));
    card.setAttribute(
      'aria-label',
      kind === 'prev'
        ? `Episode sebelumnya, Ep ${item.number}`
        : `Episode berikutnya, Ep ${item.number}`
    );

    if (img && thumbnail) {
      img.src = thumbnail;
      img.hidden = false;
      if (fallbackEl) fallbackEl.hidden = true;
    } else if (img) {
      img.hidden = true;
      if (fallbackEl) {
        fallbackEl.hidden = false;
        fallbackEl.textContent = String(item.number).padStart(2, '0');
      }
    }

    const d = durText(item);
    if (durEl) {
      if (d) {
        durEl.textContent = d;
        durEl.hidden = false;
      } else {
        durEl.hidden = true;
      }
    }

    if (titleEl) titleEl.textContent = titleText(item);
    if (metaEl) metaEl.textContent = 'Sub Indo';
  }

  function mount(root: HTMLElement, data: MountData): void {
    const nav = resolveNav(root);
    if (!nav) return;

    const watchBase = nav.dataset.watchBase ?? '';
    if (!watchBase) return;

    const prevWrap = nav.querySelector<HTMLElement>('[data-nav-prev-wrap]');
    const nextWrap = nav.querySelector<HTMLElement>('[data-nav-next-wrap]');

    renderSlot(prevWrap, data.prev, watchBase, 'prev', data.thumbnail);
    renderSlot(nextWrap, data.next, watchBase, 'next', data.thumbnail);
  }

  (window as any).__qimochiActionBar = { mount } satisfies ActionBarAPI;
</script>
