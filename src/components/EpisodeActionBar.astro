---
import Icon from '~/user-components/Icons.astro';
import { URLS } from '~/constants';
import ReportButton from './ReportToggle.astro';

interface NavItem {
  number: number;
  title?: string | null;
  duration?: number | null;
}

interface Props {
  slug?: string;
  animeTitle?: string;
  currentEpisode?: number;
  totalEpisodes?: number;
  prevEpisode?: NavItem | null;
  nextEpisode?: NavItem | null;
  thumbnail?: string;
  server?: string;
  quality?: string;
  class?: string;
}

const {
  slug = '',
  animeTitle = '',
  currentEpisode = 1,
  totalEpisodes = 0,
  prevEpisode = null,
  nextEpisode = null,
  thumbnail = '',
  server = '',
  quality = '',
  class: className,
} = Astro.props;

const watchBase = URLS.watch(slug, 1);
const detailUrl = slug ? URLS.anime(slug) : '/';

function formatDur(d?: number | null): string | null {
  if (typeof d !== 'number' || d <= 0) return null;
  return `${d}m`;
}

const prevDur = formatDur(prevEpisode?.duration);
const nextDur = formatDur(nextEpisode?.duration);
---

<nav
  class:list={['ep-nav', className]}
  data-action-bar
  data-watch-base={watchBase}
  data-slug={slug}
  aria-label="Navigasi episode"
>
  <div class="ep-nav__grid">
    {/* ── Prev ── */}
    {prevEpisode ? (
      <a
        class="ep-nav__card"
        href={URLS.watch(slug, prevEpisode.number)}
        data-nav-prev
        data-episode-nav={prevEpisode.number}
        aria-label={`Episode sebelumnya, Ep ${prevEpisode.number}`}
      >
        <div class="ep-nav__thumb">
          {thumbnail ? (
            <img src={thumbnail} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="ep-nav__thumb-fallback" aria-hidden="true">
              {String(prevEpisode.number).padStart(2, '0')}
            </div>
          )}
          {prevDur && <span class="ep-nav__dur">{prevDur}</span>}
        </div>
        <div class="ep-nav__body">
          <span class="ep-nav__eyebrow">Episode Sebelumnya</span>
          <span class="ep-nav__title" data-nav-prev-label>
            {prevEpisode.title
              ? `E${prevEpisode.number} – ${prevEpisode.title}`
              : `Episode ${prevEpisode.number}`}
          </span>
          <span class="ep-nav__meta">Sub Indo</span>
        </div>
      </a>
    ) : (
      <div class="ep-nav__card ep-nav__card--disabled" aria-hidden="true">
        <div class="ep-nav__thumb">
          <div class="ep-nav__thumb-fallback">—</div>
        </div>
        <div class="ep-nav__body">
          <span class="ep-nav__eyebrow">Episode Sebelumnya</span>
          <span class="ep-nav__title ep-nav__title--muted">Tidak ada</span>
          <span class="ep-nav__meta ep-nav__meta--muted">—</span>
        </div>
      </div>
    )}

    {/* ── Next ── */}
    {nextEpisode ? (
      <a
        class="ep-nav__card"
        href={URLS.watch(slug, nextEpisode.number)}
        data-nav-next
        data-episode-nav={nextEpisode.number}
        aria-label={`Episode berikutnya, Ep ${nextEpisode.number}`}
      >
        <div class="ep-nav__thumb">
          {thumbnail ? (
            <img src={thumbnail} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="ep-nav__thumb-fallback" aria-hidden="true">
              {String(nextEpisode.number).padStart(2, '0')}
            </div>
          )}
          {nextDur && <span class="ep-nav__dur">{nextDur}</span>}
        </div>
        <div class="ep-nav__body">
          <span class="ep-nav__eyebrow">Episode Berikutnya</span>
          <span class="ep-nav__title" data-nav-next-label>
            {nextEpisode.title
              ? `E${nextEpisode.number} – ${nextEpisode.title}`
              : `Episode ${nextEpisode.number}`}
          </span>
          <span class="ep-nav__meta">Sub Indo</span>
        </div>
      </a>
    ) : (
      <div class="ep-nav__card ep-nav__card--disabled" aria-hidden="true">
        <div class="ep-nav__thumb">
          <div class="ep-nav__thumb-fallback">—</div>
        </div>
        <div class="ep-nav__body">
          <span class="ep-nav__eyebrow">Episode Berikutnya</span>
          <span class="ep-nav__title ep-nav__title--muted">Tidak ada</span>
          <span class="ep-nav__meta ep-nav__meta--muted">—</span>
        </div>
      </div>
    )}
  </div>

  <div class="ep-nav__tools">
    <ReportButton
      slug={slug}
      episode={currentEpisode}
      server={server}
      quality={quality}
    />
    <a class="ep-nav__see-all" href={detailUrl}>
      <Icon name="list" size={14} />
      <span>Lihat Semua Episode</span>
    </a>
  </div>
</nav>

<style>
  .ep-nav {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    width: 100%;
  }

  .ep-nav__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
  }

  @media (min-width: 50rem) {
    .ep-nav__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }

  .ep-nav__card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition:
      background var(--t-fast),
      border-color var(--t-fast),
      transform var(--t-fast);
    min-width: 0;
  }

  a.ep-nav__card:hover {
    border-color: var(--accent);
    background: var(--bg-surface);
  }

  a.ep-nav__card:hover .ep-nav__title {
    color: var(--accent);
  }

  a.ep-nav__card:hover .ep-nav__thumb img {
    transform: scale(1.04);
  }

  .ep-nav__card--disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: var(--bg-base);
  }

  .ep-nav__thumb {
    position: relative;
    width: 6.5rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface);
    flex-shrink: 0;
  }

  @media (min-width: 50rem) {
    .ep-nav__thumb {
      width: 7.5rem;
    }
  }

  .ep-nav__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-base);
  }

  .ep-nav__thumb-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-montserrat);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .ep-nav__dur {
    position: absolute;
    right: var(--s-2);
    bottom: var(--s-2);
    z-index: 2;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.78);
    color: var(--text-inverted);
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .ep-nav__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .ep-nav__eyebrow {
    font-size: 0.625rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.2;
  }

  .ep-nav__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    overflow: hidden;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    transition: color var(--t-fast);
  }

  .ep-nav__title--muted {
    color: var(--text-disabled);
  }

  .ep-nav__meta {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.2;
  }

  .ep-nav__meta--muted {
    color: var(--text-disabled);
  }

  .ep-nav__tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .ep-nav__see-all {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all var(--t-fast);
    white-space: nowrap;
  }

  .ep-nav__see-all:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ep-nav__see-all :global(svg) {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }
</style>

<script>
  interface NavItem {
    number: number;
    title: string | null;
    duration: number | null;
  }

  interface MountData {
    slug: string;
    current: number;
    total: number;
    thumbnail: string;
    prev: NavItem | null;
    next: NavItem | null;
  }

  interface ActionBarAPI {
    mount(root: HTMLElement, data: MountData): void;
  }

  function resolveNav(root: HTMLElement): HTMLElement | null {
    if (root.hasAttribute('data-action-bar')) return root;
    return root.querySelector<HTMLElement>('[data-action-bar]');
  }

  function urlFor(watchBase: string, ep: number): string {
    if (!watchBase) return '#';
    return ep <= 1 ? watchBase : `${watchBase}?ep=${ep}`;
  }

  function titleText(item: NavItem): string {
    return item.title
      ? `E${item.number} – ${item.title}`
      : `Episode ${item.number}`;
  }

  function durText(item: NavItem): string | null {
    if (typeof item.duration !== 'number' || item.duration <= 0) return null;
    return `${item.duration}m`;
  }

  function renderCard(
    card: HTMLElement | null,
    item: NavItem | null,
    watchBase: string,
    kind: 'prev' | 'next',
    thumbnail: string
  ): void {
    if (!card) return;

    const img = card.querySelector<HTMLImageElement>('.ep-nav__thumb img');
    const fallbackEl = card.querySelector<HTMLElement>('.ep-nav__thumb-fallback');
    const durEl = card.querySelector<HTMLElement>('.ep-nav__dur');
    const titleEl = card.querySelector<HTMLElement>('[data-nav-prev-label], [data-nav-next-label]');
    const metaEl = card.querySelector<HTMLElement>('.ep-nav__meta');

    if (item) {
      card.classList.remove('ep-nav__card--disabled');
      card.removeAttribute('aria-hidden');
      if (card.tagName === 'A') {
        (card as HTMLAnchorElement).href = urlFor(watchBase, item.number);
      }
      card.setAttribute('data-episode-nav', String(item.number));
      card.setAttribute(
        'aria-label',
        kind === 'prev'
          ? `Episode sebelumnya, Ep ${item.number}`
          : `Episode berikutnya, Ep ${item.number}`
      );

      if (img && thumbnail) {
        img.src = thumbnail;
        img.hidden = false;
        if (fallbackEl) fallbackEl.hidden = true;
      } else if (img) {
        img.hidden = true;
        if (fallbackEl) {
          fallbackEl.hidden = false;
          fallbackEl.textContent = String(item.number).padStart(2, '0');
        }
      }

      const d = durText(item);
      if (durEl) {
        if (d) {
          durEl.textContent = d;
          durEl.hidden = false;
        } else {
          durEl.hidden = true;
        }
      }

      if (titleEl) titleEl.textContent = titleText(item);
      if (metaEl) metaEl.textContent = 'Sub Indo';
    } else {
      card.classList.add('ep-nav__card--disabled');
      card.setAttribute('aria-hidden', 'true');
      if (card.tagName === 'A') {
        (card as HTMLAnchorElement).removeAttribute('href');
      }
      card.removeAttribute('data-episode-nav');

      if (img) img.hidden = true;
      if (fallbackEl) {
        fallbackEl.hidden = false;
        fallbackEl.textContent = '—';
      }
      if (durEl) durEl.hidden = true;
      if (titleEl) {
        titleEl.textContent = 'Tidak ada';
        titleEl.classList.add('ep-nav__title--muted');
      }
      if (metaEl) {
        metaEl.textContent = '—';
        metaEl.classList.add('ep-nav__meta--muted');
      }
    }
  }

  function mount(root: HTMLElement, data: MountData): void {
    const nav = resolveNav(root);
    if (!nav) return;

    const watchBase = nav.dataset.watchBase ?? '';
    if (!watchBase) return;

    const prevCard = nav.querySelector<HTMLElement>('[data-nav-prev], .ep-nav__card--disabled');
    const nextCard = nav.querySelector<HTMLElement>('[data-nav-next]') ??
      Array.from(nav.querySelectorAll<HTMLElement>('.ep-nav__card')).find(
        (c) => !c.hasAttribute('data-nav-prev')
      ) ?? null;

    const allCards = Array.from(nav.querySelectorAll<HTMLElement>('.ep-nav__card'));
    const prevEl = allCards[0] ?? null;
    const nextEl = allCards[1] ?? null;

    renderCard(prevEl, data.prev, watchBase, 'prev', data.thumbnail);
    renderCard(nextEl, data.next, watchBase, 'next', data.thumbnail);
  }

  (window as any).__qimochiActionBar = { mount } satisfies ActionBarAPI;
</script>
