---
interface Props {
  animeId: string;
  malScore?: number | null;
}

const { animeId, malScore = null } = Astro.props;
const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.qimochi.web.id';
---

<div
  class="rating-wrap"
  data-rating-widget
  data-anime={animeId}
  data-api={apiBase}
  data-mal-score={malScore ?? ''}
>
  <div class="rating">
    <div class="rating__main">
      <span class="rating-stars" data-stars role="radiogroup" aria-label="Rating">
        {[1, 2, 3, 4, 5].map((n) => (
          <button
            type="button"
            class="rating-star"
            data-star={n}
            role="radio"
            aria-checked="false"
            aria-label={`${n} bintang`}
            disabled
          >★</button>
        ))}
      </span>

      <span class="rating-score">
        <span class="rating-average" data-average>—</span>
        <span class="rating-scale">/10</span>
      </span>

      <span class="rating-votes" data-votes></span>

      <span class="rating-user" data-user hidden></span>

      <button
        type="button"
        class="rating-clear"
        data-clear
        hidden
        aria-label="Hapus rating"
      >×</button>
    </div>

    <button
      type="button"
      class="rating-caret"
      data-score-btn
      aria-label="Detail distribusi rating"
      disabled
    >
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 6l4 4 4-4"/>
      </svg>
    </button>
  </div>

  <button
    type="button"
    class="rating-cta"
    data-rating-cta
    hidden
  ></button>

  <div class="rating-dist" data-dist hidden>
    {[5, 4, 3, 2, 1].map((n) => (
      <div class="rating-dist-row">
        <span class="rating-dist-label">{n}★</span>
        <span class="rating-dist-bar">
          <span class="rating-dist-fill" data-fill={n} style="width: 0%"></span>
        </span>
        <span class="rating-dist-count" data-count={n}>0</span>
      </div>
    ))}
  </div>
</div>

<style>
  .rating-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-3) 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .rating {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .rating__main {
    flex: 1;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: 1;
    min-width: 0;
  }

  .rating-stars {
    display: inline-flex;
    align-items: center;
    gap: 1px;
  }

  .rating-star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    width: 1.25rem;
    height: 1.25rem;
    background: transparent;
    border: none;
    color: var(--border-hover);
    font-size: 1.125rem;
    line-height: 1;
    cursor: pointer;
    transition: color var(--t-fast);
  }
  .rating-star:disabled { cursor: not-allowed; }
  .rating-star:not(:disabled):hover { color: var(--gold-hover); }
  .rating-star.is-active { color: var(--gold); }
  .rating-star.is-preview { color: var(--gold-hover); }

  .rating-score {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
    font-weight: var(--fw-bold);
  }
  .rating-score.is-fallback {
    color: var(--text-muted);
    font-weight: var(--fw-semibold);
  }
  .rating-average { font-size: var(--fs-lg); }
  .rating-scale {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-weight: var(--fw-normal);
  }

  .rating-votes {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .rating-votes:empty { display: none; }

  .rating-user {
    font-size: var(--fs-xs);
    color: var(--accent);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }
  .rating-user[hidden] { display: none; }

  .rating-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1;
    cursor: pointer;
    transition: color var(--t-fast);
  }
  .rating-clear:hover { color: var(--danger); }
  .rating-clear[hidden] { display: none; }

  .rating-caret {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: var(--r-full);
    color: var(--text-muted);
    cursor: pointer;
    transition: background var(--t-fast), color var(--t-fast);
  }
  .rating-caret:hover:not(:disabled) {
    background: var(--bg-hover);
    color: var(--text-primary);
  }
  .rating-caret:disabled { cursor: default; opacity: 0.4; }

  .rating-cta {
    align-self: center;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
    text-align: center;
    cursor: pointer;
    transition: color var(--t-fast);
  }
  .rating-cta:hover { color: var(--accent); }
  .rating-cta[hidden] { display: none; }

  .rating-dist {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--s-2) 0 0;
    max-width: 20rem;
    margin-inline: auto;
    width: 100%;
  }
  .rating-dist[hidden] { display: none; }

  .rating-dist-row {
    display: grid;
    grid-template-columns: 1.75rem 1fr 2rem;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .rating-dist-label {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .rating-dist-bar {
    display: block;
    height: 6px;
    background: var(--bg-surface);
    border-radius: var(--r-sm);
    overflow: hidden;
  }
  .rating-dist-fill {
    display: block;
    height: 100%;
    background: var(--gold);
    transition: width var(--t-base);
  }
  .rating-dist-count {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  @media (min-width: 50rem) {
    .rating__main { justify-content: flex-start; }
    .rating-cta { align-self: flex-start; text-align: start; }
    .rating-dist { margin-inline: 0; }
  }
</style>

<script>
  interface AuthUser {
    sub: string;
    name: string;
    email: string;
    picture: string | null;
  }

  (function () {
    const root = document.querySelector<HTMLElement>('[data-rating-widget]');
    if (!root) return;

    const ANIME_ID = root.dataset.anime || '';
    const API = (root.dataset.api || '').replace(/\/$/, '');
    const MAL_SCORE_RAW = root.dataset.malScore || '';
    const MAL_SCORE = MAL_SCORE_RAW ? parseFloat(MAL_SCORE_RAW) : null;
    if (!ANIME_ID || !API) return;

    const stars = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-star]')
    );
    const scoreBtn = root.querySelector<HTMLButtonElement>('[data-score-btn]')!;
    const scoreWrap = root.querySelector<HTMLElement>('.rating-score')!;
    const averageEl = root.querySelector<HTMLElement>('[data-average]')!;
    const votesEl = root.querySelector<HTMLElement>('[data-votes]')!;
    const userEl = root.querySelector<HTMLElement>('[data-user]')!;
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear]')!;
    const ctaBtn = root.querySelector<HTMLButtonElement>('[data-rating-cta]')!;
    const distEl = root.querySelector<HTMLElement>('[data-dist]')!;

    const fills: Record<number, HTMLElement> = {};
    const counts: Record<number, HTMLElement> = {};
    for (let n = 1; n <= 5; n++) {
      fills[n] = root.querySelector<HTMLElement>(`[data-fill="${n}"]`)!;
      counts[n] = root.querySelector<HTMLElement>(`[data-count="${n}"]`)!;
    }

    let userScore: number | null = null;
    let currentUser: AuthUser | null = null;
    let submitting = false;
    let distOpen = false;

    function paintStars(filled: number | null, preview = false): void {
      for (const s of stars) {
        const n = Number(s.dataset.star);
        s.classList.remove('is-active', 'is-preview');
        if (filled !== null && n <= filled) {
          s.classList.add(preview ? 'is-preview' : 'is-active');
        }
      }
    }
    function paintStarsFromScore(score: number | null): void {
      if (score === null || score <= 0) {
        paintStars(null);
        return;
      }
      const filled = Math.max(1, Math.min(5, Math.round(score / 2)));
      paintStars(filled);
    }

    function updateAria(): void {
      for (const s of stars) {
        const n = Number(s.dataset.star);
        s.setAttribute('aria-checked', String(n === userScore));
      }
    }

    function updateCta(): void {
      if (!currentUser) {
        ctaBtn.textContent = 'Login atau daftar untuk memberi rating';
        ctaBtn.hidden = false;
        return;
      }
      if (userScore === null) {
        ctaBtn.textContent = 'Beri rating';
        ctaBtn.hidden = false;
        return;
      }
      ctaBtn.hidden = true;
      ctaBtn.textContent = '';
    }

    function setInteractive(): void {
      const canRate = !!currentUser;
      for (const s of stars) s.disabled = !canRate || submitting;
      clearBtn.hidden = !(currentUser && userScore !== null);
    }

    function renderUserScore(): void {
      if (userScore !== null) {
        userEl.textContent = `kamu: ${userScore}`;
        userEl.hidden = false;
      } else {
        userEl.hidden = true;
      }
      updateAria();
      updateCta();
    }

    function renderDisplayScore(communityAvg: number, votes: number): void {
      if (communityAvg > 0 && votes > 0) {
        averageEl.textContent = communityAvg.toFixed(1);
        scoreWrap.classList.remove('is-fallback');
        if (userScore === null) paintStarsFromScore(communityAvg);
        return;
      }
      if (MAL_SCORE != null && MAL_SCORE > 0) {
        averageEl.textContent = MAL_SCORE.toFixed(1);
        scoreWrap.classList.add('is-fallback');
        if (userScore === null) paintStarsFromScore(MAL_SCORE);
        return;
      }
      averageEl.textContent = '—';
      scoreWrap.classList.remove('is-fallback');
      paintStars(null);
    }

    function renderDistribution(dist: Record<number, number>): void {
      let total = 0;
      for (let n = 1; n <= 5; n++) total += dist[n] || 0;

      if (total === 0) {
        distEl.hidden = true;
        return;
      }

      let maxCount = 0;
      for (let n = 1; n <= 5; n++) {
        if (dist[n] > maxCount) maxCount = dist[n];
      }

      for (let n = 1; n <= 5; n++) {
        const c = dist[n] || 0;
        counts[n].textContent = String(c);
        const pct = maxCount > 0 ? (c / maxCount) * 100 : 0;
        fills[n].style.width = `${pct}%`;
      }

      if (distOpen) distEl.hidden = false;
    }

    function toggleDist(): void {
      if (scoreBtn.disabled) return;
      distOpen = !distOpen;
      distEl.hidden = !distOpen;
    }

    async function fetchRating(): Promise<void> {
      try {
        const res = await fetch(
          `${API}/api/v1/ratings/${encodeURIComponent(ANIME_ID)}`,
          { credentials: 'include' }
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const json = (await res.json()) as {
          data: {
            average: number;
            votes: number;
            userScore: number | null;
            canRate: boolean;
            distribution: Record<number, number>;
          };
        };
        const d = json.data;
        userScore = d.userScore;
        const hasVotes = d.votes > 0;
        renderDisplayScore(d.average, d.votes);
        if (userScore !== null) paintStars(userScore);
        votesEl.textContent = hasVotes ? `(${d.votes})` : '';
        renderUserScore();
        setInteractive();
        scoreBtn.disabled = !hasVotes;
        renderDistribution(d.distribution || {});
      } catch (err) {
        console.error('[rating] fetch failed', err);
        renderDisplayScore(0, 0);
        votesEl.textContent = '';
        setInteractive();
        updateCta();
        scoreBtn.disabled = true;
      }
    }

    async function submitRating(score: number): Promise<void> {
      if (!currentUser || submitting) return;
      submitting = true;
      setInteractive();

      try {
        const res = await fetch(
          `${API}/api/v1/ratings/${encodeURIComponent(ANIME_ID)}`,
          {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ score }),
          }
        );

        if (res.status === 401) {
          currentUser = null;
          setInteractive();
          updateCta();
          return;
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const json = (await res.json()) as {
          data: {
            average: number;
            votes: number;
            userScore: number | null;
            distribution: Record<number, number>;
          };
        };
        const d = json.data;
        userScore = d.userScore;
        renderDisplayScore(d.average, d.votes);
        if (userScore !== null) paintStars(userScore);
        votesEl.textContent = d.votes > 0 ? `(${d.votes})` : '';
        renderUserScore();
        scoreBtn.disabled = d.votes === 0;
        renderDistribution(d.distribution || {});
      } catch (err) {
        console.error('[rating] submit failed', err);
      } finally {
        submitting = false;
        setInteractive();
      }
    }

    async function clearRating(): Promise<void> {
      if (!currentUser || submitting) return;
      submitting = true;
      setInteractive();

      try {
        const res = await fetch(
          `${API}/api/v1/ratings/${encodeURIComponent(ANIME_ID)}`,
          { method: 'DELETE', credentials: 'include' }
        );

        if (res.status === 401) {
          currentUser = null;
          setInteractive();
          updateCta();
          return;
        }
        if (!res.ok && res.status !== 404) throw new Error(`HTTP ${res.status}`);

        const json = (await res.json()) as {
          data: {
            average: number;
            votes: number;
            userScore: number | null;
            distribution: Record<number, number>;
          };
        };
        const d = json.data;
        userScore = null;
        renderDisplayScore(d.average, d.votes);
        votesEl.textContent = d.votes > 0 ? `(${d.votes})` : '';
        renderUserScore();
        scoreBtn.disabled = d.votes === 0;
        renderDistribution(d.distribution || {});
      } catch (err) {
        console.error('[rating] clear failed', err);
      } finally {
        submitting = false;
        setInteractive();
      }
    }

    for (const s of stars) {
      const n = Number(s.dataset.star);
      s.addEventListener('mouseenter', () => {
        if (!currentUser || submitting) return;
        paintStars(n, true);
      });
      s.addEventListener('mouseleave', () => {
        if (!currentUser || submitting) return;
        if (userScore !== null) paintStars(userScore);
        else fetchRating();
      });
      s.addEventListener('click', () => {
        if (!currentUser || submitting) return;
        submitRating(n);
      });
    }

    clearBtn.addEventListener('click', () => clearRating());
    scoreBtn.addEventListener('click', () => toggleDist());

    ctaBtn.addEventListener('click', () => {
      if (!currentUser) {
        const menu = (window as any).__qimochiUserMenu;
        if (menu?.open) menu.open();
        return;
      }
      const first = stars[0];
      if (first) first.focus();
    });

    function readCache(): AuthUser | null {
      try {
        const raw = localStorage.getItem('qimochi:user-cache');
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<AuthUser> | null;
        if (
          parsed &&
          typeof parsed.sub === 'string' &&
          typeof parsed.name === 'string'
        ) {
          return {
            sub: parsed.sub,
            name: parsed.name,
            email: typeof parsed.email === 'string' ? parsed.email : '',
            picture: typeof parsed.picture === 'string' ? parsed.picture : null,
          };
        }
      } catch {}
      return null;
    }

    function onAuthChanged(e: Event): void {
      const detail = (e as CustomEvent<{ user: AuthUser | null }>).detail;
      if (!detail) return;
      const same = (detail.user?.sub ?? null) === (currentUser?.sub ?? null);
      if (same) return;
      currentUser = detail.user;
      if (!currentUser) {
        userScore = null;
        renderUserScore();
      }
      setInteractive();
      fetchRating();
    }

    document.addEventListener('qimochi:auth-changed', onAuthChanged);

    (function bootstrap(): void {
      currentUser = readCache();
      setInteractive();
      updateCta();
      renderDisplayScore(0, 0);
    })();

    fetchRating();

    (async () => {
      const menu = (window as any).__qimochiUserMenu;
      if (menu?.getUser) {
        const u = menu.getUser();
        if ((u?.sub ?? null) !== (currentUser?.sub ?? null)) {
          currentUser = u ?? null;
          setInteractive();
          fetchRating();
        }
      }
    })();
  })();
</script>
