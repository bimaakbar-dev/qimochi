---
import Icons from '~/user-components/Icons.astro';

interface Props {
  animeId: string;
}

const { animeId } = Astro.props;
const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.qimochi.web.id';
const popoverId = `rating-pop-${animeId}`;
---

<div
  class="rating"
  data-rating-widget
  data-anime={animeId}
  data-api={apiBase}
  data-popover-id={popoverId}
>
  <button
    type="button"
    class="rating__display"
    popovertarget={popoverId}
    aria-haspopup="true"
    data-rating-trigger
  >
    <span class="rating__stars" aria-hidden="true">
      <span class="rating__stars-bg">★★★★★</span>
      <span class="rating__stars-fill" data-stars-fill>★★★★★</span>
    </span>

    <span class="rating__summary">
      <span class="rating__label" data-label>Belum ada rating</span>
      <span class="rating__average" data-average></span>
      <span class="rating__votes" data-votes></span>
    </span>

    <span class="rating__chevron" aria-hidden="true">
      <Icons name="chevron-down" size={16} />
    </span>
  </button>

  <div
    class="rating__popover"
    id={popoverId}
    popover="auto"
    aria-label="Rating komunitas"
    data-rating-popover
  >
    <div class="rating__popover-inner">
      <header class="rating__popover-header">
        <h3 class="rating__popover-title">Rating Komunitas</h3>
        <button
          type="button"
          class="rating__popover-close"
          data-rating-close
          aria-label="Tutup"
        >
          <Icons name="close" size={16} />
        </button>
      </header>

      <div class="rating__popover-body">
        <div class="rating__popover-summary">
          <span class="rating__popover-stars" data-popover-stars aria-hidden="true">
            <span class="rating__popover-stars-bg">★★★★★</span>
            <span class="rating__popover-stars-fill" data-popover-stars-fill>★★★★★</span>
          </span>
          <div class="rating__popover-summary-text">
            <span class="rating__popover-average" data-popover-average>—</span>
            <span class="rating__popover-votes" data-popover-votes></span>
          </div>
        </div>

        <section class="rating__popover-section">
          <h4 class="rating__popover-section-title">Distribusi rating</h4>
          <div class="rating__popover-histogram" data-histogram></div>
        </section>

        <section class="rating__popover-section">
          <h4 class="rating__popover-section-title" data-user-label>Beri rating:</h4>

          <div
            class="rating__popover-input"
            data-rating-input
            role="radiogroup"
            aria-label="Rating kamu"
          >
            {[1, 2, 3, 4, 5].map((n) => (
              <button
                type="button"
                class="rating__popover-star"
                data-input-star={n}
                role="radio"
                aria-checked="false"
                aria-label={`${n} bintang`}
                disabled
              >★</button>
            ))}
          </div>

          <div class="rating__popover-actions">
            <button
              type="button"
              class="rating__popover-clear"
              data-clear
              hidden
            >Hapus rating saya</button>
          </div>

          <p class="rating__popover-hint" data-hint hidden></p>
        </section>
      </div>
    </div>
  </div>
</div>

<style>
  .rating {
    display: inline-flex;
    align-items: center;
    font-family: inherit;
  }

  .rating__display {
    display: inline-flex;
    align-items: center;
    gap: 0;
    padding: var(--s-1) 0;
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
    text-align: start;
    transition: opacity var(--t-fast);
  }

  .rating__display:hover {
    opacity: 0.88;
  }

  .rating__stars {
    position: relative;
    display: inline-block;
    font-size: 1rem;
    letter-spacing: 2px;
    line-height: 1;
    white-space: nowrap;
  }

  .rating__stars-bg {
    color: hsla(0, 0%, 100%, 0.28);
  }

  .rating__stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--gold);
    overflow: hidden;
    width: 0;
    transition: width var(--t-base);
    white-space: nowrap;
  }

  .rating__stars[data-empty='true'] .rating__stars-fill {
    width: 0;
  }

  .rating__summary {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    margin-left: var(--s-3);
    padding-left: var(--s-3);
    border-left: 1px solid hsla(0, 0%, 100%, 0.22);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .rating__label {
    color: hsla(0, 0%, 100%, 0.72);
    font-weight: var(--fw-medium);
  }

  .rating__average {
    color: #fff;
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
  }

  .rating__average:empty {
    display: none;
  }

  .rating__votes {
    color: hsla(0, 0%, 100%, 0.65);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }

  .rating__votes:empty {
    display: none;
  }

  .rating__chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: var(--s-2);
    color: hsla(0, 0%, 100%, 0.55);
    transition: transform var(--t-fast), color var(--t-fast);
  }

  .rating__display:hover .rating__chevron {
    color: hsla(0, 0%, 100%, 0.9);
    transform: translateY(1px);
  }

  .rating__popover {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-elevated);
    color: var(--text-primary);
    box-shadow: var(--shadow-lg);
    width: 22rem;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.15s ease-out;
  }

  .rating__popover:popover-open {
    opacity: 1;
    animation: rating-pop-in 0.18s ease-out;
  }

  @keyframes rating-pop-in {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rating__popover,
    .rating__popover:popover-open {
      transition: none;
      animation: none;
    }
  }

  .rating__popover-inner {
    display: flex;
    flex-direction: column;
  }

  .rating__popover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
  }

  .rating__popover-title {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .rating__popover-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--t-fast), background var(--t-fast);
  }

  .rating__popover-close:hover {
    color: var(--text-primary);
    background: var(--bg-surface);
  }

  .rating__popover-body {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-4);
  }

  .rating__popover-summary {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .rating__popover-stars {
    position: relative;
    display: inline-block;
    font-size: 1.125rem;
    letter-spacing: 2px;
    line-height: 1;
    white-space: nowrap;
  }

  .rating__popover-stars-bg {
    color: var(--border);
  }

  .rating__popover-stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--gold);
    overflow: hidden;
    width: 0;
    transition: width var(--t-base);
    white-space: nowrap;
  }

  .rating__popover-summary-text {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }

  .rating__popover-average {
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .rating__popover-votes {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .rating__popover-section {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .rating__popover-section-title {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .rating__popover-histogram {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .rating__popover-hist-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-xs);
  }

  .rating__popover-hist-label {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--text-secondary);
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .rating__popover-hist-label-star {
    color: var(--gold);
    font-size: 0.6875rem;
    line-height: 1;
  }

  .rating__popover-hist-track {
    position: relative;
    height: 6px;
    background: var(--bg-surface);
    overflow: hidden;
  }

  .rating__popover-hist-fill {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--gold);
    transition: width var(--t-base);
  }

  .rating__popover-hist-pct {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.625rem;
    min-width: 2.25rem;
    text-align: end;
  }

  .rating__popover-hist-empty {
    padding: var(--s-3) 0;
    text-align: center;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .rating__popover-input {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .rating__popover-star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--border-hover);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: color var(--t-fast), transform var(--t-fast);
  }

  .rating__popover-star:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .rating__popover-star:not(:disabled):hover {
    color: var(--gold-hover);
    transform: scale(1.12);
  }

  .rating__popover-star.is-active {
    color: var(--gold);
  }

  .rating__popover-star.is-preview {
    color: var(--gold-hover);
  }

  .rating__popover-actions {
    display: flex;
    justify-content: flex-end;
    min-height: 1rem;
  }

  .rating__popover-clear {
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition: color var(--t-fast);
  }

  .rating__popover-clear:hover {
    color: var(--danger);
  }

  .rating__popover-clear[hidden] {
    display: none;
  }

  .rating__popover-hint {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: var(--lh-relaxed);
  }

  .rating__popover-hint[hidden] {
    display: none;
  }

  .rating__popover-hint a {
    color: var(--accent);
    cursor: pointer;
  }
</style>

<script>
  interface RatingData {
    animeId: string;
    average: number;
    votes: number;
    userScore: number | null;
    canRate: boolean;
    distribution: Record<string, number>;
  }

  function formatCount(n: number): string {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
    if (n >= 1_000) return (n / 1_000).toFixed(1).replace(/\.0$/, '') + 'K';
    return String(n);
  }

  function openUserMenu(): void {
    const menu = (window as any).__qimochiUserMenu;
    if (menu?.open) {
      menu.open();
    } else {
      document.dispatchEvent(
        new CustomEvent('qimochi:auth-required', { detail: { feature: 'rating' } })
      );
    }
  }

  function supportsPopover(): boolean {
    return (
      typeof HTMLElement !== 'undefined' &&
      'popover' in HTMLElement.prototype
    );
  }

  function positionPopover(popover: HTMLElement, trigger: HTMLElement): void {
    popover.style.top = '0px';
    popover.style.left = '0px';

    const trigRect = trigger.getBoundingClientRect();
    const popRect = popover.getBoundingClientRect();
    const vh = window.innerHeight;
    const vw = window.innerWidth;
    const MARGIN = 8;

    let top = trigRect.bottom + MARGIN;
    let left = trigRect.left;

    if (top + popRect.height > vh - MARGIN) {
      const above = trigRect.top - popRect.height - MARGIN;
      if (above >= MARGIN) {
        top = above;
      } else {
        top = Math.max(MARGIN, vh - popRect.height - MARGIN);
      }
    }

    if (left + popRect.width > vw - MARGIN) {
      left = vw - popRect.width - MARGIN;
    }
    if (left < MARGIN) left = MARGIN;

    popover.style.top = `${Math.round(top)}px`;
    popover.style.left = `${Math.round(left)}px`;
  }

  function initWidget(root: HTMLElement): void {
    if (root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const ANIME_ID = root.dataset.anime ?? '';
    const API = (root.dataset.api ?? '').replace(/\/$/, '');
    const POPOVER_ID = root.dataset.popoverId ?? '';
    if (!ANIME_ID || !API || !POPOVER_ID) return;

    const triggerEl = root.querySelector<HTMLButtonElement>('[data-rating-trigger]');
    const popoverEl = document.getElementById(POPOVER_ID) as HTMLElement | null;

    if (!triggerEl || !popoverEl) return;

    const triggerBtn = triggerEl;
    const popover = popoverEl;

    const closeBtnEl = popover.querySelector<HTMLButtonElement>('[data-rating-close]');
    if (!closeBtnEl) return;
    const closeBtn = closeBtnEl;

    const starsWrapEl = root.querySelector<HTMLElement>('.rating__stars');
    const starsFillEl = root.querySelector<HTMLElement>('[data-stars-fill]');
    const labelElRaw = root.querySelector<HTMLElement>('[data-label]');
    const averageElRaw = root.querySelector<HTMLElement>('[data-average]');
    const votesElRaw = root.querySelector<HTMLElement>('[data-votes]');

    const popStarsEl = popover.querySelector<HTMLElement>('[data-popover-stars]');
    const popStarsFillEl = popover.querySelector<HTMLElement>('[data-popover-stars-fill]');
    const popAvgEl = popover.querySelector<HTMLElement>('[data-popover-average]');
    const popVotesEl = popover.querySelector<HTMLElement>('[data-popover-votes]');
    const histogramEl = popover.querySelector<HTMLElement>('[data-histogram]');
    const userLabelEl = popover.querySelector<HTMLElement>('[data-user-label]');
    const clearBtnEl = popover.querySelector<HTMLButtonElement>('[data-clear]');
    const hintElRaw = popover.querySelector<HTMLElement>('[data-hint]');

    if (
      !starsWrapEl || !starsFillEl || !labelElRaw || !averageElRaw || !votesElRaw ||
      !popStarsEl || !popStarsFillEl || !popAvgEl || !popVotesEl ||
      !histogramEl || !userLabelEl || !clearBtnEl || !hintElRaw
    ) {
      return;
    }

    const starsWrap = starsWrapEl;
    const starsFill = starsFillEl;
    const labelEl = labelElRaw;
    const averageEl = averageElRaw;
    const votesEl = votesElRaw;
    const popStars = popStarsEl;
    const popStarsFill = popStarsFillEl;
    const popAvg = popAvgEl;
    const popVotes = popVotesEl;
    const histogram = histogramEl;
    const userLabel = userLabelEl;
    const clearBtn = clearBtnEl;
    const hintEl = hintElRaw;

    const inputStars = Array.from(
      popover.querySelectorAll<HTMLButtonElement>('[data-input-star]')
    );

    let state: RatingData | null = null;
    let submitting = false;

    function fillWidth(avg5: number, hasVotes: boolean): string {
      if (!hasVotes) return '0%';
      return `${Math.max(0, Math.min(100, (avg5 / 5) * 100))}%`;
    }

    function renderTriggerStars(avg5: number, hasVotes: boolean): void {
      starsWrap.dataset.empty = hasVotes ? 'false' : 'true';
      starsFill.style.width = fillWidth(avg5, hasVotes);
    }

    function renderPopStars(avg5: number, hasVotes: boolean): void {
      popStars.dataset.empty = hasVotes ? 'false' : 'true';
      popStarsFill.style.width = fillWidth(avg5, hasVotes);
    }

    function renderHistogram(dist: Record<string, number>, total: number): void {
      histogram.innerHTML = '';

      if (total === 0) {
        const empty = document.createElement('div');
        empty.className = 'rating__popover-hist-empty';
        empty.textContent = 'Belum ada rating. Jadilah yang pertama!';
        histogram.appendChild(empty);
        return;
      }

      for (let star = 5; star >= 1; star--) {
        const count = dist[String(star)] ?? 0;
        const pct = total > 0 ? (count / total) * 100 : 0;

        const row = document.createElement('div');
        row.className = 'rating__popover-hist-row';
        row.innerHTML = `
          <span class="rating__popover-hist-label">
            ${star}<span class="rating__popover-hist-label-star" aria-hidden="true">★</span>
          </span>
          <span class="rating__popover-hist-track">
            <span class="rating__popover-hist-fill" style="width: ${pct.toFixed(1)}%"></span>
          </span>
          <span class="rating__popover-hist-pct">${Math.round(pct)}%</span>
        `;
        histogram.appendChild(row);
      }
    }

    function renderInput(): void {
      if (!state) return;

      const canRate = state.canRate;
      const userScore = state.userScore;

      for (const btn of inputStars) {
        const n = Number(btn.dataset.inputStar);
        btn.disabled = !canRate || submitting;
        btn.classList.remove('is-active', 'is-preview');
        if (userScore != null && n <= userScore) {
          btn.classList.add('is-active');
        }
        btn.setAttribute('aria-checked', String(userScore === n));
      }

      if (!canRate) {
        userLabel.textContent = 'Rating:';
        hintEl.innerHTML = `<a href="#" data-login-link>Login</a> untuk memberi rating.`;
        hintEl.hidden = false;
      } else if (userScore != null) {
        userLabel.textContent = `Rating kamu: ${userScore}★`;
        hintEl.hidden = true;
      } else {
        userLabel.textContent = 'Beri rating:';
        hintEl.hidden = true;
      }

      clearBtn.hidden = !(canRate && userScore != null);
      clearBtn.disabled = submitting;
    }

    function renderTrigger(): void {
      if (!state) return;

      const hasVotes = state.votes > 0;

      if (hasVotes) {
        const avg5 = state.average / 2;
        labelEl.textContent = 'Rating:';
        averageEl.textContent = avg5.toFixed(1);
        votesEl.textContent = `(${formatCount(state.votes)})`;
        renderTriggerStars(avg5, true);
      } else {
        labelEl.textContent = 'Belum ada rating';
        averageEl.textContent = '';
        votesEl.textContent = '';
        renderTriggerStars(0, false);
      }
    }

    function renderPopover(): void {
      if (!state) return;

      const hasVotes = state.votes > 0;
      const avg5 = state.average / 2;

      if (hasVotes) {
        popAvg.textContent = avg5.toFixed(1);
        popVotes.textContent = `${formatCount(state.votes)} votes`;
        renderPopStars(avg5, true);
      } else {
        popAvg.textContent = '—';
        popVotes.textContent = 'Belum ada rating';
        renderPopStars(0, false);
      }

      renderHistogram(state.distribution, state.votes);
      renderInput();
    }

    function render(): void {
      renderTrigger();
      renderPopover();
    }

    async function fetchRating(): Promise<void> {
      try {
        const res = await fetch(
          `${API}/api/v1/ratings/${encodeURIComponent(ANIME_ID)}`,
          { credentials: 'include' }
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const json = (await res.json()) as { data: RatingData };
        state = json.data;
        render();
      } catch (err) {
        console.error('[rating] fetch failed', err);
        state = {
          animeId: ANIME_ID,
          average: 0,
          votes: 0,
          userScore: null,
          canRate: false,
          distribution: {},
        };
        render();
      }
    }

    async function submitRating(score: number): Promise<void> {
      if (!state?.canRate || submitting) return;
      submitting = true;
      renderInput();

      try {
        const res = await fetch(
          `${API}/api/v1/ratings/${encodeURIComponent(ANIME_ID)}`,
          {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ score }),
          }
        );

        if (res.status === 401) {
          state.canRate = false;
          render();
          submitting = false;
          openUserMenu();
          return;
        }

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const json = (await res.json()) as { data: RatingData };
        state = { ...state, ...json.data };
        render();
      } catch (err) {
        console.error('[rating] submit failed', err);
      } finally {
        submitting = false;
        renderInput();
      }
    }

    async function clearRating(): Promise<void> {
      if (!state?.userScore || submitting) return;
      submitting = true;
      renderInput();

      try {
        const res = await fetch(
          `${API}/api/v1/ratings/${encodeURIComponent(ANIME_ID)}`,
          { method: 'DELETE', credentials: 'include' }
        );

        if (res.status === 401) {
          state.canRate = false;
          render();
          submitting = false;
          openUserMenu();
          return;
        }

        if (!res.ok && res.status !== 404) throw new Error(`HTTP ${res.status}`);

        const json = (await res.json()) as { data: RatingData };
        state = { ...state, ...json.data };
        render();
      } catch (err) {
        console.error('[rating] clear failed', err);
      } finally {
        submitting = false;
        renderInput();
      }
    }

    let fallbackOpen = false;
    let fallbackHandlersAttached = false;

    function openFallback(): void {
      popover.style.display = 'block';
      popover.style.position = 'fixed';
      fallbackOpen = true;
      triggerBtn.setAttribute('aria-expanded', 'true');
      positionPopover(popover, triggerBtn);

      if (!fallbackHandlersAttached) {
        fallbackHandlersAttached = true;

        const onDocClick = (e: MouseEvent) => {
          const target = e.target as Node;
          if (popover.contains(target) || triggerBtn.contains(target)) return;
          closeFallback();
        };
        const onKey = (e: KeyboardEvent) => {
          if (e.key === 'Escape') closeFallback();
        };
        const onScrollOrResize = () => {
          if (fallbackOpen) positionPopover(popover, triggerBtn);
        };

        document.addEventListener('click', onDocClick, true);
        document.addEventListener('keydown', onKey);
        window.addEventListener('scroll', onScrollOrResize, true);
        window.addEventListener('resize', onScrollOrResize);
      }
    }

    function closeFallback(): void {
      if (!fallbackOpen) return;
      popover.style.display = 'none';
      fallbackOpen = false;
      triggerBtn.setAttribute('aria-expanded', 'false');
    }

    if (supportsPopover()) {
      popover.addEventListener('toggle', (e) => {
        const ev = e as ToggleEvent;
        if (ev.newState === 'open') {
          positionPopover(popover, triggerBtn);
        }
      });

      const onScrollOrResize = () => {
        if (popover.matches(':popover-open')) {
          positionPopover(popover, triggerBtn);
        }
      };
      window.addEventListener('scroll', onScrollOrResize, true);
      window.addEventListener('resize', onScrollOrResize);

      closeBtn.addEventListener('click', () => {
        if (typeof (popover as any).hidePopover === 'function') {
          (popover as any).hidePopover();
        }
      });
    } else {
      popover.style.display = 'none';

      triggerBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (fallbackOpen) closeFallback();
        else openFallback();
      });

      closeBtn.addEventListener('click', closeFallback);
    }

    for (const btn of inputStars) {
      const n = Number(btn.dataset.inputStar);

      btn.addEventListener('mouseenter', () => {
        if (!state?.canRate || submitting) return;
        for (const b of inputStars) {
          const bn = Number(b.dataset.inputStar);
          b.classList.remove('is-active', 'is-preview');
          if (bn <= n) b.classList.add('is-preview');
        }
      });

      btn.addEventListener('mouseleave', () => {
        if (!state?.canRate || submitting) return;
        renderInput();
      });

      btn.addEventListener('click', () => {
        if (!state?.canRate || submitting) return;
        submitRating(n);
      });
    }

    clearBtn.addEventListener('click', clearRating);

    hintEl.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.dataset.loginLink !== undefined) {
        e.preventDefault();
        openUserMenu();
      }
    });

    document.addEventListener('qimochi:auth-changed', () => {
      fetchRating();
    });

    renderTriggerStars(0, false);
    fetchRating();
  }

  function initAll(scope: ParentNode = document): void {
    scope.querySelectorAll<HTMLElement>('[data-rating-widget]').forEach(initWidget);
  }

  initAll();
</script>