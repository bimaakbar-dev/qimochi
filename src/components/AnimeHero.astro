---
import Icon from '~/user-components/Icons.astro';
import BookmarkButton from './BookmarkButton.astro';

export interface HeroGenreLink {
  name: string;
  href: string;
}

export interface HeroItem {
  id: string;
  title: string;
  background: string;
  age?: string | null;
  subIndo?: boolean;
  genres?: string[];
  genreLinks?: HeroGenreLink[];
  excerpt?: string | null;
  watchUrl?: string;
  watchLabel?: string;
  watchDisabled?: boolean;
}

interface Props {
  item: HeroItem;
  titleTag?: 'h1' | 'h2';
  size?: 'carousel' | 'detail';
  showBookmark?: boolean;
  class?: string;
}

const {
  item,
  titleTag: TitleTag = 'h1',
  size = 'carousel',
  showBookmark = true,
  class: className,
} = Astro.props;

const {
  id, title, background, age,
  subIndo = true, genres, genreLinks,
  excerpt, watchUrl, watchLabel = 'Mulai Nonton',
  watchDisabled = false,
} = item;

const hasGenres = (genreLinks?.length ?? 0) > 0 || (genres?.length ?? 0) > 0;
const hasMeta = Boolean(age) || subIndo || hasGenres;

const belowMetaSlot = Astro.slots.has('below-meta');
const actionsSlot = Astro.slots.has('actions');
const showWatch = Boolean(watchUrl) || watchDisabled;
---

<div class:list={['hero', `hero--${size}`, className]}>
  {background && (
    <div class="hero__bg" aria-hidden="true">
      <img
        class="hero__bg-img"
        src={background}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  )}

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner">
    <TitleTag class="hero__title" title={title}>{title}</TitleTag>
    {hasMeta && (
      <ul class="hero__meta">
        {age && <li class="hero__age">{age}</li>}
        {subIndo && <li class="hero__subindo">Sub Indo</li>}

        {genreLinks && genreLinks.length > 0 ? (
          <li class="hero__genres">
            {genreLinks.map((g) => (
              <a href={g.href} class="hero__genre-link">{g.name}</a>
            ))}
          </li>
        ) : (
          genres && genres.length > 0 && (
            <li class="hero__genres">{genres.join(', ')}</li>
          )
        )}
      </ul>
    )}

    {excerpt && <p class="hero__excerpt">{excerpt}</p>}

    {belowMetaSlot && (
      <div class="hero__below">
        <slot name="below-meta" />
      </div>
    )}

    {(showWatch || showBookmark || actionsSlot) && (
      <div class="hero__actions">
        {showWatch && (
          watchDisabled ? (
            <span
              class="hero__play hero__play--disabled"
              aria-disabled="true"
            >
              <span class="hero__play-icon" aria-hidden="true">
                <Icon name="play" size={16} />
              </span>
              <span>{watchLabel}</span>
            </span>
          ) : (
            <a
              href={watchUrl}
              class="hero__play"
              aria-label={`${watchLabel}: ${title}`}
            >
              <span class="hero__play-icon" aria-hidden="true">
                <Icon name="play" size={16} />
              </span>
              <span>{watchLabel}</span>
            </a>
          )
        )}

        {showBookmark && <BookmarkButton animeId={id} class="hero__bookmark" />}

        {actionsSlot && <slot name="actions" />}
      </div>
    )}
  </div>
</div>

<style>
  .hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--bg-nav);
    color: var(--text-inverted);
    isolation: isolate;
    display: flex;
    align-items: flex-end;
  }

  .hero--carousel {
    min-height: 30rem;
  }

  .hero--detail {
    aspect-ratio: 2 / 3;
    min-height: 32rem;
    max-height: 92vh;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transform: scale(1.02);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      hsla(30, 3%, 5%, 1) 0%,
      hsla(30, 3%, 5%, 0.85) 25%,
      hsla(30, 3%, 5%, 0.4) 55%,
      hsla(30, 3%, 5%, 0) 100%
    );
  }

  .hero--carousel .hero__scrim {
    background:
      linear-gradient(
        to right,
        hsla(30, 3%, 5%, 0.98) 0%,
        hsla(30, 3%, 5%, 0.92) 22%,
        hsla(30, 3%, 5%, 0.6) 48%,
        hsla(30, 3%, 5%, 0.18) 72%,
        hsla(30, 3%, 5%, 0) 100%
      ),
      linear-gradient(
        to top,
        hsla(30, 3%, 5%, 1) 0%,
        hsla(30, 3%, 5%, 0.6) 18%,
        hsla(30, 3%, 5%, 0) 55%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-max-desktop);
    margin-inline: auto;
    padding: var(--s-8) var(--pad-x) var(--s-12);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    align-items: flex-start;
  }

  .hero__title {
    font-family: var(--font-montserrat);
    font-size: clamp(1.5rem, 4vw + 0.5rem, var(--fs-4xl));
    font-weight: 800;
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0;
    max-width: 20ch;
    text-shadow: 0 2px 20px hsla(0, 0%, 0%, 0.6);
    text-wrap: balance;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: hsla(0, 0%, 100%, 0.82);
    letter-spacing: 0.02em;
    row-gap: var(--s-1);
  }

  .hero__meta > :global(li) {
    display: inline-flex;
    align-items: center;
  }

  .hero__meta > :global(li + li)::before {
    content: '';
    display: inline-block;
    flex-shrink: 0;
    width: 3px;
    height: 3px;
    border-radius: var(--r-full);
    background: currentColor;
    opacity: 0.45;
    margin-inline: var(--s-2);
    align-self: center;
  }

  .hero__age {
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    background: hsla(0, 0%, 100%, 0.18);
    border: none;
    border-radius: 6px 0 6px 0;
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: hsla(0, 0%, 100%, 0.95);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hero__subindo {
    color: hsla(0, 0%, 100%, 0.82);
    font-weight: var(--fw-medium);
  }

  .hero__genres {
    color: hsla(0, 0%, 100%, 0.68);
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero__genre-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .hero__genre-link:not(:last-child)::after {
    content: ',';
    margin-right: 0.35em;
    pointer-events: none;
  }

  .hero__genre-link:hover {
    color: var(--accent);
  }

  .hero__excerpt {
    margin: 0;
    max-width: 46ch;
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: hsla(0, 0%, 100%, 0.78);
    text-shadow: 0 1px 8px hsla(0, 0%, 0%, 0.4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero__below {
    width: 100%;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-1);
    flex-wrap: wrap;
  }

  .hero__play {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-5);
    background: var(--accent);
    color: var(--accent-text);
    border: none;
    border-radius: var(--r-full);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background var(--t-fast), transform var(--t-fast);
    box-shadow: 0 4px 20px hsla(3, 81%, 48%, 0.35);
  }

  .hero__play:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .hero__play:active {
    transform: translateY(0);
  }

  .hero__play--disabled {
    background: hsla(0, 0%, 100%, 0.12);
    color: hsla(0, 0%, 100%, 0.5);
    cursor: not-allowed;
    box-shadow: none;
    pointer-events: none;
  }

  .hero__play--disabled .hero__play-icon :global(svg) {
    opacity: 0.5;
  }

  .hero__play-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .hero__play-icon :global(svg) {
    width: 0.875em;
    height: 0.875em;
  }

  .hero__below :global(.rating-wrap) {
    justify-content: center;
  }

  .hero__below :global(.rating-cta) {
    text-align: center;
  }

  .hero__below :global(.rating-star) {
    color: hsla(0, 0%, 100%, 0.28);
  }

  .hero__below :global(.rating-star.is-active),
  .hero__below :global(.rating-star.is-preview) {
    color: var(--gold);
  }

  .hero__below :global(.rating-star:not(:disabled):hover) {
    color: var(--gold-hover);
  }

  .hero__below :global(.rating-score) {
    color: var(--text-inverted);
  }

  .hero__below :global(.rating-scale),
  .hero__below :global(.rating-votes),
  .hero__below :global(.rating-cta) {
    color: hsla(0, 0%, 100%, 0.65);
  }

  .hero__below :global(.rating-cta:hover) {
    color: var(--accent);
  }

  .hero--detail .hero__inner {
    align-items: center;
    text-align: center;
    padding: var(--s-16) var(--pad-x) var(--s-6);
    gap: var(--s-3);
  }

  .hero--detail .hero__title {
    max-width: 22ch;
    -webkit-line-clamp: 4;
  }

  .hero--detail .hero__meta {
    justify-content: center;
  }

  .hero--detail .hero__actions {
    justify-content: center;
  }

  @media (min-width: 50rem) {
    .hero--carousel {
      min-height: 40rem;
    }

    .hero--detail {
      aspect-ratio: 16 / 6;
      min-height: 20rem;
      max-height: 30rem;
    }

    .hero__inner {
      padding: var(--s-16) var(--pad-x) var(--s-16);
      gap: var(--s-5);
    }

    .hero__title {
      font-size: clamp(2.5rem, 3vw + 1.25rem, var(--fs-5xl));
      max-width: 16ch;
      -webkit-line-clamp: 3;
    }

    .hero--carousel .hero__title {
      font-size: clamp(2.75rem, 4vw + 1rem, var(--fs-6xl));
      max-width: 18ch;
      -webkit-line-clamp: 3;
    }

    .hero__meta {
      font-size: var(--fs-sm);
    }

    .hero__excerpt {
      font-size: var(--fs-base);
      max-width: 52ch;
    }

    .hero--detail .hero__inner {
      align-items: flex-start;
      text-align: start;
      padding: var(--s-16) var(--pad-x) var(--s-8);
      gap: var(--s-4);
    }

    .hero--detail .hero__title {
      max-width: 22ch;
      -webkit-line-clamp: 3;
    }

    .hero--detail .hero__meta {
      justify-content: flex-start;
    }

    .hero--detail .hero__actions {
      justify-content: flex-start;
    }

    .hero__below :global(.rating-wrap) {
      justify-content: flex-start;
    }

    .hero__below :global(.rating-cta) {
      text-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__play {
      transition: none;
    }
  }
</style>