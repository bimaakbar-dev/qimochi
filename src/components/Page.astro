---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['page', className]}>
  <slot />
</div>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
    padding-block: var(--s-6) var(--s-12);
  }
</style>