---
interface InfoItem {
  label: string;
  value: string | number;
}

interface GenreLink {
  name: string;
  href: string;
}

interface Props {
  items: InfoItem[];
  genres?: GenreLink[];
  class?: string;
}

const { items, genres = [], class: className } = Astro.props;

const visible = items.filter(
  (it) => it.value !== null && it.value !== undefined && String(it.value).length > 0
);
---

{(visible.length > 0 || genres.length > 0) && (
  <dl class:list={['anime-info', className]}>
    {visible.map((it) => (
      <div class="anime-info__row">
        <dt class="anime-info__label">{it.label}:</dt>
        <dd class="anime-info__value">{it.value}</dd>
      </div>
    ))}

    {genres.length > 0 && (
      <div class="anime-info__row">
        <dt class="anime-info__label">Genre:</dt>
        <dd class="anime-info__value anime-info__value--genres">
          {genres.map((g) => (
            <a href={g.href} class="anime-info__link">{g.name}</a>
          ))}
        </dd>
      </div>
    )}
  </dl>
)}

<style>
  .anime-info {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
  }

  .anime-info__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    min-width: 0;
  }

  .anime-info__label {
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .anime-info__value {
    margin: 0;
    color: var(--text-secondary);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .anime-info__value--genres {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .anime-info__link {
    color: var(--accent);
    transition: color var(--t-fast);
  }

  .anime-info__link:not(:last-child)::after {
    content: ',';
    margin-right: 0.35em;
    pointer-events: none;
  }

  .anime-info__link:hover {
    color: var(--accent-hover);
  }

</style>
