---
import SectionLabel from '~/components/SectionLabel.astro';
import { URLS } from '~/constants';
---

<section class="continue-section" data-continue-section hidden>
  <header class="section-header">
    <SectionLabel>Lanjut Nonton</SectionLabel>
  </header>

  <div class="continue-track" data-continue-track></div>
</section>

<template id="continue-card-tmpl">
  <a class="continue-card" data-continue-card>
    <div class="cover">
      <img
        data-cover-img
        alt=""
        width="300"
        height="450"
        loading="lazy"
        decoding="async"
      />
      <div class="cover-placeholder" hidden aria-hidden="true"></div>
      <span class="ep-badge" data-ep-badge></span>
      <div class="progress" data-progress hidden>
        <div class="progress-fill" data-progress-fill></div>
      </div>
    </div>
    <div class="info">
      <h3 data-title></h3>
      <span class="meta" data-meta></span>
    </div>
  </a>
</template>

<script>
  (function () {
    const KEY = 'qimochi:continue';
    const MAX_SHOW = 12;

    const section = document.querySelector<HTMLElement>('[data-continue-section]');
    const track = document.querySelector<HTMLElement>('[data-continue-track]');
    const tmpl = document.getElementById('continue-card-tmpl') as HTMLTemplateElement | null;

    if (!section || !track || !tmpl) return;

    type Item = {
      slug: string;
      title: string;
      cover: string;
      episode: number;
      total: number;
      ts: number;
    };

    let list: Item[] = [];
    try {
      const raw = localStorage.getItem(KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
          list = parsed.filter(
            (x): x is Item =>
              x &&
              typeof x.slug === 'string' &&
              typeof x.title === 'string' &&
              typeof x.episode === 'number'
          );
        }
      }
    } catch {}

    if (list.length === 0) return;

    list.sort((a, b) => (b.ts ?? 0) - (a.ts ?? 0));
    const items = list.slice(0, MAX_SHOW);

    function setupCoverFallback(img: HTMLImageElement): void {
      if (img.dataset.fallbackReady) return;
      img.dataset.fallbackReady = '1';

      const show = () => {
        img.hidden = true;
        const ph = img.parentElement?.querySelector('.cover-placeholder');
        if (ph instanceof HTMLElement) ph.hidden = false;
      };

      if (img.complete && img.naturalWidth === 0) {
        show();
        return;
      }
      img.addEventListener('error', show, { once: true });
    }

    const frag = document.createDocumentFragment();

    for (const item of items) {
      const node = tmpl.content.firstElementChild!.cloneNode(true) as HTMLElement;

      node.setAttribute('href', `/anime/watch/${item.slug}/episodes/${item.episode}/`);

      const img = node.querySelector('[data-cover-img]') as HTMLImageElement;
      img.src = item.cover || '';
      img.alt = `Cover ${item.title}`;
      setupCoverFallback(img);

      const badge = node.querySelector('[data-ep-badge]') as HTMLElement;
      badge.textContent = `Ep ${item.episode}`;

      (node.querySelector('[data-title]') as HTMLElement).textContent = item.title;

      const meta = node.querySelector('[data-meta]') as HTMLElement;
      if (item.total > 0) {
        meta.textContent = `Ep ${item.episode} · dari ${item.total}`;
      } else {
        meta.textContent = `Ep ${item.episode}`;
      }

      if (item.total > 0 && item.episode > 0) {
        const progress = node.querySelector('[data-progress]') as HTMLElement;
        const fill = node.querySelector('[data-progress-fill]') as HTMLElement;
        const pct = Math.min(100, Math.round((item.episode / item.total) * 100));
        fill.style.width = `${pct}%`;
        progress.hidden = false;

        if (item.episode >= item.total) {
          fill.classList.add('is-complete');
        }
      }

      frag.appendChild(node);
    }

    track.appendChild(frag);
    section.hidden = false;
  })();
</script>

<style>
  .continue-section {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .continue-section[hidden] {
    display: none;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .continue-track {
    display: flex;
    gap: var(--s-3);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--pad-x);
    padding-block: var(--s-1);
    margin-inline: calc(var(--pad-x) * -1);
    padding-inline: var(--pad-x);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .continue-track::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 50rem) {
    .continue-track {
      gap: var(--s-4);
    }
  }
</style>

<style is:global>
  .continue-card {
    flex: 0 0 9rem;
    scroll-snap-align: start;
    display: block;
    min-width: 0;
    background: var(--bg-elevated);
    border: 1px solid transparent;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--t-fast);
  }

  .continue-card .cover {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .continue-card .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--t-base);
  }

  .continue-card .cover img[hidden] {
    display: none;
  }

  .continue-card .cover-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      var(--bg-surface) 0%,
      var(--bg-hover) 100%
    );
  }

  .continue-card .cover-placeholder[hidden] {
    display: none;
  }

  .continue-card:hover .cover img {
    transform: scale(1.03);
  }

  .continue-card .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 55%,
      rgba(0, 0, 0, 0.7) 100%
    );
    pointer-events: none;
  }

  .continue-card .ep-badge {
    position: absolute;
    top: var(--s-2);
    right: var(--s-2);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  .continue-card .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgba(0, 0, 0, 0.55);
    z-index: 2;
  }

  .continue-card .progress[hidden] {
    display: none;
  }

  .continue-card .progress-fill {
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width var(--t-base);
  }

  .continue-card .progress-fill.is-complete {
    background: var(--success);
  }

  .continue-card .info {
    padding: var(--s-2) var(--s-3) var(--s-3);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .continue-card .info h3 {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    margin: 0;
    min-width: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .continue-card .meta {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    font-weight: var(--fw-medium);
  }

  @media (min-width: 50rem) {
    .continue-card {
      flex: 0 0 11rem;
    }
  }
</style>