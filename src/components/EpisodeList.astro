---
import { URLS } from '~/constants';
import Icon from '~/user-components/Icons.astro';
import SectionLabel from './SectionLabel.astro';

interface EpisodeItem {
  number: number;
  title?: string | null;
  duration?: number | null;
  aired?: string | null;
}

interface Props {
  slug?: string;
  animeTitle?: string;
  episodes?: EpisodeItem[];
  currentEpisode?: number | null;
  cover?: string;
  banner?: string;
  duration?: number | null;
  showNext?: boolean;
}

const {
  slug = '',
  animeTitle = '',
  episodes = [],
  currentEpisode = null,
  cover = '',
  banner = '',
  duration = null,
  showNext = true,
} = Astro.props;

const PAGE_SIZE = 15; // Jumlah episode yang dimuat per klik load more di modal

const sorted = [...episodes].sort((a, b) => a.number - b.number);
const total = sorted.length;

if (total === 0) return null;

const showFilter = total > 15;

// Tentukan halaman awal berdasarkan episode aktif agar otomatis terlihat
let initialLimit = PAGE_SIZE;
if (currentEpisode != null) {
  const activeIdx = sorted.findIndex((e) => e.number === currentEpisode);
  if (activeIdx >= 0) {
    initialLimit = Math.ceil((activeIdx + 1) / PAGE_SIZE) * PAGE_SIZE;
  }
}

let nextEpisode: EpisodeItem | null = null;
if (currentEpisode != null) {
  const idx = sorted.findIndex((e) => e.number === currentEpisode);
  if (idx >= 0 && idx < sorted.length - 1) {
    nextEpisode = sorted[idx + 1]!;
  }
}

const nextThumb = banner || cover;
const cardThumb = banner || cover;

function cleanText(s: string | null | undefined): string | null {
  if (typeof s !== 'string') return null;
  const t = s.trim();
  return t.length > 0 ? t : null;
}

function resolveDuration(epDuration?: number | null): string | null {
  const d = epDuration ?? duration;
  if (typeof d !== 'number' || d <= 0) return null;
  return `${d}m`;
}

function formatAired(raw: string | null | undefined): string | null {
  if (typeof raw !== 'string') return null;
  const t = raw.trim();
  if (!t) return null;
  const d = new Date(t);
  if (isNaN(d.getTime())) return null;
  try {
    return new Intl.DateTimeFormat('id-ID', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }).format(d);
  } catch {
    return null;
  }
}

const cleanAnimeTitle = cleanText(animeTitle);

const episodeRows = sorted.map((ep, index) => ({
  number: ep.number,
  title: cleanText(ep.title),
  durationLabel: resolveDuration(ep.duration),
  airedLabel: formatAired(ep.aired),
  isActive: ep.number === currentEpisode,
  isHidden: index >= initialLimit,
}));

const nextEpisodeRow = nextEpisode
  ? {
      number: nextEpisode.number,
      title: cleanText(nextEpisode.title),
    }
  : null;
---

<section
  class="section"
  data-episode-list
  data-page-size={PAGE_SIZE}
  data-total={total}
>
  {showNext && (
    <div class="next-block" data-next-block hidden={!nextEpisodeRow}>
      <SectionLabel as="h2" size="md" underlined={false} class="next-block__label">Episode Selanjutnya</SectionLabel>
      <a
        class="next-card"
        data-next-episode={nextEpisodeRow?.number ?? ''}
        href={nextEpisodeRow ? URLS.watch(slug, nextEpisodeRow.number) : '#'}
      >
        <div class="next-card__thumb">
          {nextThumb ? (
            <img src={nextThumb} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="next-card__thumb-placeholder" aria-hidden="true"></div>
          )}
        </div>
        <div class="next-card__info">
          <p class="next-card__title" data-next-title>
            {nextEpisodeRow
              ? `E${nextEpisodeRow.number}${nextEpisodeRow.title ? ` – ${nextEpisodeRow.title}` : ''}`
              : ''}
          </p>
          <p class="next-card__meta">Sub Indo</p>
        </div>
      </a>
    </div>
  )}

  {showFilter && (
    <input
      type="search"
      class="episode-filter"
      data-episode-filter
      placeholder="Cari episode..."
      inputmode="numeric"
      autocomplete="off"
      aria-label="Cari episode"
    />
  )}

  {/* Grid Kartu Thumbnail ala Crunchyroll */}
  <ol class="ep-grid" data-episode-items>
    {episodeRows.map((row) => (
      <li
        class:list={['ep-card', { 'is-active': row.isActive }]}
        data-episode-item
        data-number={String(row.number)}
        hidden={row.isHidden ? true : undefined}
      >
        <a
          href={URLS.watch(slug, row.number)}
          class="ep-card__link"
          aria-current={row.isActive ? 'page' : undefined}
          aria-label={`Episode ${row.number}${row.title ? ` – ${row.title}` : ''}`}
        >
          <div class="ep-card__thumb">
            {cardThumb ? (
              <img
                src={cardThumb}
                alt=""
                width="320"
                height="180"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="ep-card__thumb-fallback" aria-hidden="true">
                E{row.number}
              </div>
            )}
            {row.durationLabel && (
              <span class="ep-card__dur">{row.durationLabel}</span>
            )}
            {row.isActive && (
              <span class="ep-card__watching">NOW PLAYING</span>
            )}
          </div>
          <div class="ep-card__body">
            {cleanAnimeTitle && (
              <p class="ep-card__series">{cleanAnimeTitle}</p>
            )}
            <h4 class="ep-card__title">
              {row.title
                ? `E${row.number} – ${row.title}`
                : `Episode ${row.number}`}
            </h4>
            <p class="ep-card__meta">Sub Indo</p>
          </div>
        </a>
      </li>
    ))}
  </ol>

  {/* Tombol Load More */}
  <button
    type="button"
    class="episode-loadmore"
    data-episode-loadmore
    hidden={total <= initialLimit}
  >
    Muat Lebih Banyak
  </button>

  <p class="episode-empty" data-episode-empty hidden>
    Tidak ada episode yang cocok.
  </p>
</section>

<script>
  // @ts-nocheck
  (function () {
    const root = document.querySelector('[data-episode-list]');
    if (!root) return;

    const input = root.querySelector('[data-episode-filter]');
    const items = Array.from(root.querySelectorAll('[data-episode-item]'));
    const loadMoreBtn = root.querySelector('[data-episode-loadmore]');
    const empty = root.querySelector('[data-episode-empty]');
    
    const pageSize = Number(root.dataset.pageSize || 15);
    const total = Number(root.dataset.total || items.length);

    let currentVisibleLimit = items.filter(el => !el.hidden).length;
    if (currentVisibleLimit < pageSize) currentVisibleLimit = pageSize;

    function applyVisibility() {
      const q = (input?.value ?? '').trim();
      const filtering = q.length > 0;

      if (filtering) {
        if (loadMoreBtn) loadMoreBtn.hidden = true;
        let visible = 0;
        for (const el of items) {
          const num = el.dataset.number ?? '';
          const match = num.includes(q);
          el.hidden = !match;
          if (match) visible++;
        }
        if (empty) empty.hidden = visible > 0;
        return;
      }

      if (empty) empty.hidden = true;

      let visibleCount = 0;
      for (let i = 0; i < items.length; i++) {
        const el = items[i];
        const show = i < currentVisibleLimit;
        el.hidden = !show;
        if (show) visibleCount++;
      }

      if (loadMoreBtn) {
        loadMoreBtn.hidden = currentVisibleLimit >= total;
      }
    }

    if (input) {
      input.addEventListener('input', applyVisibility);
    }

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        currentVisibleLimit += pageSize;
        applyVisibility();
      });
    }

    function setActive(n) {
      for (const el of items) {
        const num = Number(el.dataset.number);
        const active = num === n;
        el.classList.toggle('is-active', active);
        if (active) el.setAttribute('aria-current', 'page');
        else el.removeAttribute('aria-current');

        if (active && el.hidden) {
          const idx = items.indexOf(el);
          currentVisibleLimit = Math.ceil((idx + 1) / pageSize) * pageSize;
        }
      }

      applyVisibility();

      const activeEl = items.find(
        (el) => Number(el.dataset.number) === n && !el.hidden
      );
      if (activeEl && typeof activeEl.scrollIntoView === 'function') {
        activeEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    window.__qimochiEpisodeList = { setActive };

    applyVisibility();
  })();
</script>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .episode-filter {
    width: 100%;
    padding: var(--s-2) var(--s-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: var(--fs-sm);
    border-radius: var(--r-sm);
    transition: border-color var(--t-fast);
  }
  .episode-filter::placeholder { color: var(--text-muted); }
  .episode-filter:focus {
    outline: none;
    border-color: var(--accent);
  }

  .episode-loadmore {
    width: 100%;
    padding: var(--s-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    border-radius: var(--r-sm);
    transition: all var(--t-fast);
    margin-top: var(--s-2);
  }
  .episode-loadmore:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
  }
  .episode-loadmore[hidden] {
    display: none;
  }

  /* Grid Kartu Crunchyroll Style */
  .ep-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 30rem) {
    .ep-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .ep-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-5);
    }
  }

  .ep-card {
    position: relative;
    min-width: 0;
  }
  .ep-card[hidden] { display: none; }

  .ep-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    color: inherit;
    text-decoration: none;
  }

  .ep-card__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface);
    border: 2px solid transparent;
    transition: border-color var(--t-fast);
  }

  .ep-card.is-active .ep-card__thumb {
    border-color: var(--accent);
  }

  .ep-card__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ep-card__thumb-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-montserrat);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    color: var(--text-muted);
  }

  .ep-card__dur {
    position: absolute;
    right: var(--s-2);
    bottom: var(--s-2);
    z-index: 2;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.78);
    color: var(--text-inverted);
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    backdrop-filter: blur(6px);
  }

  .ep-card__watching {
    position: absolute;
    left: var(--s-2);
    top: var(--s-2);
    z-index: 2;
    padding: 3px 8px;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 0.625rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .ep-card__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ep-card__series {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ep-card__title {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ep-card.is-active .ep-card__title {
    color: var(--accent);
  }

  .ep-card__meta {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .episode-empty {
    margin: var(--s-3) 0 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-align: center;
  }
  .episode-empty[hidden] { display: none; }
</style>
