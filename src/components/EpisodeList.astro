---
import { URLS } from '~/constants';
import SectionLabel from './SectionLabel.astro';

interface Props {
  slug?: string;
  episodes?: number[];
  currentEpisode?: number | null;
}

const {
  slug = '',
  episodes = [],
  currentEpisode = null,
} = Astro.props;

const total = episodes.length;
const showFilter = total > 30;
---

<section class="section" data-episode-list>
  <SectionLabel>Episode</SectionLabel>

  {showFilter && (
    <input
      type="search"
      class="episode-filter"
      data-episode-filter
      placeholder="Cari nomor episode..."
      inputmode="numeric"
      autocomplete="off"
      aria-label="Cari nomor episode"
    />
  )}

  <div class="episode-grid" data-episode-items>
    {episodes.map((num) => {
      const isActive = num === currentEpisode;
      return (
        <a
          href={URLS.watch(slug, num)}
          class:list={['episode-btn', { active: isActive }]}
          aria-current={isActive ? 'page' : undefined}
          data-episode-item
          data-number={String(num)}
        >
          {String(num).padStart(2, '0')}
        </a>
      );
    })}
  </div>

  <p class="episode-empty" data-episode-empty hidden>
    Tidak ada episode yang cocok.
  </p>
</section>

<script>
  (function () {
    const root = document.querySelector<HTMLElement>('[data-episode-list]');
    if (!root) return;

    const input = root.querySelector<HTMLInputElement>('[data-episode-filter]');
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-episode-item]'));
    const empty = root.querySelector<HTMLElement>('[data-episode-empty]');

    if (input) {
      input.addEventListener('input', () => {
        const q = input.value.trim();
        let visible = 0;
        if (!q) {
          for (const el of items) el.hidden = false;
          if (empty) empty.hidden = true;
          return;
        }
        for (const el of items) {
          const num = el.dataset.number ?? '';
          const match = num.includes(q);
          el.hidden = !match;
          if (match) visible++;
        }
        if (empty) empty.hidden = visible > 0;
      });
    }
  })();
</script>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .episode-filter {
    width: 100%;
    padding: var(--s-2) var(--s-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: var(--fs-sm);
    border-radius: var(--r-sm);
    transition: border-color var(--t-fast);
  }
  .episode-filter::placeholder { color: var(--text-muted); }
  .episode-filter:focus {
    outline: none;
    border-color: var(--accent);
  }
  .episode-filter::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .episode-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(3rem, 1fr));
    gap: var(--s-2);
  }

  .episode-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--t-fast);
  }
  .episode-btn:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }
  .episode-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
    pointer-events: none;
  }
  .episode-btn[hidden] { display: none; }

  .episode-empty {
    margin: var(--s-3) 0 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-align: center;
  }
  .episode-empty[hidden] { display: none; }
</style>