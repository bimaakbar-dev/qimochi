---
import { URLS } from '~/constants';
import Icon from '~/user-components/Icons.astro';

interface EpisodeItem {
  number: number;
  title?: string | null;
  duration?: number | null;
  aired?: string | null;
}

interface Props {
  slug?: string;
  animeTitle?: string;
  episodes?: EpisodeItem[];
  currentEpisode?: number | null;
  cover?: string;
  banner?: string;
  duration?: number | null;
}

const {
  slug = '',
  animeTitle = '',
  episodes = [],
  currentEpisode = null,
  cover = '',
  banner = '',
  duration = null,
} = Astro.props;

const PAGE_SIZE = 12;

const sorted = [...episodes].sort((a, b) => a.number - b.number);
const total = sorted.length;

if (total === 0) return null;

let initialLimit = PAGE_SIZE;
if (currentEpisode != null) {
  const activeIdx = sorted.findIndex((e) => e.number === currentEpisode);
  if (activeIdx >= 0) {
    initialLimit = Math.ceil((activeIdx + 1) / PAGE_SIZE) * PAGE_SIZE;
  }
}

const cardThumb = banner || cover;

function cleanText(s: string | null | undefined): string | null {
  if (typeof s !== 'string') return null;
  const t = s.trim();
  return t.length > 0 ? t : null;
}

function resolveDuration(epDuration?: number | null): string | null {
  const d = epDuration ?? duration;
  if (typeof d !== 'number' || d <= 0) return null;
  return `${d}m`;
}

function formatAired(raw: string | null | undefined): string | null {
  if (typeof raw !== 'string') return null;
  const t = raw.trim();
  if (!t) return null;
  const d = new Date(t);
  if (isNaN(d.getTime())) return null;
  try {
    return new Intl.DateTimeFormat('id-ID', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }).format(d);
  } catch {
    return null;
  }
}

const cleanAnimeTitle = cleanText(animeTitle);

const episodeRows = sorted.map((ep, index) => ({
  number: ep.number,
  title: cleanText(ep.title),
  durationLabel: resolveDuration(ep.duration),
  airedLabel: formatAired(ep.aired),
  isActive: currentEpisode != null && ep.number === currentEpisode,
  isHidden: index >= initialLimit,
}));

function formatEp(n: number): string {
  return String(n).padStart(2, '0');
}

const initialEpisodeAttr = currentEpisode != null ? String(currentEpisode) : '';
---

<section
  class="section"
  data-episode-list
  data-page-size={PAGE_SIZE}
  data-total={total}
  data-initial-episode={initialEpisodeAttr}
>
  <ol class="ep-grid" data-episode-items>
    {episodeRows.map((row) => (
      <li
        class:list={['ep-card', { 'is-active': row.isActive }]}
        data-episode-item
        data-number={String(row.number)}
        hidden={row.isHidden ? true : undefined}
      >
        <a
          href={URLS.watch(slug, row.number)}
          class="ep-card__link"
          aria-current={row.isActive ? 'page' : undefined}
          aria-label={`Episode ${row.number}${row.title ? ` – ${row.title}` : ''}`}
        >
          <div class="ep-card__thumb">
            {cardThumb ? (
              <img
                src={cardThumb}
                alt=""
                width="320"
                height="180"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="ep-card__thumb-fallback" aria-hidden="true">
                {formatEp(row.number)}
              </div>
            )}
            {row.durationLabel && (
              <span class="ep-card__dur">{row.durationLabel}</span>
            )}
            {row.isActive && (
              <span class="ep-card__watching">Sedang Ditonton</span>
            )}
          </div>
          <div class="ep-card__body">
            {cleanAnimeTitle && (
              <p class="ep-card__series">{cleanAnimeTitle}</p>
            )}
            <h4 class="ep-card__title">
              {row.title
                ? `E${row.number} – ${row.title}`
                : `Episode ${row.number}`}
            </h4>
            <p class="ep-card__meta">Sub Indo</p>
          </div>
        </a>

        <div class="ep-card__hover" aria-hidden="true">
          {cleanAnimeTitle && (
            <p class="ep-card__hover-series">{cleanAnimeTitle}</p>
          )}
          <h4 class="ep-card__hover-title">
            {row.title
              ? `E${row.number} – ${row.title}`
              : `Episode ${row.number}`}
          </h4>
          {row.airedLabel && (
            <p class="ep-card__hover-aired">
              <span class="ep-card__hover-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
                  <path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"/>
                  <path d="M16 3l0 4"/>
                  <path d="M8 3l0 4"/>
                  <path d="M4 11l16 0"/>
                </svg>
              </span>
              <span>{row.airedLabel}</span>
            </p>
          )}
          <div class="ep-card__hover-actions">
            <span class="ep-card__hover-play">
              <Icon name="play" size={14} />
              <span>Putar E{row.number}</span>
            </span>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <div class="episode-loadmore-wrap">
    <button
      type="button"
      class="episode-loadmore"
      data-episode-loadmore
      hidden={total <= initialLimit}
    >
      Muat Lebih Banyak
    </button>
  </div>
</section>

<script>
  // @ts-nocheck
  (function () {
    const root = document.querySelector('[data-episode-list]');
    if (!root) return;

    const items = Array.from(root.querySelectorAll('[data-episode-item]'));
    const loadMoreBtn = root.querySelector('[data-episode-loadmore]');

    const pageSize = Number(root.dataset.pageSize || 15);
    const total = Number(root.dataset.total || items.length);

    let currentVisibleLimit = items.filter((el) => !el.hidden).length;
    if (currentVisibleLimit < pageSize) currentVisibleLimit = pageSize;

    function applyVisibility() {
      for (let i = 0; i < items.length; i++) {
        const el = items[i];
        const show = i < currentVisibleLimit;
        el.hidden = !show;
      }

      if (loadMoreBtn) {
        loadMoreBtn.hidden = currentVisibleLimit >= total;
      }
    }

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        currentVisibleLimit += pageSize;
        applyVisibility();
      });
    }

    function setActive(n) {
      for (const el of items) {
        const num = Number(el.dataset.number);
        const active = num === n;
        el.classList.toggle('is-active', active);
        if (active) el.setAttribute('aria-current', 'page');
        else el.removeAttribute('aria-current');

        const thumb = el.querySelector('.ep-card__thumb');
        if (thumb) {
          let badge = thumb.querySelector('.ep-card__watching');
          if (active) {
            if (!badge) {
              badge = document.createElement('span');
              badge.className = 'ep-card__watching';
              badge.textContent = 'Sedang Ditonton';
              thumb.appendChild(badge);
            }
          } else {
            if (badge) badge.remove();
          }
        }

        if (active && el.hidden) {
          const idx = items.indexOf(el);
          currentVisibleLimit = Math.ceil((idx + 1) / pageSize) * pageSize;
        }
      }

      applyVisibility();

      const activeEl = items.find(
        (el) => Number(el.dataset.number) === n && !el.hidden
      );
      if (activeEl && typeof activeEl.scrollIntoView === 'function') {
        activeEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    window.__qimochiEpisodeList = { setActive };

    const attr = (root.dataset.initialEpisode || '').trim();
    const initialEp = attr ? parseInt(attr, 10) : NaN;
    const sp = new URLSearchParams(window.location.search);
    const epParam = parseInt(sp.get('ep') ?? '', 10);

    const target = !isNaN(epParam) ? epParam : initialEp;

    if (!isNaN(target)) {
      setActive(target);
    }
  })();
</script>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .episode-loadmore-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--s-2);
  }

  .episode-loadmore {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-3) var(--s-8);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    border-radius: var(--r-full);
    transition: all var(--t-fast);
  }
  .episode-loadmore:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }
  .episode-loadmore[hidden] {
    display: none;
  }

  .ep-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 30rem) {
    .ep-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .ep-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-5);
    }
  }

  .ep-card {
    position: relative;
    min-width: 0;
  }
  .ep-card[hidden] { display: none; }

  .ep-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    color: inherit;
    text-decoration: none;
  }

  .ep-card__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface);
    border: 2px solid transparent;
    transition: border-color var(--t-fast);
  }

  .ep-card.is-active .ep-card__thumb {
    border-color: var(--accent);
  }

  .ep-card__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--t-base);
  }

  .ep-card__link:hover .ep-card__thumb img {
    opacity: 0.15;
  }

  .ep-card__thumb-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-montserrat);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    color: var(--text-muted);
  }

  .ep-card__dur {
    position: absolute;
    right: var(--s-2);
    bottom: var(--s-2);
    z-index: 2;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.78);
    color: var(--text-inverted);
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    backdrop-filter: blur(6px);
    transition: opacity var(--t-fast);
  }

  .ep-card__watching {
    position: absolute;
    left: var(--s-2);
    top: var(--s-2);
    z-index: 2;
    padding: 3px 8px;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 0.625rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    transition: opacity var(--t-fast);
  }

  .ep-card:hover .ep-card__dur,
  .ep-card:hover .ep-card__watching {
    opacity: 0;
  }

  .ep-card__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ep-card__series {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ep-card__title {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ep-card.is-active .ep-card__title {
    color: var(--accent);
  }

  .ep-card__meta {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .ep-card__hover {
    position: absolute;
    inset: 0;
    padding: var(--s-3);
    background: hsla(30, 3%, 5%, 0.94);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--t-base), visibility var(--t-base);
    z-index: 5;
    overflow: hidden;
  }

  .ep-card__hover-series {
    margin: 0;
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ep-card__hover-title {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ep-card__hover-aired {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .ep-card__hover-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: currentColor;
  }

  .ep-card__hover-actions {
    margin-top: auto;
  }

  .ep-card__hover-play {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (hover: hover) and (pointer: fine) {
    .ep-card:hover .ep-card__hover {
      opacity: 1;
      visibility: visible;
    }
  }
</style>