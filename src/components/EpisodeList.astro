---
import { URLS } from '~/constants';
import SectionLabel from './SectionLabel.astro';

interface EpisodeItem {
  number: number;
  title?: string | null;
  duration?: number | null;
}

interface Props {
  slug?: string;
  animeTitle?: string;
  episodes?: EpisodeItem[];
  currentEpisode?: number | null;
  mode?: 'watch' | 'detail';
  cover?: string;
  banner?: string;
  duration?: number | null;
}

const {
  slug = '',
  animeTitle = '',
  episodes = [],
  currentEpisode = null,
  mode = 'detail',
  cover = '',
  banner = '',
  duration = null,
} = Astro.props;

const BATCH_SIZE = 50;

const sorted = [...episodes].sort((a, b) => a.number - b.number);
const total = sorted.length;

if (total === 0) return null;

const showFilter = total > 30;
const showBatches = total > BATCH_SIZE;

interface Batch {
  start: number;
  end: number;
}

const batches: Batch[] = [];
if (showBatches) {
  for (let i = 0; i < sorted.length; i += BATCH_SIZE) {
    const chunk = sorted.slice(i, i + BATCH_SIZE);
    batches.push({
      start: chunk[0]!.number,
      end: chunk[chunk.length - 1]!.number,
    });
  }
} else {
  batches.push({
    start: sorted[0]!.number,
    end: sorted[sorted.length - 1]!.number,
  });
}

let activeBatchIdx = 0;
if (currentEpisode != null) {
  const idx = batches.findIndex(
    (b) => currentEpisode >= b.start && currentEpisode <= b.end
  );
  if (idx >= 0) activeBatchIdx = idx;
}

let nextEpisode: EpisodeItem | null = null;
if (mode === 'watch' && currentEpisode != null) {
  const idx = sorted.findIndex((e) => e.number === currentEpisode);
  if (idx >= 0 && idx < sorted.length - 1) {
    nextEpisode = sorted[idx + 1]!;
  }
}

const nextThumb = banner || cover;
const activeBatch = batches[activeBatchIdx]!;

// Thumbnail untuk card grid — fallback banner > cover
const cardThumb = banner || cover;

// Durasi fallback — pakai ep.duration > props.duration > null
function resolveDuration(epDuration?: number | null): string | null {
  const d = epDuration ?? duration;
  if (typeof d !== 'number' || d <= 0) return null;
  return `${d}m`;
}

const episodeRows = sorted.map((ep) => ({
  number: ep.number,
  title: ep.title ?? null,
  durationLabel: resolveDuration(ep.duration),
  isActive: ep.number === currentEpisode,
  inActiveBatch:
    ep.number >= activeBatch.start && ep.number <= activeBatch.end,
}));

function formatEp(n: number): string {
  return String(n).padStart(2, '0');
}
---

<section class="section" data-episode-list data-mode={mode}>
  <div class="next-block" data-next-block hidden={!nextEpisode}>
    <SectionLabel as="h2" size="md" underlined={false} class="next-block__label">Episode Selanjutnya</SectionLabel>
    <a
      class="next-card"
      data-next-episode={nextEpisode?.number ?? ''}
      href={nextEpisode ? URLS.watch(slug, nextEpisode.number) : '#'}
    >
      <div class="next-card__thumb">
        {nextThumb ? (
          <img src={nextThumb} alt="" loading="lazy" decoding="async" />
        ) : (
          <div class="next-card__thumb-placeholder" aria-hidden="true"></div>
        )}
      </div>
      <div class="next-card__info">
        <p class="next-card__title" data-next-title>
          {nextEpisode
            ? `E${nextEpisode.number}${nextEpisode.title ? ` – ${nextEpisode.title}` : ''}`
            : ''}
        </p>
        <p class="next-card__meta">Sub Indo</p>
      </div>
    </a>
  </div>

  <SectionLabel as="h3" size="md">Episode</SectionLabel>

  {showFilter && (
    <input
      type="search"
      class="episode-filter"
      data-episode-filter
      placeholder="Cari episode..."
      inputmode="numeric"
      autocomplete="off"
      aria-label="Cari episode"
    />
  )}

  {showBatches && (
    <div class="episode-batches" data-episode-batches role="tablist">
      {batches.map((b, i) => (
        <button
          type="button"
          class:list={['episode-batch', { 'is-active': i === activeBatchIdx }]}
          data-batch-tab
          data-batch-start={b.start}
          data-batch-end={b.end}
          role="tab"
          aria-selected={i === activeBatchIdx ? 'true' : 'false'}
        >
          {b.start}–{b.end}
        </button>
      ))}
    </div>
  )}

  {/* ── Detail mode: card grid Crunchyroll-style ── */}
  {mode === 'detail' && (
    <ol class="ep-grid" data-episode-items>
      {episodeRows.map((row) => (
        <li
          class:list={['ep-card', { 'is-active': row.isActive }]}
          data-episode-item
          data-number={String(row.number)}
          hidden={row.inActiveBatch ? undefined : true}
        >
          <a
            href={URLS.watch(slug, row.number)}
            class="ep-card__link"
            aria-current={row.isActive ? 'page' : undefined}
            aria-label={`Episode ${row.number}${row.title ? ` – ${row.title}` : ''}`}
          >
            <div class="ep-card__thumb">
              {cardThumb ? (
                <img
                  src={cardThumb}
                  alt=""
                  width="320"
                  height="180"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="ep-card__thumb-fallback" aria-hidden="true">
                  {formatEp(row.number)}
                </div>
              )}
              {row.durationLabel && (
                <span class="ep-card__dur">{row.durationLabel}</span>
              )}
              {row.isActive && (
                <span class="ep-card__watching">Sedang ditonton</span>
              )}
            </div>
            <div class="ep-card__body">
              {animeTitle && (
                <p class="ep-card__series">{animeTitle}</p>
              )}
              <h4 class="ep-card__title">
                {row.title
                  ? `E${row.number} – ${row.title}`
                  : `Episode ${row.number}`}
              </h4>
              <p class="ep-card__meta">Sub Indo</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  )}

  {/* ── Watch mode: compact grid untuk sidebar ── */}
  {mode === 'watch' && (
    <div class="ep-compact-grid" data-episode-items>
      {episodeRows.map((row) => (
        <a
          href={URLS.watch(slug, row.number)}
          class:list={['ep-compact', { 'is-active': row.isActive }]}
          aria-current={row.isActive ? 'page' : undefined}
          data-episode-item
          data-number={String(row.number)}
          hidden={row.inActiveBatch ? undefined : true}
        >
          <span class="ep-compact__num">{formatEp(row.number)}</span>
          <span class="ep-compact__title">
            {row.title || `Episode ${row.number}`}
          </span>
        </a>
      ))}
    </div>
  )}

  <p class="episode-empty" data-episode-empty hidden>
    Tidak ada episode yang cocok.
  </p>
</section>

<script>
  // @ts-nocheck
  (function () {
    const root = document.querySelector('[data-episode-list]');
    if (!root) return;

    const input = root.querySelector('[data-episode-filter]');
    const batches = root.querySelector('[data-episode-batches]');
    const tabs = Array.from(root.querySelectorAll('[data-batch-tab]'));
    const items = Array.from(root.querySelectorAll('[data-episode-item]'));
    const empty = root.querySelector('[data-episode-empty]');

    let activeBatchIdx = tabs.findIndex((t) => t.classList.contains('is-active'));
    if (activeBatchIdx < 0) activeBatchIdx = 0;

    function applyVisibility() {
      const q = (input?.value ?? '').trim();
      const filtering = q.length > 0;

      if (batches) batches.hidden = filtering;

      if (filtering) {
        let visible = 0;
        for (const el of items) {
          const num = el.dataset.number ?? '';
          const match = num.includes(q);
          el.hidden = !match;
          if (match) visible++;
        }
        if (empty) empty.hidden = visible > 0;
        return;
      }

      if (empty) empty.hidden = true;

      const activeTab = tabs[activeBatchIdx];
      if (!activeTab) {
        for (const el of items) el.hidden = false;
        return;
      }

      const start = Number(activeTab.dataset.batchStart);
      const end = Number(activeTab.dataset.batchEnd);

      for (const el of items) {
        const num = Number(el.dataset.number);
        el.hidden = num < start || num > end;
      }
    }

    if (input) {
      input.addEventListener('input', applyVisibility);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        activeBatchIdx = i;
        tabs.forEach((t, j) => {
          t.classList.toggle('is-active', j === i);
          t.setAttribute('aria-selected', j === i ? 'true' : 'false');
        });
        applyVisibility();
      });
    });

    /* ==== Expose API untuk SPA-lite switch episode ==== */

    function setActive(n) {
      if (tabs.length > 0) {
        const idx = tabs.findIndex((t) => {
          const s = Number(t.dataset.batchStart);
          const e = Number(t.dataset.batchEnd);
          return n >= s && n <= e;
        });
        if (idx >= 0 && idx !== activeBatchIdx) {
          activeBatchIdx = idx;
          tabs.forEach((t, j) => {
            t.classList.toggle('is-active', j === idx);
            t.setAttribute('aria-selected', j === idx ? 'true' : 'false');
          });
        }
      }

      for (const el of items) {
        const num = Number(el.dataset.number);
        const active = num === n;
        el.classList.toggle('is-active', active);
        if (active) el.setAttribute('aria-current', 'page');
        else el.removeAttribute('aria-current');
      }

      applyVisibility();

      const activeEl = items.find(
        (el) => Number(el.dataset.number) === n && !el.hidden
      );
      if (activeEl && typeof activeEl.scrollIntoView === 'function') {
        activeEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    window.__qimochiEpisodeList = { setActive };

    applyVisibility();
  })();
</script>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .next-block {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-bottom: var(--s-2);
  }
  .next-block[hidden] { display: none; }

  .next-block__label {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .next-card {
    display: flex;
    gap: var(--s-3);
    padding: var(--s-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--t-fast), background var(--t-fast);
  }

  .next-card:hover {
    border-color: var(--accent);
    background: var(--bg-surface);
  }

  .next-card__thumb {
    position: relative;
    flex-shrink: 0;
    width: 7rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .next-card__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .next-card__thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg-surface);
  }

  .next-card__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-2);
    min-width: 0;
  }

  .next-card__title {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .next-card__meta {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .episode-filter {
    width: 100%;
    padding: var(--s-2) var(--s-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: var(--fs-sm);
    border-radius: var(--r-sm);
    transition: border-color var(--t-fast);
  }
  .episode-filter::placeholder { color: var(--text-muted); }
  .episode-filter:focus {
    outline: none;
    border-color: var(--accent);
  }
  .episode-filter::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .episode-batches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }

  .episode-batches[hidden] {
    display: none;
  }

  .episode-batch {
    padding: var(--s-1) var(--s-3);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: all var(--t-fast);
  }

  .episode-batch:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .episode-batch.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
  }

  /* ══════════════════════════════════════════
     DETAIL MODE — card grid Crunchyroll-style
     ══════════════════════════════════════════ */

  .ep-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 50rem) {
    .ep-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-5);
    }
  }

  .ep-card {
    min-width: 0;
  }
  .ep-card[hidden] { display: none; }

  .ep-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    color: inherit;
    text-decoration: none;
    transition: transform var(--t-fast);
  }

  .ep-card__link:hover {
    transform: translateY(-2px);
  }

  .ep-card__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface);
    border: 2px solid transparent;
    transition: border-color var(--t-fast);
  }

  .ep-card.is-active .ep-card__thumb {
    border-color: var(--accent);
  }

  .ep-card__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-base), opacity var(--t-base);
  }

  .ep-card__link:hover .ep-card__thumb img {
    transform: scale(1.04);
    opacity: 0.9;
  }

  .ep-card__thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, transparent 50%);
    pointer-events: none;
  }

  .ep-card__thumb-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-montserrat);
    font-size: var(--fs-3xl);
    font-weight: var(--fw-bold);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .ep-card__dur {
    position: absolute;
    right: var(--s-2);
    bottom: var(--s-2);
    z-index: 2;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.78);
    color: var(--text-inverted);
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .ep-card__watching {
    position: absolute;
    left: var(--s-2);
    bottom: var(--s-2);
    z-index: 2;
    padding: 2px 6px;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 0.625rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .ep-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .ep-card__series {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ep-card__title {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .ep-card.is-active .ep-card__title {
    color: var(--accent);
  }

  .ep-card__link:hover .ep-card__title {
    color: var(--accent);
  }

  .ep-card__meta {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ══════════════════════════════════════════
     WATCH MODE — compact grid untuk sidebar
     ══════════════════════════════════════════ */

  .ep-compact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-2);
  }

  @media (min-width: 50rem) {
    .ep-compact-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .ep-compact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--t-fast);
  }
  .ep-compact:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }
  .ep-compact.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
    pointer-events: none;
  }
  .ep-compact[hidden] { display: none; }

  .ep-compact__num {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }

  .ep-compact__title {
    display: none;
  }

  .episode-empty {
    margin: var(--s-3) 0 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-align: center;
  }
  .episode-empty[hidden] { display: none; }

  @media (min-width: 50rem) {
    .next-card__thumb {
      width: 10rem;
    }

    .next-card__title {
      font-size: var(--fs-base);
    }
  }
</style>
