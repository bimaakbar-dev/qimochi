---
import { URLS } from '~/constants';
import SectionLabel from './SectionLabel.astro';

interface EpisodeItem {
  number: number;
  title?: string | null;
}

interface Props {
  slug?: string;
  episodes?: EpisodeItem[];
  currentEpisode?: number | null;
  mode?: 'watch' | 'detail';
  cover?: string;
  banner?: string;
}

const {
  slug = '',
  episodes = [],
  currentEpisode = null,
  mode = 'detail',
  cover = '',
  banner = '',
} = Astro.props;

const BATCH_SIZE = 50;

const sorted = [...episodes].sort((a, b) => a.number - b.number);
const total = sorted.length;

if (total === 0) return null;

const showFilter = total > 30;
const showBatches = total > BATCH_SIZE;

interface Batch {
  start: number;
  end: number;
}

const batches: Batch[] = [];
if (showBatches) {
  for (let i = 0; i < sorted.length; i += BATCH_SIZE) {
    const chunk = sorted.slice(i, i + BATCH_SIZE);
    batches.push({
      start: chunk[0]!.number,
      end: chunk[chunk.length - 1]!.number,
    });
  }
} else {
  batches.push({
    start: sorted[0]!.number,
    end: sorted[sorted.length - 1]!.number,
  });
}

let activeBatchIdx = 0;
if (currentEpisode != null) {
  const idx = batches.findIndex(
    (b) => currentEpisode >= b.start && currentEpisode <= b.end
  );
  if (idx >= 0) activeBatchIdx = idx;
}

let nextEpisode: EpisodeItem | null = null;
if (mode === 'watch' && currentEpisode != null) {
  const idx = sorted.findIndex((e) => e.number === currentEpisode);
  if (idx >= 0 && idx < sorted.length - 1) {
    nextEpisode = sorted[idx + 1]!;
  }
}

const nextThumb = banner || cover;
const activeBatch = batches[activeBatchIdx]!;

const episodeRows = sorted.map((ep) => ({
  number: ep.number,
  isActive: ep.number === currentEpisode,
  inActiveBatch:
    ep.number >= activeBatch.start && ep.number <= activeBatch.end,
}));

function formatEp(n: number): string {
  return String(n).padStart(2, '0');
}
---

<section class="section" data-episode-list>
  {nextEpisode && (
    <div class="next-block">
      <p class="next-block__label">Episode Selanjutnya</p>
      <a class="next-card" href={URLS.watch(slug, nextEpisode.number)}>
        <div class="next-card__thumb">
          {nextThumb ? (
            <img src={nextThumb} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="next-card__thumb-placeholder" aria-hidden="true"></div>
          )}
        </div>
        <div class="next-card__info">
          <p class="next-card__title">
            E{nextEpisode.number}
            {nextEpisode.title ? ` – ${nextEpisode.title}` : ''}
          </p>
          <p class="next-card__meta">Sub Indo</p>
        </div>
      </a>
    </div>
  )}

  <SectionLabel>Episode</SectionLabel>

  {showFilter && (
    <input
      type="search"
      class="episode-filter"
      data-episode-filter
      placeholder="Cari episode..."
      inputmode="numeric"
      autocomplete="off"
      aria-label="Cari episode"
    />
  )}

  {showBatches && (
    <div class="episode-batches" data-episode-batches role="tablist">
      {batches.map((b, i) => (
        <button
          type="button"
          class:list={['episode-batch', { 'is-active': i === activeBatchIdx }]}
          data-batch-tab
          data-batch-start={b.start}
          data-batch-end={b.end}
          role="tab"
          aria-selected={i === activeBatchIdx ? 'true' : 'false'}
        >
          {b.start}–{b.end}
        </button>
      ))}
    </div>
  )}

  <div class="episode-grid" data-episode-items>
    {episodeRows.map((row) => (
      <a
        href={URLS.watch(slug, row.number)}
        class:list={['episode-btn', { active: row.isActive }]}
        aria-current={row.isActive ? 'page' : undefined}
        data-episode-item
        data-number={String(row.number)}
        hidden={row.inActiveBatch ? undefined : true}
      >
        {formatEp(row.number)}
      </a>
    ))}
  </div>

  <p class="episode-empty" data-episode-empty hidden>
    Tidak ada episode yang cocok.
  </p>
</section>

<script>
  // @ts-nocheck
  (function () {
    const root = document.querySelector('[data-episode-list]');
    if (!root) return;

    const input = root.querySelector('[data-episode-filter]');
    const batches = root.querySelector('[data-episode-batches]');
    const tabs = Array.from(root.querySelectorAll('[data-batch-tab]'));
    const items = Array.from(root.querySelectorAll('[data-episode-item]'));
    const empty = root.querySelector('[data-episode-empty]');

    let activeBatchIdx = tabs.findIndex((t) => t.classList.contains('is-active'));
    if (activeBatchIdx < 0) activeBatchIdx = 0;

    function applyVisibility() {
      const q = (input?.value ?? '').trim();
      const filtering = q.length > 0;

      if (batches) batches.hidden = filtering;

      if (filtering) {
        let visible = 0;
        for (const el of items) {
          const num = el.dataset.number ?? '';
          const match = num.includes(q);
          el.hidden = !match;
          if (match) visible++;
        }
        if (empty) empty.hidden = visible > 0;
        return;
      }

      if (empty) empty.hidden = true;

      const activeTab = tabs[activeBatchIdx];
      if (!activeTab) {
        for (const el of items) el.hidden = false;
        return;
      }

      const start = Number(activeTab.dataset.batchStart);
      const end = Number(activeTab.dataset.batchEnd);

      for (const el of items) {
        const num = Number(el.dataset.number);
        el.hidden = num < start || num > end;
      }
    }

    if (input) {
      input.addEventListener('input', applyVisibility);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        activeBatchIdx = i;
        tabs.forEach((t, j) => {
          t.classList.toggle('is-active', j === i);
          t.setAttribute('aria-selected', j === i ? 'true' : 'false');
        });
        applyVisibility();
      });
    });

    applyVisibility();
  })();
</script>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  /* ==== Next episode card ==== */
  .next-block {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-bottom: var(--s-2);
  }

  .next-block__label {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .next-card {
    display: flex;
    gap: var(--s-3);
    padding: var(--s-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--t-fast), background var(--t-fast);
  }

  .next-card:hover {
    border-color: var(--accent);
    background: var(--bg-surface);
  }

  .next-card__thumb {
    position: relative;
    flex-shrink: 0;
    width: 7rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .next-card__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .next-card__thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg-surface);
  }

  .next-card__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-2);
    min-width: 0;
  }

  .next-card__title {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .next-card__meta {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  /* ==== Filter ==== */
  .episode-filter {
    width: 100%;
    padding: var(--s-2) var(--s-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: var(--fs-sm);
    border-radius: var(--r-sm);
    transition: border-color var(--t-fast);
  }
  .episode-filter::placeholder { color: var(--text-muted); }
  .episode-filter:focus {
    outline: none;
    border-color: var(--accent);
  }
  .episode-filter::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  /* ==== Batches ==== */
  .episode-batches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }

  .episode-batches[hidden] {
    display: none;
  }

  .episode-batch {
    padding: var(--s-1) var(--s-3);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: all var(--t-fast);
  }

  .episode-batch:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .episode-batch.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
  }

  /* ==== Grid ==== */
  .episode-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(3rem, 1fr));
    gap: var(--s-2);
  }

  .episode-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--t-fast);
  }
  .episode-btn:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }
  .episode-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
    pointer-events: none;
  }
  .episode-btn[hidden] { display: none; }

  .episode-empty {
    margin: var(--s-3) 0 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-align: center;
  }
  .episode-empty[hidden] { display: none; }

  @media (min-width: 50rem) {
    .next-card__thumb {
      width: 10rem;
    }

    .next-card__title {
      font-size: var(--fs-base);
    }
  }
</style>
