---
interface Props {
  animeId: string;
  class?: string;
}

const { animeId, class: className } = Astro.props;
---

<div class:list={['daftarku-wrap', className]}>
  <button
    type="button"
    class="action-btn"
    data-daftarku-btn
    data-anime={animeId}
    aria-label="Tambah ke daftarku"
    title="Tambah ke daftarku"
  >
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none"
      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      aria-hidden="true">
      <path d="M12 5v14M5 12h14"/>
    </svg>
    <span class="action-btn__label">Daftarku</span>
  </button>
</div>

<script>
  interface AuthUser {
    sub: string;
    name: string;
    email: string;
    picture: string | null;
  }

  (function () {
    function readCache(): AuthUser | null {
      try {
        const raw = localStorage.getItem('qimochi:user-cache');
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<AuthUser> | null;
        if (
          parsed &&
          typeof parsed.sub === 'string' &&
          typeof parsed.name === 'string'
        ) {
          return {
            sub: parsed.sub,
            name: parsed.name,
            email: typeof parsed.email === 'string' ? parsed.email : '',
            picture: typeof parsed.picture === 'string' ? parsed.picture : null,
          };
        }
      } catch {}
      return null;
    }

    function init(btn: HTMLButtonElement): void {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';

      let currentUser: AuthUser | null = readCache();

      function onAuthChanged(e: Event): void {
        const detail = (e as CustomEvent<{ user: AuthUser | null }>).detail;
        if (!detail) return;
        currentUser = detail.user;
      }
      document.addEventListener('qimochi:auth-changed', onAuthChanged);

      btn.addEventListener('click', () => {
        if (!currentUser) {
          const menu = (window as any).__qimochiUserMenu;
          if (menu?.open) menu.open();
          return;
        }
        console.info('[daftarku] TODO: implement user list untuk', btn.dataset.anime);
      });
    }

    document
      .querySelectorAll<HTMLButtonElement>('[data-daftarku-btn]')
      .forEach(init);
  })();
</script>

<style>
  .daftarku-wrap {
    display: flex;
    justify-content: center;
  }

  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-3);
    width: 100%;
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: background var(--t-fast);
  }
  .action-btn:hover { background: var(--accent-soft); }
  .action-btn__label { line-height: 1; }

  @media (min-width: 50rem) {
    .daftarku-wrap { justify-content: flex-start; }
    .action-btn {
      flex-direction: row;
      width: auto;
      padding: var(--s-2) var(--s-3);
      gap: var(--s-2);
    }
  }
</style>
