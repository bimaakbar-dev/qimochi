---
interface Props {
  src?: string;
  title?: string;
}

const { src = '', title = '' } = Astro.props;

function encodeSrc(s: string): string {
  if (!s) return '';
  const bytes = new TextEncoder().encode(s);
  let bin = '';
  for (const b of bytes) bin += String.fromCharCode(b);
  return btoa(bin);
}

const encodedSrc = encodeSrc(src);
---

<div class="player-wrapper" data-player>
  <div class="player-frame">
    <iframe
      id="player-iframe"
      data-enc={encodedSrc || undefined}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
      loading="eager"
      referrerpolicy="no-referrer"
    ></iframe>

    <div class="player-loading" data-player-loading hidden>
      <div class="player-spinner" aria-hidden="true"></div>
      <p class="player-loading-text">Memuat<span data-loading-label></span>…</p>
    </div>

    <div class="player-error" data-player-error hidden>
      <p class="player-error-msg" data-error-msg>Player gagal dimuat.</p>
      <div class="player-error-actions">
        <button type="button" class="player-btn player-btn--primary" data-player-retry>
          Coba Lagi
        </button>
      </div>
    </div>

    <noscript>
      <p class="player-noscript">Aktifkan JavaScript untuk memuat player.</p>
    </noscript>
  </div>
</div>

<style>
  .player-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

  .player-frame {
    position: absolute;
    inset: 0;
  }

  .player-frame iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    opacity: 0;
    transition: opacity var(--t-base);
  }

  .player-frame iframe.is-loaded {
    opacity: 1;
  }

  .player-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    background: #000;
    color: #ccc;
    z-index: 2;
  }
  .player-loading[hidden] { display: none; }

  .player-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid hsla(0, 0%, 100%, 0.15);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: player-spin 0.8s linear infinite;
  }
  @keyframes player-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .player-spinner { animation-duration: 2.5s; }
  }

  .player-loading-text {
    margin: 0;
    font-size: var(--fs-xs);
    color: #aaa;
    letter-spacing: 0.04em;
    padding-inline: var(--s-4);
  }

  .player-error {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-4);
    background: hsla(0, 0%, 0%, 0.92);
    color: #fff;
    padding: var(--s-4);
    text-align: center;
    z-index: 3;
  }
  .player-error[hidden] { display: none; }

  .player-error-msg {
    margin: 0;
    font-size: var(--fs-sm);
    color: #ddd;
    max-width: 34ch;
    line-height: var(--lh-relaxed);
  }

  .player-error-actions {
    display: flex;
    gap: var(--s-2);
  }

  .player-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-2) var(--s-5);
    border-radius: var(--r-full);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all var(--t-fast);
    border: 1px solid transparent;
  }
  .player-btn--primary {
    background: var(--accent);
    color: var(--accent-text);
    border-color: var(--accent);
  }
  .player-btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .player-noscript {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #ccc;
    text-align: center;
    padding: 1rem;
    font-size: 0.875rem;
    margin: 0;
  }
</style>

<script>
  interface PlayerAPI {
    load(url: string, label?: string): void;
    reload(): void;
    getCurrent(): string;
  }

  (function () {
    const wrapper = document.querySelector<HTMLElement>('[data-player]');
    const iframe = document.getElementById('player-iframe') as HTMLIFrameElement | null;
    if (!wrapper || !iframe) return;

    const loadingBox = wrapper.querySelector<HTMLElement>('[data-player-loading]');
    const loadingLabel = wrapper.querySelector<HTMLElement>('[data-loading-label]');
    const errorBox = wrapper.querySelector<HTMLElement>('[data-player-error]');
    const errorMsg = wrapper.querySelector<HTMLElement>('[data-error-msg]');
    const retryBtn = wrapper.querySelector<HTMLButtonElement>('[data-player-retry]');

    if (!loadingBox || !errorBox || !errorMsg || !retryBtn) return;

    const LOAD_TIMEOUT_MS = 15000;
    let currentUrl = '';
    let currentLabel = '';
    let timeoutId: number | null = null;
    let loadId = 0;

    function showLoading(label: string): void {
      loadingLabel!.textContent = label ? ` (${label})` : '';
      loadingBox!.hidden = false;
      errorBox!.hidden = true;
      iframe!.classList.remove('is-loaded');
    }

    function showError(msg: string): void {
      loadingBox!.hidden = true;
      errorBox!.hidden = false;
      errorMsg!.textContent = msg;
      iframe!.classList.remove('is-loaded');
    }

    function showLoaded(): void {
      loadingBox!.hidden = true;
      errorBox!.hidden = true;
      iframe!.classList.add('is-loaded');
    }

    function clearTimer(): void {
      if (timeoutId !== null) {
        window.clearTimeout(timeoutId);
        timeoutId = null;
      }
    }

    function load(url: string, label = ''): void {
      if (!url) {
        showError('URL player tidak valid.');
        return;
      }

      const id = ++loadId;
      currentUrl = url;
      currentLabel = label;

      clearTimer();
      showLoading(label);

      iframe!.src = url;

      timeoutId = window.setTimeout(() => {
        if (id !== loadId) return;
        const elapsed = Math.round(LOAD_TIMEOUT_MS / 1000);
        showError(`Server tidak selesai memuat setelah ${elapsed} detik. Coba server lain.`);
      }, LOAD_TIMEOUT_MS);
    }

    function reload(): void {
      if (currentUrl) load(currentUrl, currentLabel);
    }

    iframe.addEventListener('load', () => {
      clearTimer();
      if (!errorBox!.hidden) return;
      showLoaded();
    });

    iframe.addEventListener('error', () => {
      clearTimer();
      showError('Gagal memuat player. Coba server lain atau klik Coba Lagi.');
    });

    retryBtn.addEventListener('click', reload);

    (window as any).__qimochiPlayer = {
      load,
      reload,
      getCurrent: () => currentUrl,
    } satisfies PlayerAPI;

    const enc = iframe.dataset.enc;
    if (enc) {
      try {
        const bin = atob(enc);
        const bytes = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        const realSrc = new TextDecoder().decode(bytes);
        if (realSrc) load(realSrc, '');
      } catch (err) {
        console.error('[Player] decode failed:', err);
        showError('URL player tidak valid.');
      }
    }
  })();
</script>