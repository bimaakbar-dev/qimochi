---
import Icon from '~/user-components/Icons.astro';

interface Props {
  title: string;
  url?: string;
  class?: string;
}

const { title, url, class: className } = Astro.props;

const shareUrl = url ?? Astro.url.href;
---

<div class:list={['share-wrap', className]}>
  <button
    type="button"
    class="action-btn"
    data-share-btn
    data-title={title}
    data-url={shareUrl}
    aria-label="Bagikan"
    title="Bagikan"
  >
    <Icon name="share" size={28} />
    <span class="action-btn__label">Bagikan</span>
  </button>

  <span
    class="share-toast"
    data-share-toast
    role="status"
    aria-live="polite"
    hidden
  >
    Link disalin
  </span>
</div>

<script>
  (function () {
    function init(btn: HTMLButtonElement): void {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';

      const wrap = btn.closest<HTMLElement>('.share-wrap');
      const toast = wrap?.querySelector<HTMLElement>('[data-share-toast]') ?? null;
      let toastTimer: number | null = null;

      function showToast(): void {
        if (!toast) return;
        toast.hidden = false;
        if (toastTimer !== null) window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.hidden = true;
          toastTimer = null;
        }, 2000);
      }

      btn.addEventListener('click', async () => {
        const title = btn.dataset.title ?? document.title;
        const url = btn.dataset.url ?? location.href;

        if (typeof navigator.share === 'function') {
          try {
            await navigator.share({ title, url });
            return;
          } catch {}
        }

        try {
          await navigator.clipboard.writeText(url);
          showToast();
        } catch (err) {
          console.error('[share] copy failed', err);
        }
      });
    }

    document
      .querySelectorAll<HTMLButtonElement>('[data-share-btn]')
      .forEach(init);
  })();
</script>

<style>
  .share-wrap {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-3);
    width: 100%;
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: background var(--t-fast);
  }
  .action-btn:hover { background: var(--accent-soft); }
  .action-btn__label { line-height: 1; }

  .share-toast {
    position: absolute;
    top: calc(100% + var(--s-2));
    left: 50%;
    transform: translateX(-50%);
    padding: 4px var(--s-3);
    background: var(--text-primary);
    color: var(--bg-base);
    font-size: 0.6875rem;
    font-weight: var(--fw-medium);
    white-space: nowrap;
    border-radius: var(--r-sm);
    pointer-events: none;
    z-index: var(--z-overlay);
  }
  .share-toast[hidden] { display: none; }

  @media (min-width: 50rem) {
    .share-wrap { justify-content: flex-start; }
    .action-btn {
      flex-direction: row;
      width: auto;
      padding: var(--s-2) var(--s-3);
      gap: var(--s-2);
    }
  }
</style>
