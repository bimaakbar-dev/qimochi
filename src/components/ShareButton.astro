---
import Icon from '~/user-components/Icons.astro';

interface Props {
  title: string;
  url?: string;
  class?: string;
}

const { title, url, class: className } = Astro.props;

const shareUrl = url ?? Astro.url.href;
---

<div class:list={['share-wrap', className]}>
  <button
    type="button"
    class="icon-btn"
    data-share-btn
    data-title={title}
    data-url={shareUrl}
    aria-label="Bagikan"
    title="Bagikan"
  >
    <Icon name="share" size={20} />
  </button>

  <span
    class="share-toast"
    data-share-toast
    role="status"
    aria-live="polite"
    hidden
  >
    Link disalin
  </span>
</div>

<script>
  (function () {
    function init(btn: HTMLButtonElement): void {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';

      const wrap = btn.closest<HTMLElement>('.share-wrap');
      const toast = wrap?.querySelector<HTMLElement>('[data-share-toast]') ?? null;
      let toastTimer: number | null = null;

      function showToast(): void {
        if (!toast) return;
        toast.hidden = false;
        if (toastTimer !== null) window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.hidden = true;
          toastTimer = null;
        }, 2000);
      }

      btn.addEventListener('click', async () => {
        const t = btn.dataset.title ?? document.title;
        const u = btn.dataset.url ?? location.href;

        if (typeof navigator.share === 'function') {
          try {
            await navigator.share({ title: t, url: u });
            return;
          } catch {}
        }

        try {
          await navigator.clipboard.writeText(u);
          showToast();
        } catch (err) {
          console.error('[share] copy failed', err);
        }
      });
    }

    document
      .querySelectorAll<HTMLButtonElement>('[data-share-btn]')
      .forEach(init);
  })();
</script>

<style>
  .share-wrap {
    position: relative;
    display: inline-flex;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: transparent;
    color: var(--text-inverted);
    border: 1.5px solid hsla(0, 0%, 100%, 0.35);
    border-radius: var(--r-full);
    cursor: pointer;
    transition: color var(--t-fast), border-color var(--t-fast), background var(--t-fast);
  }

  .icon-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .icon-btn :global(svg) {
    display: block;
    width: 20px;
    height: 20px;
  }

  .share-toast {
    position: absolute;
    top: calc(100% + var(--s-2));
    left: 50%;
    transform: translateX(-50%);
    padding: 4px var(--s-3);
    background: var(--text-inverted);
    color: var(--bg-footer);
    font-size: 0.6875rem;
    font-weight: var(--fw-medium);
    white-space: nowrap;
    border-radius: var(--r-full);
    pointer-events: none;
    z-index: var(--z-overlay);
  }
  .share-toast[hidden] { display: none; }
</style>