---
import Badge from '~/user-components/Badge.astro';
import { postUrl, formatDateShort } from '~/lib/blog';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      cover?: string;
      date: Date;
      category: string;
      tags: string[];
    };
  };
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { id, data } = post;

const dateText = formatDateShort(data.date);
---

<article class:list={['post-card', { 'post-card-featured': featured }]}>
  <a href={postUrl(id)} class="post-card-link">
    <div class="cover">
      {data.cover ? (
        <img
          src={data.cover}
          alt={`Cover ${data.title}`}
          width="800"
          height={featured ? 533 : 450}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="cover-fallback" aria-hidden="true">
          <span>{data.category}</span>
        </div>
      )}
    </div>

    <div class="body">
      <time class="date" datetime={data.date.toISOString()}>
        {dateText}
      </time>

      <div class="content">
        <Badge variant="accent" size="sm">{data.category}</Badge>
        <h3 class="title">{data.title}</h3>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    display: block;
    min-width: 0;
  }

  .post-card-link {
    display: block;
    min-width: 0;
    height: 100%;
    background: var(--bg-elevated);
    border: 1px solid transparent;
    overflow: hidden;
    transition: transform var(--t-fast), background var(--t-fast);
  }

  .post-card-link:hover {
    background: var(--bg-surface);
    transform: translateY(-2px);
  }

  /* ----------------------------------------------------------
     COVER — default 16:9, featured 3:2
     ---------------------------------------------------------- */
  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .post-card-featured .cover {
    aspect-ratio: 3 / 2;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--t-base);
  }

  .post-card-link:hover .cover img {
    transform: scale(1.03);
  }

  .cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ----------------------------------------------------------
     BODY — grid: tanggal | konten
     ---------------------------------------------------------- */
  .body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    padding: var(--s-3);
    align-items: stretch;
    min-width: 0;
  }

  /* Featured: padding lebih besar */
  .post-card-featured .body {
    padding: var(--s-4);
    gap: var(--s-4);
  }

  /* ----------------------------------------------------------
     DATE
     ---------------------------------------------------------- */
  .date {
    writing-mode: vertical-rl;
    transform: rotate(180deg);

    display: inline-flex;
    align-items: center;
    justify-content: center;

    background: none;
    border: none;
    padding: 0;

    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ----------------------------------------------------------
     CONTENT
     ---------------------------------------------------------- */
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
    align-items: flex-start;
    justify-content: center;
  }

  .title {
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
    line-height: var(--lh-snug);
    margin: 0;
    min-width: 0;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  /* Featured: title lebih besar, bisa 4 baris */
  .post-card-featured .title {
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    -webkit-line-clamp: 4;
  }

  .post-card-link:hover .title {
    color: var(--accent);
  }
</style>