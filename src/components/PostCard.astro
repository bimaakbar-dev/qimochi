---
import LinkCard from '~/user-components/LinkCard.astro';
import Badge from '~/user-components/Badge.astro';
import { postUrl, formatDateShort } from '~/lib/blog';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      cover?: string;
      date: Date;
      category: string;
      tags: string[];
    };
  };
}

const { post } = Astro.props;
const { id, data } = post;

const dateText = formatDateShort(data.date);
---

<LinkCard href={postUrl(id)} class="post-card">
  <div class="cover">
    {data.cover ? (
      <img
        src={data.cover}
        alt={`Cover ${data.title}`}
        width="400"
        height="225"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="cover-fallback" aria-hidden="true">
        <span>{data.category}</span>
      </div>
    )}
  </div>

  <div class="body">
    <time class="date" datetime={data.date.toISOString()}>
      {dateText}
    </time>

    <div class="content">
      <Badge variant="accent" size="sm">{data.category}</Badge>
      <h3 class="title">{data.title}</h3>
    </div>
  </div>
</LinkCard>

<style>
  .post-card {
    min-width: 0;
    background: var(--bg-elevated);
  }

  /* ----------------------------------------------------------
     COVER
     ---------------------------------------------------------- */
  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--t-base);
  }

  .post-card:hover .cover img {
    transform: scale(1.03);
  }

  .cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ----------------------------------------------------------
     BODY — grid: tanggal | konten
     ---------------------------------------------------------- */
  .body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    padding: var(--s-3);
    align-items: stretch;
    min-width: 0;
  }

  /* ----------------------------------------------------------
     DATE — vertical, minimal
     ---------------------------------------------------------- */
  .date {
    writing-mode: vertical-rl;
    transform: rotate(180deg);

    display: inline-flex;
    align-items: center;
    justify-content: center;

    /* Hapus bg, border, padding */
    background: none;
    border: none;
    padding: 0;

    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ----------------------------------------------------------
     CONTENT — badge + title
     ---------------------------------------------------------- */
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
    align-items: flex-start;   /* ← badge tidak full width */
  }

  .title {
    font-size: var(--fs-base);   /* ← naik dari fs-sm */
    font-weight: var(--fw-medium);
    color: var(--text-primary);
    line-height: var(--lh-snug);
    margin: 0;
    min-width: 0;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .post-card:hover .title {
    color: var(--accent);
  }
</style>