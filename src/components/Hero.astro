---
interface Props {
  title: string;
  description?: string;
  size?: 'md' | 'lg';
  eyebrow?: string;
  align?: 'start' | 'center';
}

const {
  title,
  description,
  size = 'md',
  eyebrow,
  align = 'start',
} = Astro.props;
---

<header class:list={['hero', `hero-${size}`, `hero-${align}`]}>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-inner">
    {eyebrow && <span class="hero-eyebrow">{eyebrow}</span>}
    <h1 class="hero-title">{title}</h1>
    {description && <p class="hero-desc">{description}</p>}
    <slot />
  </div>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;

    background: var(--bg-footer);
    box-shadow: 0 0 0 100vmax var(--bg-footer);
    clip-path: inset(0 -100vmax);

    margin-block-start: calc(var(--s-6) * -1);
    margin-block-end: var(--s-4);
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        60% 80% at 15% 0%,
        color-mix(in oklab, var(--text-inverted) 10%, transparent),
        transparent 70%
      ),
      radial-gradient(
        50% 70% at 100% 100%,
        color-mix(in oklab, var(--text-inverted) 5%, transparent),
        transparent 70%
      );
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-block: var(--s-8);
  }

  .hero-center .hero-inner {
    align-items: center;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 0.25em 0.75em;
    font-family: var(--font-montserrat);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-inverted);
    background: color-mix(in oklab, var(--text-inverted) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--text-inverted) 22%, transparent);
    border-radius: var(--r-full);
  }

  .hero-center .hero-eyebrow {
    align-self: center;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-montserrat);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    color: var(--text-inverted);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .hero-md .hero-title { font-size: var(--fs-3xl); }
  .hero-lg .hero-title { font-size: var(--fs-4xl); }

  .hero-desc {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: var(--text-inverted);
    opacity: 0.75;
    max-width: 60ch;
    text-wrap: pretty;
  }
  .hero-inner > :global(*:last-child:not(:first-child)) {
    margin-block-start: var(--s-2);
  }

  @media (min-width: 50rem) {
    .hero-inner {
      padding-block: var(--s-10);
    }

    .hero-lg .hero-inner {
      padding-block: var(--s-12);
    }

    .hero-lg .hero-title {
      font-size: var(--fs-5xl);
    }
  }
</style>
