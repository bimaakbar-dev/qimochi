---
import Icons from "~/user-components/Icons.astro";
import Button from "~/user-components/Button.astro";

const clientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ?? '';
const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.qimochi.web.id';
const dialogId = 'qimochi-user-dialog';
---

<div
  class="user-menu"
  data-user-menu
  data-clientid={clientId}
  data-api={apiBase}
  data-dialog-id={dialogId}
>
  <button
    type="button"
    class="user-trigger"
    data-trigger
    aria-haspopup="dialog"
    aria-label="Akun"
  >
    <span class="user-trigger-guest" data-guest>
      <Icons name="user" size={16} />
    </span>
    <img class="user-trigger-avatar" data-avatar alt="" width="28" height="28" hidden />
  </button>
</div>

<dialog
  class="user-dialog"
  id={dialogId}
  data-user-dialog
  aria-labelledby={`${dialogId}-title`}
>
  <div class="user-dialog__inner">
    <header class="user-dialog__header">
      <h2 class="user-dialog__title" id={`${dialogId}-title`} data-dialog-title>Masuk</h2>
      <button
        type="button"
        class="user-dialog__close"
        data-dialog-close
        aria-label="Tutup"
      >
        <Icons name="close" size={16} />
      </button>
    </header>

    <div class="user-dialog__body">
      <div class="user-dialog__guest" data-guest-view>
        <p class="user-dialog__hint">
          Masuk dengan Google untuk menyimpan bookmark, memberi rating,
          dan ikut berkomentar.
        </p>
        <div class="user-dialog__gsi" data-gsi></div>
      </div>

      <div class="user-dialog__profile" data-profile hidden>
        <div class="user-dialog__profile-head">
          <img data-info-avatar alt="" width="56" height="56" />
          <div class="user-dialog__profile-meta">
            <strong data-info-name></strong>
            <span data-info-email></span>
          </div>
        </div>

        <nav class="user-dialog__menu" aria-label="Menu akun">
          <a href="/anime/bookmark/" class="user-dialog__menu-item">
            <span class="user-dialog__menu-icon" aria-hidden="true">
              <Icons name="bookmark" size={18} />
            </span>
            <span class="user-dialog__menu-label">Daftar Saya</span>
            <span class="user-dialog__menu-arrow" aria-hidden="true">
              <Icons name="arrow-right" size={14} />
            </span>
          </a>

          <a href="/anime/bookmark/?tab=history" class="user-dialog__menu-item">
            <span class="user-dialog__menu-icon" aria-hidden="true">
              <Icons name="history" size={18} />
            </span>
            <span class="user-dialog__menu-label">Riwayat</span>
            <span class="user-dialog__menu-arrow" aria-hidden="true">
              <Icons name="arrow-right" size={14} />
            </span>
          </a>

          <a
            href="https://github.com/bimaakbar-dev/yukio-data"
            class="user-dialog__menu-item"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="user-dialog__menu-icon" aria-hidden="true">
              <Icons name="external" size={18} />
            </span>
            <span class="user-dialog__menu-label">Kontribusi Data</span>
            <span class="user-dialog__menu-arrow" aria-hidden="true">
              <Icons name="external" size={14} />
            </span>
          </a>
        </nav>

        <Button
          type="button"
          variant="outline"
          size="md"
          block
          data-logout
        >
          Keluar
        </Button>
      </div>
    </div>
  </div>
</dialog>

<style>
  .user-menu {
    display: inline-flex;
    align-items: center;
  }

  .user-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-inverted);
    cursor: pointer;
    transition: color var(--t-fast);
  }

  .user-trigger:hover {
    color: var(--accent);
  }

  .user-trigger-guest,
  .user-trigger-avatar {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: var(--r-full);
    border: 1px solid var(--border);
    object-fit: cover;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .user-trigger-guest {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-nav);
    color: var(--text-inverted);
  }

  .user-trigger-guest[hidden],
  .user-trigger-avatar[hidden] {
    display: none;
  }

  .user-dialog {
    width: 24rem;
    max-width: calc(100vw - 2rem);
    padding: 0;
    background: var(--bg-elevated);
    color: var(--text-primary);
    box-shadow: var(--shadow-lg);
    margin: auto;
    border-radius: var(--r-lg);
  }

  .user-dialog::backdrop {
    background: hsla(0, 0%, 0%, 0.6);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .user-dialog[open] {
    animation: user-dialog-in 0.18s ease-out;
  }

  .user-dialog[open]::backdrop {
    animation: user-backdrop-in 0.18s ease-out;
  }

  @keyframes user-dialog-in {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes user-backdrop-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .user-dialog[open],
    .user-dialog[open]::backdrop {
      animation: none;
    }
  }

  .user-dialog__inner {
    display: flex;
    flex-direction: column;
  }

  .user-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
  }

  .user-dialog__title {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .user-dialog__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--t-fast), background var(--t-fast);
  }

  .user-dialog__close:hover {
    color: var(--text-primary);
    background: var(--bg-surface);
  }

  .user-dialog__body {
    padding: var(--s-5) var(--s-4);
    display: flex;
    flex-direction: column;
  }

  .user-dialog__guest {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .user-dialog__guest[hidden] {
    display: none;
  }

  .user-dialog__hint {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: var(--text-secondary);
    text-align: center;
  }

  .user-dialog__gsi {
    display: flex;
    justify-content: center;
    min-height: 44px;
    align-items: center;
  }

  .user-dialog__gsi:empty::before {
    content: 'Memuat tombol login...';
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .user-dialog__profile {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .user-dialog__profile[hidden] {
    display: none;
  }

  .user-dialog__profile-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-width: 0;
  }

  .user-dialog__profile-head img {
    width: 56px;
    height: 56px;
    border-radius: var(--r-full);
    object-fit: cover;
    flex-shrink: 0;
    background: var(--bg-surface);
  }

  .user-dialog__profile-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .user-dialog__profile-meta strong {
    font-size: var(--fs-base);
    color: var(--text-primary);
    font-weight: var(--fw-semibold);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .user-dialog__profile-meta span {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .user-dialog__menu {
    display: flex;
    flex-direction: column;
    margin: 0 calc(var(--s-4) * -1);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .user-dialog__menu-item {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    color: var(--text-primary);
    text-decoration: none;
    transition: background var(--t-fast), color var(--t-fast);
    border-bottom: 1px solid var(--border);
  }

  .user-dialog__menu-item:last-child {
    border-bottom: none;
  }

  .user-dialog__menu-item:hover {
    background: var(--bg-surface);
    color: var(--accent);
  }

  .user-dialog__menu-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--text-muted);
    transition: color var(--t-fast);
  }

  .user-dialog__menu-item:hover .user-dialog__menu-icon {
    color: var(--accent);
  }

  .user-dialog__menu-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .user-dialog__menu-label {
    flex: 1;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .user-dialog__menu-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform var(--t-fast), color var(--t-fast);
  }

  .user-dialog__menu-item:hover .user-dialog__menu-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  .user-dialog__menu-arrow :global(svg) {
    display: block;
  }

  /* ==== Mobile: full screen ==== */
  @media (max-width: 50rem) {
    .user-dialog {
      width: 100%;
      max-width: 100%;
      height: 100vh;
      height: 100dvh;
      max-height: 100vh;
      max-height: 100dvh;
      margin: 0;
      border-radius: 0;
    }

    .user-dialog__inner {
      height: 100%;
      overflow-y: auto;
    }

    .user-dialog__header {
      position: sticky;
      top: 0;
      z-index: 1;
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
    }

    .user-dialog__body {
      flex: 1;
      padding: var(--s-4);
    }
  }
</style>

<script>
  interface AuthUser {
    sub: string;
    name: string;
    email: string;
    picture: string | null;
  }

  (function () {
    const CACHE_KEY = 'qimochi:user-cache';

    const rootEl = document.querySelector<HTMLElement>('[data-user-menu]');
    if (!rootEl) return;
    const root: HTMLElement = rootEl;

    const CLIENT_ID = root.dataset.clientid || '';
    const API = (root.dataset.api || '').replace(/\/$/, '');
    const DIALOG_ID = root.dataset.dialogId || '';

    const dialogEl = DIALOG_ID
      ? (document.getElementById(DIALOG_ID) as HTMLDialogElement | null)
      : null;
    if (!dialogEl) return;
    const dialog: HTMLDialogElement = dialogEl;

    const triggerEl = root.querySelector<HTMLButtonElement>('[data-trigger]');
    const guestIconEl = root.querySelector<HTMLElement>('[data-guest]');
    const triggerAvatarEl = root.querySelector<HTMLImageElement>('[data-avatar]');

    const dialogCloseEl = dialog.querySelector<HTMLButtonElement>('[data-dialog-close]');
    const dialogTitleEl = dialog.querySelector<HTMLElement>('[data-dialog-title]');
    const guestViewEl = dialog.querySelector<HTMLElement>('[data-guest-view]');
    const gsiSlotEl = dialog.querySelector<HTMLElement>('[data-gsi]');
    const profileBoxEl = dialog.querySelector<HTMLElement>('[data-profile]');
    const infoAvatarEl = dialog.querySelector<HTMLImageElement>('[data-info-avatar]');
    const infoNameEl = dialog.querySelector<HTMLElement>('[data-info-name]');
    const infoEmailEl = dialog.querySelector<HTMLElement>('[data-info-email]');
    const logoutBtnEl = dialog.querySelector<HTMLButtonElement>('[data-logout]');

    if (
      !triggerEl || !guestIconEl || !triggerAvatarEl ||
      !dialogCloseEl || !dialogTitleEl || !guestViewEl || !gsiSlotEl ||
      !profileBoxEl || !infoAvatarEl || !infoNameEl || !infoEmailEl || !logoutBtnEl
    ) {
      return;
    }

    const trigger: HTMLButtonElement = triggerEl;
    const guestIcon: HTMLElement = guestIconEl;
    const triggerAvatar: HTMLImageElement = triggerAvatarEl;
    const dialogClose: HTMLButtonElement = dialogCloseEl;
    const dialogTitle: HTMLElement = dialogTitleEl;
    const guestView: HTMLElement = guestViewEl;
    const gsiSlot: HTMLElement = gsiSlotEl;
    const profileBox: HTMLElement = profileBoxEl;
    const infoAvatar: HTMLImageElement = infoAvatarEl;
    const infoName: HTMLElement = infoNameEl;
    const infoEmail: HTMLElement = infoEmailEl;
    const logoutBtn: HTMLButtonElement = logoutBtnEl;

    let currentUser: AuthUser | null = null;
    let gsiRendered = false;

    function readCache(): AuthUser | null {
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<AuthUser> | null;
        if (parsed && typeof parsed.sub === 'string' && typeof parsed.name === 'string') {
          return {
            sub: parsed.sub,
            name: parsed.name,
            email: typeof parsed.email === 'string' ? parsed.email : '',
            picture: typeof parsed.picture === 'string' ? parsed.picture : null,
          };
        }
      } catch {}
      return null;
    }

    function writeCache(user: AuthUser | null): void {
      try {
        if (user) localStorage.setItem(CACHE_KEY, JSON.stringify(user));
        else localStorage.removeItem(CACHE_KEY);
      } catch {}
    }

    function loadScript(src: string): Promise<void> {
      return new Promise((resolve, reject) => {
        const existing = document.querySelector<HTMLScriptElement>(`script[src="${src}"]`);
        if (existing) {
          if (existing.dataset.loaded === '1') return resolve();
          existing.addEventListener('load', () => resolve(), { once: true });
          existing.addEventListener('error', () => reject(), { once: true });
          return;
        }
        const s = document.createElement('script');
        s.src = src;
        s.async = true;
        s.defer = true;
        s.addEventListener('load', () => { s.dataset.loaded = '1'; resolve(); }, { once: true });
        s.addEventListener('error', () => reject(), { once: true });
        document.head.appendChild(s);
      });
    }

    function dispatchAuthChanged(): void {
      document.dispatchEvent(
        new CustomEvent('qimochi:auth-changed', { detail: { user: currentUser } })
      );
    }

    function applyUser(): void {
      if (currentUser) {
        guestIcon.hidden = true;
        triggerAvatar.hidden = false;
        if (currentUser.picture) {
          triggerAvatar.src = currentUser.picture;
          triggerAvatar.alt = currentUser.name;
        } else {
          triggerAvatar.removeAttribute('src');
        }

        dialogTitle.textContent = 'Akun Saya';
        guestView.hidden = true;
        profileBox.hidden = false;

        if (currentUser.picture) {
          infoAvatar.src = currentUser.picture;
        } else {
          infoAvatar.removeAttribute('src');
        }
        infoAvatar.alt = currentUser.name;
        infoName.textContent = currentUser.name;
        infoEmail.textContent = currentUser.email;
      } else {
        guestIcon.hidden = false;
        triggerAvatar.hidden = true;
        triggerAvatar.removeAttribute('src');

        dialogTitle.textContent = 'Masuk';
        guestView.hidden = false;
        profileBox.hidden = true;
        ensureGsi();
      }
    }

    function ensureGsi(): void {
      if (gsiRendered) return;
      if (!CLIENT_ID) return;
      const g = (window as any).google;
      if (!g?.accounts?.id) return;

      try {
        gsiSlot.innerHTML = '';
        g.accounts.id.renderButton(gsiSlot, {
          theme: 'outline',
          size: 'large',
          text: 'signin_with',
          shape: 'rect',
          logo_alignment: 'left',
          width: 280,
        });
        gsiRendered = true;
      } catch (err) {
        console.error('[usermenu] render gsi failed', err);
      }
    }

    function lockBodyScroll(): void {
      document.body.style.overflow = 'hidden';
    }

    function unlockBodyScroll(): void {
      document.body.style.overflow = '';
    }

    function openDialog(): void {
      if (dialog.open) return;
      dialog.showModal();
      lockBodyScroll();
      if (!currentUser) ensureGsi();
    }

    function closeDialog(): void {
      if (dialog.open) dialog.close();
    }
    
    dialog.addEventListener('close', unlockBodyScroll);
    dialog.addEventListener('cancel', unlockBodyScroll);

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      openDialog();
    });

    dialogClose.addEventListener('click', closeDialog);

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });

    async function handleCredential(response: { credential: string }): Promise<void> {
      try {
        const res = await fetch(`${API}/api/v1/auth/google`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ credential: response.credential }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const json = (await res.json()) as { ok: boolean; user: AuthUser };
        if (json.ok && json.user) {
          currentUser = json.user;
          writeCache(json.user);
          applyUser();
          closeDialog();
          dispatchAuthChanged();
        }
      } catch (err) {
        console.error('[usermenu] login failed', err);
      }
    }

    logoutBtn.addEventListener('click', async () => {
      try {
        await fetch(`${API}/api/v1/auth/logout`, {
          method: 'POST',
          credentials: 'include',
        });
      } catch {}
      currentUser = null;
      gsiRendered = false;
      writeCache(null);
      applyUser();
      closeDialog();
      dispatchAuthChanged();
    });

    async function fetchMe(): Promise<void> {
      try {
        const res = await fetch(`${API}/api/v1/auth/me`, { credentials: 'include' });
        if (!res.ok) return;
        const json = (await res.json()) as { ok: boolean; user: AuthUser | null };
        const user = json.ok && json.user ? json.user : null;
        const same = (user?.sub ?? null) === (currentUser?.sub ?? null);
        if (same) return;
        currentUser = user;
        writeCache(user);
        applyUser();
        dispatchAuthChanged();
      } catch {
        // biarkan state dari cache
      }
    }

    function onExternalChange(e: Event): void {
      const detail = (e as CustomEvent<{ user: AuthUser | null }>).detail;
      if (!detail) return;
      const sameUser = (detail.user?.sub ?? null) === (currentUser?.sub ?? null);
      if (sameUser) return;
      currentUser = detail.user;
      writeCache(detail.user);
      applyUser();
    }

    document.addEventListener('qimochi:auth-changed', onExternalChange);

    (function bootstrap(): void {
      currentUser = readCache();
      applyUser();
      if (currentUser) dispatchAuthChanged();
    })();

    (async () => {
      if (CLIENT_ID) {
        try {
          await loadScript('https://accounts.google.com/gsi/client');
          const g = (window as any).google;
          if (g?.accounts?.id) {
            g.accounts.id.initialize({
              client_id: CLIENT_ID,
              callback: handleCredential,
              auto_select: false,
              cancel_on_tap_outside: true,
            });
            document.dispatchEvent(new CustomEvent('qimochi:gsi-ready'));
          }
        } catch (err) {
          console.error('[usermenu] gsi load failed', err);
        }
      }

      await fetchMe();
    })();

    (window as any).__qimochiUserMenu = {
      getUser: () => currentUser,
      open: () => openDialog(),
      close: () => closeDialog(),
    };
  })();
</script>