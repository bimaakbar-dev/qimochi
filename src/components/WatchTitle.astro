---
interface Props {
  title: string;
  episodeNumber: number;
}

const { title, episodeNumber } = Astro.props;
---

<header class="watch-title">
  <h1>
    {title}
    <span class="badge">Ep {episodeNumber}</span>
  </h1>
</header>

<style>
  .watch-title h1 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    margin: 0;
  }

  .badge {
    display: inline-block;
    padding: var(--s-1) var(--s-3);
    background: var(--accent);
    color: var(--accent-text);
    border-radius: var(--r-sm);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.3px;
    white-space: nowrap;
  }
</style>