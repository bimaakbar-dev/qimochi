---
import Badge from '../user-components/Badge.astro';

interface Props {
  title: string;
  episodeNumber: number;
}

const { title, episodeNumber } = Astro.props;
---

<header class="watch-title">
  <h1>
    {title}
    <Badge variant="accent" size="sm">Ep {episodeNumber}</Badge>
  </h1>
</header>

<style>
  .watch-title h1 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    margin: 0;
    color: var(--text-primary);
  }
</style>