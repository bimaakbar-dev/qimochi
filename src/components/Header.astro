---
import { SITE, NAV_LINKS } from '../constants';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-text">{SITE.name}</span>
    </a>

    <details class="menu" open>
      <summary class="menu-btn" aria-label="Menu navigasi">
        <svg class="icon icon-menu" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M3 6h16M3 11h16M3 16h16" />
        </svg>
        <svg class="icon icon-close" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M5 5l12 12M17 5L5 17" />
        </svg>
      </summary>

      <nav class="nav" aria-label="Navigasi utama">
        {NAV_LINKS.map(({ label, href }) => (
          <a
            href={href}
            class:list={['nav-link', { active: isActive(href) }]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  if (menu) {
    const mobile = window.matchMedia('(max-width: 55.99rem)');

    if (mobile.matches) menu.removeAttribute('open');

    mobile.addEventListener('change', (e) => {
      if (e.matches) {
        menu.removeAttribute('open');
      } else {
        menu.setAttribute('open', '');
      }
    });

    document.addEventListener('click', (e) => {
      if (!mobile.matches) return;
      if (!menu.hasAttribute('open')) return;
      if (!menu.contains(e.target as Node)) {
        menu.removeAttribute('open');
      }
    });

    menu.querySelectorAll('.nav-link').forEach((a) => {
      a.addEventListener('click', () => {
        if (mobile.matches) menu.removeAttribute('open');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobile.matches && menu.hasAttribute('open')) {
        menu.removeAttribute('open');
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--bg-nav);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    height: var(--header-height);
    max-width: var(--content-max-mobile);
    margin-inline: auto;
    padding-inline: var(--pad-x);
  }

  @media (min-width: 56rem) {
    .header-inner {
      max-width: var(--content-max-desktop);
    }
  }

  /* ---------- LOGO ---------- */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    color: var(--text-inverted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color var(--t-fast);
  }

  .logo:hover {
    color: var(--accent);
  }

  .logo-mark {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 60%, 60% 100%, 0 100%);
  }

  /* ---------- MENU ---------- */
  .menu {
    display: flex;
    align-items: center;
  }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--text-inverted);
    cursor: pointer;
    list-style: none;
    transition: color var(--t-fast);
  }

  .menu-btn::-webkit-details-marker {
    display: none;
  }

  .menu-btn:hover {
    color: var(--accent);
  }

  .menu-btn .icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .menu-btn .icon-close {
    display: none;
  }

  .menu[open] .menu-btn .icon-menu {
    display: none;
  }
  .menu[open] .menu-btn .icon-close {
    display: block;
  }

  /* ---------- NAV ---------- */
  .nav {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }

  .nav-link {
    position: relative;
    padding: var(--s-2) var(--s-3);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-inverted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--t-fast);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.active {
    color: var(--accent);
  }

  /* ---------- MOBILE ---------- */
  @media (max-width: 55.999rem) {
    .menu {
      display: block;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-1);
      padding: var(--s-3) var(--pad-x) var(--s-4);
      background: var(--bg-nav);
    }

    .nav-link {
      position: relative;
      padding: var(--s-3) var(--s-4);
      font-size: var(--fs-base);
      text-transform: none;
      letter-spacing: normal;
      border-radius: var(--r-sm);
    }

    .nav-link:hover {
      background: var(--bg-hover);
    }

    .nav-link.active {
      background: var(--accent-soft);
    }

    .nav-link.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      width: 3px;
      height: 55%;
      transform: translateY(-50%);
      background: var(--accent);
    }
  }

  /* ---------- DESKTOP ---------- */
  @media (min-width: 56rem) {
    .menu-btn {
      display: none;
    }

    .nav-link::after {
      content: '';
      position: absolute;
      left: var(--s-3);
      right: var(--s-3);
      bottom: 2px;
      height: 2px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--t-base);
    }

    .nav-link:hover::after,
    .nav-link.active::after {
      transform: scaleX(1);
    }
  }
</style>