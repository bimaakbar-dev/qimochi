---
import Icon from '~/user-components/Icons.astro';

interface Server { name: string; url: string; }
interface Stream { quality: string; servers: Server[]; }

interface Props { streams?: Stream[]; }

const { streams = [] } = Astro.props;
const defaultStream = streams[0];
const totalServers = streams.reduce((sum, s) => sum + s.servers.length, 0);

function encodeUrl(s: string): string {
  if (!s) return '';
  const bytes = new TextEncoder().encode(s);
  let bin = '';
  for (const b of bytes) bin += String.fromCharCode(b);
  return btoa(bin);
}

function formatCurrent(): string {
  if (!defaultStream) return '—';
  const count = totalServers > 0 ? ` · ${totalServers} server` : '';
  return `${defaultStream.quality} · Server 1${count}`;
}
---

<div class="stream-selector-root" data-stream-selector>
  <details class="stream-picker" data-stream-picker>
    <summary>
      <span class="label">Server &amp; Kualitas</span>
      <span class="current" data-current>{formatCurrent()}</span>
      <span class="chevron" aria-hidden="true">
        <Icon name="chevron-down" size={16} />
      </span>
    </summary>

    <div class="stream-body" data-stream-body>
      {streams.map((s, i) => (
        <div class="quality-group">
          <span class="quality-label">{s.quality}</span>
          <div class="chips">
            {s.servers.map((srv, j) => {
              const id = `s-${i}-${j}`;
              const isDefault = i === 0 && j === 0;
              const label = `Server ${j + 1}`;
              return (
                <>
                  <input
                    type="radio"
                    name="stream"
                    id={id}
                    data-enc={encodeUrl(srv.url)}
                    data-quality={s.quality}
                    data-server={label}
                    checked={isDefault}
                    hidden
                  />
                  <label for={id} class="chip">{label}</label>
                </>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </details>
</div>

<style is:global>
  .stream-selector-root { display: block; }

  .stream-picker {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
  }

  .stream-picker summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-4);
    cursor: pointer;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    list-style: none;
    user-select: none;
  }
  .stream-picker summary::-webkit-details-marker { display: none; }

  .stream-picker summary .current {
    margin-left: auto;
    padding: var(--s-1) var(--s-3);
    background: var(--bg-surface);
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .stream-picker summary .chevron {
    display: inline-flex;
    align-items: center;
    color: var(--text-muted);
    transition: transform var(--t-base);
  }

  .stream-picker[open] summary .chevron { transform: rotate(180deg); }

  .stream-body {
    padding: 0 var(--s-4) var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .quality-group {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .quality-label {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--fw-semibold);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .chip {
    display: inline-block;
    padding: var(--s-1) var(--s-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--t-fast);
  }
  .chip:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .stream-picker input[type='radio']:checked + .chip {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .stream-empty {
    padding: var(--s-4);
    text-align: center;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
</style>

<script>
  interface Server { name: string; url: string; }
  interface Stream { quality: string; servers: Server[]; }

  function encodeUrl(s: string): string {
    if (!s) return '';
    const bytes = new TextEncoder().encode(s);
    let bin = '';
    for (const b of bytes) bin += String.fromCharCode(b);
    return btoa(bin);
  }

  function escapeAttr(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function buildHtml(streams: Stream[]): string {
    if (!streams || streams.length === 0) {
      return '<div class="stream-empty">Belum ada server untuk episode ini.</div>';
    }

    return streams
      .map((s, i) => {
        const chips = s.servers
          .map((srv, j) => {
            const id = `s-${i}-${j}`;
            const enc = escapeAttr(encodeUrl(srv.url));
            const quality = escapeAttr(s.quality);
            const server = `Server ${j + 1}`;
            const checked = i === 0 && j === 0 ? 'checked' : '';
            return `<input type="radio" name="stream" id="${id}" data-enc="${enc}" data-quality="${quality}" data-server="${server}" ${checked} hidden /><label for="${id}" class="chip">${server}</label>`;
          })
          .join('');
        return `<div class="quality-group"><span class="quality-label">${escapeHtml(s.quality)}</span><div class="chips">${chips}</div></div>`;
      })
      .join('');
  }

  function formatCurrentLabel(streams: Stream[]): string {
    const first = streams?.[0];
    if (!first) return '—';
    const total = streams.reduce((sum, s) => sum + s.servers.length, 0);
    const count = total > 0 ? ` · ${total} server` : '';
    return `${first.quality} · Server 1${count}`;
  }

  function mount(root: HTMLElement, streams: Stream[]): void {
    const details = root.querySelector<HTMLDetailsElement>('[data-stream-picker]');
    const body = root.querySelector<HTMLElement>('[data-stream-body]');
    const current = root.querySelector<HTMLElement>('[data-current]');
    if (!details || !body || !current) return;

    current.textContent = formatCurrentLabel(streams ?? []);
    body.innerHTML = buildHtml(streams ?? []);

    const firstRadio = body.querySelector<HTMLInputElement>('input[name="stream"]');
    if (firstRadio) firstRadio.checked = true;

    // Tidak auto-open — default closed
    details.open = false;
  }

  document.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement | null;
    if (!target || target.name !== 'stream' || !target.checked) return;

    const enc = target.dataset.enc;
    if (!enc) return;

    let real = '';
    try {
      const bin = atob(enc);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      real = new TextDecoder().decode(bytes);
    } catch { return; }

    const quality = target.dataset.quality ?? '';
    const server = target.dataset.server ?? '';
    const label = quality && server ? `${quality} · ${server}` : '';

    const player = (window as any).__qimochiPlayer;
    if (player?.load) {
      player.load(real, label);
    } else {
      const iframe = document.getElementById('player-iframe') as HTMLIFrameElement | null;
      if (iframe) iframe.src = real;
    }

    const root = target.closest('[data-stream-selector]');
    const current = root?.querySelector<HTMLElement>('[data-current]');
    if (current) {
      // Hitung total server dari semua radio yang ada di root
      const all = root?.querySelectorAll('input[name="stream"]');
      const total = all ? all.length : 0;
      const count = total > 0 ? ` · ${total} server` : '';
      current.textContent = `${quality} · ${server}${count}`;
    }
  });

  (window as any).__qimochiStream = { mount };
</script>