---
import { SITE, NAV_LINKS } from '~/constants';
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo/logo.png';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="logo" aria-label={`${SITE.name} — Home`}>
        <Image
          src={logoImg}
          alt={SITE.name}
          width={64}
          height={64}
          loading="lazy"
          fetchpriority="low"
          decoding="async"
          class="logo-img"
        />
      </a>
    </div>
    <nav class="footer-nav" aria-label="Navigasi footer">
      <h2 class="footer-heading">Jelajahi</h2>
      <ul>
        {NAV_LINKS.map(({ label, href }) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-nav" aria-label="Legal">
      <h2 class="footer-heading">Legal</h2>
      <ul>
        <li><a href="/dmca/">DMCA</a></li>
        <li><a href="/disclaimer/">Disclaimer</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer-disclaimer">
    <div class="footer-disclaimer-inner">
      <h2 class="footer-heading">Disclaimer</h2>
      <p>
        {SITE.name} tidak menyimpan file video apapun di server kami.
        Semua konten video di-embed dari layanan pihak ketiga yang tersedia
        secara publik di internet. Kami hanya menyediakan tautan untuk
        keperluan referensi dan tidak bertanggung jawab atas konten
        yang di-host oleh pihak ketiga.
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="copyright">
        &copy; {year} {SITE.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-footer);
    margin-top: var(--s-16);
  }

  .footer-inner {
    max-width: var(--content-max-mobile);
    margin-inline: auto;
    padding: var(--s-8) var(--pad-x);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  @media (min-width: 50rem) {
    .footer-inner {
      max-width: var(--content-max-desktop);
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--s-8);
    }
  }

  .footer-brand {
    display: flex;
    align-items: start;
  }

  .footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .footer-nav a {
    font-size: var(--fs-sm);
    color: var(--text-inverted);
    transition: color var(--t-fast);
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  .footer-heading {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 var(--s-3);
  }

  .footer-disclaimer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-disclaimer-inner {
    max-width: var(--content-max-mobile);
    margin-inline: auto;
    padding: var(--s-6) var(--pad-x);
  }

  @media (min-width: 50rem) {
    .footer-disclaimer-inner {
      max-width: var(--content-max-desktop);
    }
  }

  .footer-disclaimer p {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: var(--lh-relaxed);
    margin: 0 0 var(--s-3);
  }

  .footer-disclaimer p:last-child {
    margin-bottom: 0;
  }

  .footer-disclaimer a {
    color: var(--accent);
    transition: color var(--t-fast);
  }

  .footer-disclaimer a:hover {
    color: var(--accent-hover);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-bottom-inner {
    max-width: var(--content-max-mobile);
    margin-inline: auto;
    padding: var(--s-4) var(--pad-x);
    text-align: center;
  }

  @media (min-width: 50rem) {
    .footer-bottom-inner {
      max-width: var(--content-max-desktop);
    }
  }

  .copyright {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    margin: 0;
  }
</style>