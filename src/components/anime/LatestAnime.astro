---
import type { CollectionEntry } from 'astro:content';
import AnimeCard from './AnimeCard.astro';

// src/components/LatestAnime.astro
export interface Props {
  items: CollectionEntry<'anime'>[];
  limit?: number;
}

const { items, limit = 8 } = Astro.props;
const displayItems = items.slice(0, limit);

const $ = {
  wrapper: "grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 md:gap-6",
}
---

<div class={$.wrapper}>
  {displayItems.map((item) => (
    <AnimeCard entry={item} />
    ))
  }
</div>