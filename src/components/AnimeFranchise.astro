---
import { getAllAnime } from '~/lib/anime';
import { URLS } from '~/constants';
import SectionLabel from './SectionLabel.astro';

const RELATION_LABEL: Record<string, string> = {
  sequel: 'Sekuel',
  prequel: 'Prekuel',
  side_story: 'Cerita Sampingan',
  parent_story: 'Cerita Induk',
  alternative: 'Versi Alternatif',
  spin_off: 'Spin-off',
  adaptation: 'Adaptasi',
  character: 'Karakter',
  summary: 'Ringkasan',
  full_story: 'Cerita Lengkap',
  compilation: 'Kompilasi',
  contains: 'Berisi',
  other: 'Terkait',
};

interface Franchise {
  relation: string;
  slug: string;
  title?: string;
}

interface Props {
  title?: string;
  currentSlug: string;
  franchises?: Franchise[];
}

const {
  title = 'Franchise',
  currentSlug,
  franchises = [],
} = Astro.props;

const filtered = franchises.filter((f) => f.slug !== currentSlug);
if (filtered.length === 0) return null;

const allAnime = await getAllAnime();
const animeMap = new Map(allAnime.map((a) => [a.id, a]));

function labelFor(relation: string): string {
  return RELATION_LABEL[relation] ?? relation;
}

function slugToTitle(slug: string): string {
  return slug
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}
---

<section class="section">
  <SectionLabel>{title}</SectionLabel>
  <div class="franchise-grid">
    {filtered.map((f) => {
      const anime = animeMap.get(f.slug);
      const label = labelFor(f.relation);

      if (anime) {
        const epCount = anime.data.episodeList?.length ?? 0;
        const year = anime.data.releaseDate?.getFullYear() ?? null;
        const meta =
          [year, epCount > 0 ? `${epCount} Ep` : null].filter(Boolean).join(' · ') ||
          '—';

        return (
          <a href={URLS.anime(anime.id)} class="franchise-card">
            <div class="franchise-card__cover">
              {anime.data.cover ? (
                <img src={anime.data.cover} alt="" loading="lazy" />
              ) : (
                <div class="franchise-card__cover--empty" />
              )}
              <span class="franchise-card__badge">{label}</span>
            </div>
            <p class="franchise-card__title">{anime.data.title}</p>
            <p class="franchise-card__meta">{meta}</p>
          </a>
        );
      }

      const displayTitle = f.title ?? slugToTitle(f.slug);

      return (
        <div class="franchise-card franchise-card--disabled" aria-disabled="true">
          <div class="franchise-card__cover franchise-card__cover--empty">
            <span class="franchise-card__badge">{label}</span>
          </div>
          <p class="franchise-card__title">{displayTitle}</p>
          <p class="franchise-card__meta">Belum tersedia</p>
        </div>
      );
    })}
  </div>
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .franchise-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .franchise-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    color: inherit;
    text-decoration: none;
    min-width: 0;
    text-align: start;
  }

  .franchise-card__cover {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-surface);
  }
  .franchise-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity var(--t-base);
  }
  .franchise-card:hover .franchise-card__cover img { opacity: 0.85; }
  .franchise-card__cover--empty {
    width: 100%;
    height: 100%;
    background: var(--bg-elevated);
    border: 1px dashed var(--border);
  }

  .franchise-card__badge {
    position: absolute;
    top: var(--s-2);
    left: var(--s-2);
    z-index: 2;
    padding: 2px var(--s-2);
    background: var(--accent);
    color: var(--accent-text);
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
    border-radius: var(--r-sm);
  }

  .franchise-card__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .franchise-card__meta {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .franchise-card--disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  @media (min-width: 50rem) {
    .franchise-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }
</style>