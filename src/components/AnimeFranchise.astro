---
import { getAllAnime } from '~/lib/anime';
import {
  URLS,
  RELATION_LABEL,
  type RelationType,
} from '~/constants';
import SectionLabel from './SectionLabel.astro';
import AnimeCard from './AnimeCard.astro';
import Badge from '~/user-components/Badge.astro';

interface Franchise {
  relation: string;
  slug: string;
  title?: string;
}

interface Props {
  title?: string;
  currentSlug: string;
  franchises?: Franchise[];
}

const {
  title = 'Franchise',
  currentSlug,
  franchises = [],
} = Astro.props;

const filtered = franchises.filter((f) => f.slug !== currentSlug);
if (filtered.length === 0) return null;

const RELATION_PRIORITY: Record<RelationType, number> = {
  prequel: 1,
  sequel: 2,
  parent_story: 3,
  side_story: 4,
  spin_off: 5,
  alternative: 6,
  full_story: 7,
  summary: 8,
  compilation: 9,
  contains: 10,
  adaptation: 11,
  character: 12,
  other: 13,
};

const sorted = [...filtered].sort((a, b) => {
  const pa = RELATION_PRIORITY[a.relation as RelationType] ?? 99;
  const pb = RELATION_PRIORITY[b.relation as RelationType] ?? 99;
  return pa - pb;
});

const allAnime = await getAllAnime();
const animeMap = new Map(allAnime.map((a) => [a.id, a]));

function labelFor(relation: string): string {
  return RELATION_LABEL[relation as RelationType] ?? relation;
}

function slugToTitle(slug: string): string {
  return slug
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}
---

<section class="section">
  <SectionLabel>{title}</SectionLabel>
  <div class="franchise-grid">
    {sorted.map((f) => {
      const anime = animeMap.get(f.slug);
      const label = labelFor(f.relation);

      if (anime) {
        return (
          <AnimeCard
            anime={anime}
            relationBadge={label}
          />
        );
      }

      const displayTitle = f.title ?? slugToTitle(f.slug);

      return (
        <article class="anime-card anime-card--disabled" aria-disabled="true">
          <div class="disabled-cover">
            <Badge variant="outline" size="sm">{label}</Badge>
          </div>
          <div class="disabled-info">
            <h3>{displayTitle}</h3>
            <span class="disabled-meta">Belum tersedia</span>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .franchise-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  @media (min-width: 50rem) {
    .franchise-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }

  /* ==== Disabled card (franchise belum ada di DB) ==== */
  .anime-card--disabled {
    display: block;
    min-width: 0;
    cursor: not-allowed;
    opacity: 0.6;
  }

  .disabled-cover {
    position: relative;
    aspect-ratio: 2 / 3;
    background: var(--bg-surface);
    border: 1px dashed var(--border);
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    padding: var(--s-2);
  }

  .disabled-info {
    padding: var(--s-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .disabled-info h3 {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .disabled-meta {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
</style>
