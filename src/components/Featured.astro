---
import type { HydratedAnime } from '~/lib/anime';
import Icon from '~/user-components/Icons.astro';
import AnimeHero, { type HeroItem } from './AnimeHero.astro';
import { URLS } from '~/constants';

interface Props {
  items?: HydratedAnime[];
}

const { items = [] } = Astro.props;
if (items.length === 0) return null;

const AGE_LABEL: Record<string, string> = {
  G: 'G',
  PG: 'PG', 'PG-13': '13+',
  R: '17+', 'R+': '17+',
  Rx: '18+',
};

function plainExcerpt(input: string | undefined, maxLen = 180): string {
  if (!input) return '';
  const cleaned = input
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[*_`>#]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return cleaned.length <= maxLen ? cleaned : cleaned.slice(0, maxLen).trimEnd() + '…';
}

const slides: HeroItem[] = items.map((anime) => {
  const d = anime.data;
  const epNumbers = d.episodeList.map((e) => e.number).sort((a, b) => a - b);
  const hasEpisodes = epNumbers.length > 0;
  const firstEpisode = epNumbers[0] ?? 1;

  return {
    id: anime.id,
    title: d.title,
    background: d.banner ?? d.cover ?? '',
    age: d.rating ? AGE_LABEL[d.rating] ?? d.rating : null,
    genres: (d.genre ?? []).slice(0, 5),
    excerpt: plainExcerpt(anime.body),
    watchUrl: hasEpisodes ? URLS.watch(anime.id, firstEpisode) : undefined,
    watchLabel: hasEpisodes ? `Mulai Nonton E${firstEpisode}` : 'Belum Ada Episode',
    watchDisabled: !hasEpisodes,
  };
});

const multiple = slides.length > 1;
const AUTOPLAY_MS = 7000;
---

<section
  class="carousel"
  data-hero
  data-autoplay={AUTOPLAY_MS}
  style={`--hero-autoplay: ${AUTOPLAY_MS}ms`}
  aria-roledescription="carousel"
  aria-label="Anime unggulan"
>
  <div class="carousel__track" data-hero-track>
    {slides.map((s, i) => (
      <div
        class:list={['carousel__slide', { 'is-active': i === 0 }]}
        data-hero-slide
        data-index={i}
        aria-roledescription="slide"
        aria-label={`Slide ${i + 1} dari ${slides.length}: ${s.title}`}
        inert={i !== 0 ? true : undefined}
      >
        <AnimeHero
          item={s}
          titleTag={i === 0 ? 'h1' : 'h2'}
          size="carousel"
        />
      </div>
    ))}
  </div>

  {multiple && (
    <>
      <button
        type="button"
        class="carousel__nav carousel__nav--prev"
        data-hero-prev
        aria-label="Slide sebelumnya"
      >
        <Icon name="arrow-left" size={20} />
      </button>
      <button
        type="button"
        class="carousel__nav carousel__nav--next"
        data-hero-next
        aria-label="Slide selanjutnya"
      >
        <Icon name="arrow-right" size={20} />
      </button>
    </>
  )}

  {multiple && (
    <div class="carousel__dots" role="tablist" aria-label="Navigasi slide">
      {slides.map((s, i) => (
        <button
          type="button"
          class:list={['carousel__dot', { 'is-active': i === 0 }]}
          data-hero-dot={i}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`Slide ${i + 1}: ${s.title}`}
        >
          <span class="carousel__dot-fill" aria-hidden="true" />
        </button>
      ))}
    </div>
  )}
</section>

<script>
  function initHero(root: HTMLElement): void {
    if (root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const track = root.querySelector<HTMLElement>('[data-hero-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-hero-next]');

    if (!track || slides.length === 0) return;

    const total = slides.length;
    const multiple = total > 1;
    const autoplayMs = parseInt(root.dataset.autoplay ?? '7000', 10);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let autoplayId: number | null = null;

    function setSlide(next: number): void {
      index = ((next % total) + total) % total;
      track!.style.transform = `translate3d(${-index * 100}%, 0, 0)`;

      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        if (active) slide.removeAttribute('inert');
        else slide.setAttribute('inert', '');
      });

      dots.forEach((dot) => {
        dot.classList.remove('is-active');
        dot.setAttribute('aria-selected', 'false');
      });
      void root.offsetWidth;
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add('is-active');
          dot.setAttribute('aria-selected', 'true');
        }
      });
    }

    function startAutoplay(): void {
      if (!multiple || reduceMotion) return;
      stopAutoplay();
      autoplayId = window.setInterval(() => setSlide(index + 1), autoplayMs);
    }

    function stopAutoplay(): void {
      if (autoplayId !== null) {
        window.clearInterval(autoplayId);
        autoplayId = null;
      }
    }

    function goto(next: number): void {
      setSlide(next);
      startAutoplay();
    }

    prev?.addEventListener('click', () => goto(index - 1));
    next?.addEventListener('click', () => goto(index + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => goto(Number(dot.dataset.heroDot ?? '0')));
    });

    root.addEventListener('keydown', (e) => {
      if (!multiple) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goto(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goto(index + 1);
      }
    });

    let startX = 0;
    let startY = 0;
    let tracking = false;

    root.addEventListener(
      'touchstart',
      (e) => {
        const t = e.touches[0];
        if (!t) return;
        startX = t.clientX;
        startY = t.clientY;
        tracking = true;
      },
      { passive: true }
    );

    root.addEventListener('touchend', (e) => {
      if (!tracking) return;
      tracking = false;
      const t = e.changedTouches[0];
      if (!t) return;
      const dx = t.clientX - startX;
      const dy = t.clientY - startY;
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
      goto(dx < 0 ? index + 1 : index - 1);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    });

    startAutoplay();
  }

  function initAll(scope: ParentNode = document): void {
    scope.querySelectorAll<HTMLElement>('[data-hero]').forEach(initHero);
  }

  initAll();
  document.addEventListener('astro:page-load', () => initAll());
</script>

<style>
  .carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--bg-nav);
    isolation: isolate;
  }

  .carousel__track {
    display: flex;
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .carousel__slide {
    flex: 0 0 100%;
    min-width: 0;
    display: flex;
  }

  .carousel__slide > :global(.hero) {
    width: 100%;
  }

  /* ==== Nav arrows ==== */
  .carousel__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 3.25rem;
    padding: 0;
    background: hsla(0, 0%, 0%, 0.4);
    color: #fff;
    border: none;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--t-base), background var(--t-fast);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .carousel:hover .carousel__nav,
  .carousel:focus-within .carousel__nav {
    opacity: 0.9;
  }

  .carousel__nav:hover {
    background: hsla(0, 0%, 0%, 0.7);
    opacity: 1;
  }

  .carousel__nav--prev { left: 0; }
  .carousel__nav--next { right: 0; }

  /* ==== Dots ==== */
  .carousel__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--s-4);
    z-index: 3;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--s-2);
    pointer-events: none;
  }

  .carousel__dots > * {
    pointer-events: auto;
  }

  .carousel__dot {
    position: relative;
    display: block;
    width: 2.5rem;
    height: 4px;
    padding: 0;
    background: hsla(0, 0%, 100%, 0.28);
    border: none;
    cursor: pointer;
    overflow: hidden;
    transition: background var(--t-fast);
  }

  .carousel__dot:hover {
    background: hsla(0, 0%, 100%, 0.5);
  }

  .carousel__dot-fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .carousel__dot.is-active .carousel__dot-fill {
    animation: hero-progress var(--hero-autoplay, 7000ms) linear forwards;
  }

  @keyframes hero-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  @media (min-width: 50rem) {
    .carousel__nav {
      width: 3rem;
      height: 4rem;
    }

    .carousel__dot {
      width: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      transition: none;
    }
    .carousel__dot.is-active .carousel__dot-fill {
      animation: none;
      transform: scaleX(1);
    }
    .carousel__nav {
      opacity: 1;
    }
  }
</style>
