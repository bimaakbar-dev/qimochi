---
import LinkCard from '../user-components/LinkCard.astro';
import Badge from '../user-components/Badge.astro';
import { URLS, STATUS_VARIANT, type Status } from '../constants';

interface Props {
  anime: {
    id: string;
    data: {
      title: string;
      cover: string;
      status: string;
      tahun?: number;
    };
  };
  featured?: boolean;
}

const { anime, featured = false } = Astro.props;
const { id, data } = anime;

const variant = STATUS_VARIANT[data.status as Status] ?? 'default';
---

<LinkCard
  href={URLS.anime(id)}
  class:list={['anime-card', { 'anime-card-featured': featured }]}
>
  <div class="cover">
    <img
      src={data.cover}
      alt={`Cover ${data.title}`}
      width="300"
      height="450"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="info">
    <h3 class="title">{data.title}</h3>
    <div class="meta">
      <Badge variant={variant} size="sm">{data.status}</Badge>
      {data.tahun && <span class="year">{data.tahun}</span>}
    </div>
  </div>
</LinkCard>

<style>
  .anime-card {
    background: var(--bg-elevated);
  }

  .cover {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-base);
  }

  .anime-card:hover .cover img {
    transform: scale(1.03);
  }

  .info {
    padding: var(--s-2) var(--s-3) var(--s-3);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
    line-height: var(--lh-snug);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .year {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .anime-card-featured {
    background: transparent;
  }

  .anime-card-featured .info {
    padding: var(--s-3) 0 0;
  }
</style>