---
import Badge from '~/user-components/Badge.astro';
import Icon from '~/user-components/Icons.astro';
import BookmarkButton from './BookmarkButton.astro';
import { URLS, STATUS_VARIANT, type Status } from '~/constants';

interface CardAnime {
  id: string;
  body?: string;
  data: {
    title: string;
    cover: string;
    banner?: string;
    status: string;
    type: string;
    releaseDate: Date | null;
    score?: number | null;
    stats?: { scoredBy?: number } | null;
    studio?: string;
    episodes?: number | null;
    episodeList?: { number: number }[];
  };
}

interface Props {
  mode?: 'grid' | 'compact' | 'featured' | 'template';
  anime?: CardAnime;
  featured?: boolean;
  relationBadge?: string;
  rich?: boolean;
}

const {
  mode = 'grid',
  anime,
  featured = false,
  relationBadge,
  rich = true,
} = Astro.props;

const isTemplate = mode === 'template';
const isGrid = mode === 'grid' || isTemplate;
const isCompact = mode === 'compact';
const isFeatured = mode === 'featured';

if (!isTemplate && !anime) {
  throw new Error('[AnimeCard] Prop "anime" wajib diisi.');
}

const id = anime?.id ?? '';
const data = anime?.data;

const variant = data
  ? STATUS_VARIANT[data.status as Status] ?? 'default'
  : 'default';

/*
 * Sumber kebenaran tunggal: episodeList yang sudah difilter di lib/anime.ts
 * (hanya episode yang punya minimal 1 server dengan URL valid).
 * Field `data.episodes` dari frontmatter = metadata sumber, TIDAK dipakai untuk display.
 */
const episodes = data?.episodeList ?? [];
const totalEpisodes = episodes.length;
const hasEpisodes = totalEpisodes > 0;

const firstEpisode = hasEpisodes
  ? Math.min(...episodes.map((e) => e.number))
  : 1;
const lastEpisode = hasEpisodes
  ? Math.max(...episodes.map((e) => e.number))
  : 0;

// Tampilkan jumlah episode yang benar-benar tersedia.
const episodeLabel = hasEpisodes ? `${totalEpisodes} Episode` : null;

// Nomor episode terakhir yang sudah rilis (untuk badge/meta).
const latestEpisodeLabel = lastEpisode > 0 ? `Ep ${lastEpisode}` : null;

const score = data?.score ?? null;
const votedBy = data?.stats?.scoredBy ?? 0;
const studio =
  data?.studio && data.studio !== 'Unknown' ? data.studio : null;

const landscape = data?.banner || data?.cover || '';

function formatCount(n: number): string {
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(1).replace(/\.0$/, '') + 'K';
  return String(n);
}

function plainExcerpt(input: string | undefined, maxLen = 110): string {
  if (!input) return '';
  const cleaned = input
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[*_`>#]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return cleaned.length <= maxLen
    ? cleaned
    : cleaned.slice(0, maxLen).trimEnd() + '…';
}

const excerpt = plainExcerpt(anime?.body);
const scorePercent = score != null ? (score / 10) * 100 : 0;
---

{isTemplate && (
  <>
    <template id="anime-card-template">
      <article class="anime-card anime-card-rich">
        <a class="anime-card__link" data-card-link>
          <div class="cover">
            <div class="cover-placeholder is-loading" aria-hidden="true"></div>
            <img width="300" height="450" loading="lazy" decoding="async" data-cover-img />
            <span class="type-badge" data-card-type></span>
            <div class="status-overlay">
              <span class="card-status" data-card-status></span>
            </div>
          </div>
        </a>
        <div class="preview" aria-hidden="true">
          <div class="preview__inner">
            <h4 class="preview__title" data-card-title></h4>
            <div class="preview__rating" data-card-rating hidden>
              <span class="preview__stars" aria-hidden="true">
                <span class="preview__stars-bg">★★★★★</span>
                <span class="preview__stars-fill" data-card-stars-fill>★★★★★</span>
              </span>
              <span class="preview__score" data-card-score></span>
              <span class="preview__votes" data-card-votes></span>
            </div>
            <div class="preview__actions">
              <a class="preview__btn preview__btn--play" data-card-play>
                <Icon name="play" size={16} />
              </a>
              <BookmarkButton animeId="__placeholder" variant="plain" class="preview__bookmark" />
            </div>
          </div>
        </div>
        <div class="info">
          <h3 data-card-title-info></h3>
          <p class="episodes" data-card-episodes hidden></p>
        </div>
      </article>
    </template>

    <template id="anime-card-featured-template">
      <article class="anime-card anime-card--featured anime-card-rich">
        <a class="featured__link" data-card-link>
          <div class="featured__cover">
            <div class="cover-placeholder is-loading" aria-hidden="true"></div>
            <img width="480" height="360" loading="lazy" decoding="async" data-cover-img />
            <span class="type-badge" data-card-type></span>
            <div class="status-overlay">
              <span class="card-status" data-card-status></span>
            </div>
          </div>
          <div class="featured__info">
            <h3 class="featured__title" data-card-title-info></h3>
            <p class="featured__meta" data-card-meta-text></p>
          </div>
        </a>
        <div class="preview" aria-hidden="true">
          <div class="preview__inner">
            <h4 class="preview__title" data-card-title></h4>
            <div class="preview__rating" data-card-rating hidden>
              <span class="preview__stars" aria-hidden="true">
                <span class="preview__stars-bg">★★★★★</span>
                <span class="preview__stars-fill" data-card-stars-fill>★★★★★</span>
              </span>
              <span class="preview__score" data-card-score></span>
              <span class="preview__votes" data-card-votes></span>
            </div>
            <div class="preview__actions">
              <a class="preview__btn preview__btn--play" data-card-play>
                <Icon name="play" size={16} />
              </a>
              <BookmarkButton animeId="__placeholder" variant="plain" class="preview__bookmark" />
            </div>
          </div>
        </div>
      </article>
    </template>

    <template id="anime-card-compact-template">
      <article class="anime-card anime-card--compact">
        <a class="compact__link" data-card-link>
          <div class="compact__thumb">
            <div class="cover-placeholder is-loading" aria-hidden="true"></div>
            <img width="80" height="120" loading="lazy" decoding="async" data-cover-img />
          </div>
          <div class="compact__body">
            <h3 class="compact__title" data-card-title-info></h3>
            <p class="compact__meta" data-card-meta-text></p>
            <div class="compact__rating" data-card-rating hidden>
              <span class="compact__stars" aria-hidden="true">
                <span class="compact__stars-bg">★★★★★</span>
                <span class="compact__stars-fill" data-card-stars-fill>★★★★★</span>
              </span>
              <span class="compact__score" data-card-score></span>
              <span class="compact__votes" data-card-votes></span>
            </div>
          </div>
        </a>
        <div class="compact__actions">
          <a class="compact__btn" data-card-play>
            <Icon name="play" size={16} />
          </a>
          <BookmarkButton animeId="__placeholder" variant="plain" class="preview__bookmark" />
        </div>
      </article>
    </template>
  </>
)}

{isGrid && !isTemplate && (
  <article
    class:list={[
      'anime-card',
      { 'anime-card-featured': featured, 'anime-card-rich': rich },
    ]}
  >
    <a href={URLS.anime(id)} class="anime-card__link" aria-label={data!.title}>
      <div class="cover">
        <div class="cover-placeholder is-loading" aria-hidden="true"></div>
        <img
          src={data!.cover}
          alt={`Cover ${data!.title}`}
          width="300"
          height="450"
          loading="lazy"
          decoding="async"
          data-cover-img
        />
        <span class="type-badge">{data!.type}</span>
        <div class="status-overlay">
          <Badge variant={variant} size="sm">{data!.status}</Badge>
        </div>
      </div>
    </a>

    {rich && (
      <div class="preview" aria-hidden="true">
        <div class="preview__inner">
          <h4 class="preview__title">{data!.title}</h4>
          {score != null && (
            <div class="preview__rating">
              <span class="preview__stars" aria-hidden="true">
                <span class="preview__stars-bg">★★★★★</span>
                <span class="preview__stars-fill" style={`width:${scorePercent}%`}>★★★★★</span>
              </span>
              <span class="preview__score">{score.toFixed(1)}</span>
              {votedBy > 0 && <span class="preview__votes">({formatCount(votedBy)})</span>}
            </div>
          )}
          {studio && (
            <ul class="preview__meta">
              <li>{studio}</li>
            </ul>
          )}
          {excerpt && <p class="preview__excerpt">{excerpt}</p>}
          <div class="preview__actions">
            {hasEpisodes ? (
              <a href={URLS.watch(id, firstEpisode)} class="preview__btn preview__btn--play" aria-label={`Mulai menonton episode ${firstEpisode}`}>
                <Icon name="play" size={16} />
              </a>
            ) : (
              <span class="preview__btn preview__btn--play is-disabled" aria-disabled="true">
                <Icon name="play" size={16} />
              </span>
            )}
            <BookmarkButton animeId={id} variant="plain" />
          </div>
        </div>
      </div>
    )}

    <div class="info">
      <h3 set:html={data!.title} />
      {relationBadge && <span class="relation-badge">{relationBadge}</span>}
      {episodeLabel && (
        <span class="episodes">
          {relationBadge ? `${relationBadge} · ${episodeLabel}` : episodeLabel}
        </span>
      )}
    </div>
  </article>
)}

{isCompact && (
  <article class="anime-card anime-card--compact">
    <a href={URLS.anime(id)} class="compact__link" aria-label={data!.title}>
      <div class="compact__thumb">
        <div class="cover-placeholder is-loading" aria-hidden="true"></div>
        <img
          src={data!.cover}
          alt=""
          width="80"
          height="120"
          loading="lazy"
          decoding="async"
          data-cover-img
        />
      </div>
      <div class="compact__body">
        <h3 class="compact__title" set:html={data!.title} />
        {episodeLabel && (
          <p class="compact__meta">{episodeLabel}</p>
        )}
        {score != null && (
          <div class="compact__rating">
            <span class="compact__stars" aria-hidden="true">
              <span class="compact__stars-bg">★★★★★</span>
              <span class="compact__stars-fill" style={`width:${scorePercent}%`}>★★★★★</span>
            </span>
            <span class="compact__score">{score.toFixed(1)}</span>
            {votedBy > 0 && <span class="compact__votes">({formatCount(votedBy)})</span>}
          </div>
        )}
      </div>
    </a>
    <div class="compact__actions">
      {hasEpisodes ? (
        <a href={URLS.watch(id, firstEpisode)} class="compact__btn" aria-label={`Mulai menonton episode ${firstEpisode}`}>
          <Icon name="play" size={16} />
        </a>
      ) : (
        <span class="compact__btn is-disabled" aria-disabled="true">
          <Icon name="play" size={16} />
        </span>
      )}
      <BookmarkButton animeId={id} variant="plain" />
    </div>
  </article>
)}

{isFeatured && (
  <article class="anime-card anime-card--featured anime-card-rich">
    <a href={URLS.anime(id)} class="featured__link" aria-label={data!.title}>
      <div class="featured__cover">
        <div class="cover-placeholder is-loading" aria-hidden="true"></div>
        <img
          src={landscape}
          alt=""
          width="480"
          height="360"
          loading="lazy"
          decoding="async"
          data-cover-img
        />
        <span class="type-badge">{data!.type}</span>
        <div class="status-overlay">
          <Badge variant={variant} size="sm">{data!.status}</Badge>
        </div>
      </div>
      <div class="featured__info">
        <h3 class="featured__title" set:html={data!.title} />
        <p class="featured__meta">
          {[data!.type, episodeLabel].filter(Boolean).join(' · ')}
        </p>
      </div>
    </a>

    {rich && (
      <div class="preview" aria-hidden="true">
        <div class="preview__inner">
          <h4 class="preview__title">{data!.title}</h4>
          {score != null && (
            <div class="preview__rating">
              <span class="preview__stars" aria-hidden="true">
                <span class="preview__stars-bg">★★★★★</span>
                <span class="preview__stars-fill" style={`width:${scorePercent}%`}>★★★★★</span>
              </span>
              <span class="preview__score">{score.toFixed(1)}</span>
              {votedBy > 0 && <span class="preview__votes">({formatCount(votedBy)})</span>}
            </div>
          )}
          {studio && (
            <ul class="preview__meta">
              <li>{studio}</li>
            </ul>
          )}
          {excerpt && <p class="preview__excerpt">{excerpt}</p>}
          <div class="preview__actions">
            {hasEpisodes ? (
              <a href={URLS.watch(id, firstEpisode)} class="preview__btn preview__btn--play" aria-label={`Mulai menonton episode ${firstEpisode}`}>
                <Icon name="play" size={16} />
              </a>
            ) : (
              <span class="preview__btn preview__btn--play is-disabled" aria-disabled="true">
                <Icon name="play" size={16} />
              </span>
            )}
            <BookmarkButton animeId={id} variant="plain" />
          </div>
        </div>
      </div>
    )}
  </article>
)}

<script>
  (function () {
    function setupCoverImage(img: HTMLImageElement): void {
      if (img.dataset.ready === '1') return;
      img.dataset.ready = '1';

      const wrap = img.parentElement;
      const placeholder =
        wrap?.querySelector<HTMLElement>('.cover-placeholder') ?? null;

      const stopShimmer = () => placeholder?.classList.remove('is-loading');
      const fail = () => {
        img.hidden = true;
        stopShimmer();
      };

      if (img.complete && img.naturalWidth > 0) {
        stopShimmer();
        return;
      }
      if (img.complete && img.naturalWidth === 0) {
        fail();
        return;
      }

      img.addEventListener('load', stopShimmer, { once: true });
      img.addEventListener('error', fail, { once: true });
    }

    function init(scope: ParentNode = document): void {
      scope
        .querySelectorAll<HTMLImageElement>('[data-cover-img]')
        .forEach(setupCoverImage);
    }

    init();

    window.addEventListener('qimochi:covers', (e) => {
      const detail = (e as CustomEvent<ParentNode>).detail;
      if (detail) init(detail);
    });
  })();
</script>

<style is:global>
  .anime-card {
    position: relative;
    display: block;
    min-width: 0;
  }

  .cover-placeholder {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--bg-surface);
    pointer-events: none;
  }

  .cover-placeholder.is-loading::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 20%,
      var(--bg-hover) 50%,
      transparent 80%
    );
    transform: translateX(-100%);
    animation: cover-shimmer 1.6s infinite;
  }

  @keyframes cover-shimmer {
    100% { transform: translateX(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-placeholder.is-loading::before {
      animation: none;
      opacity: 0;
    }
  }

  [data-cover-img] {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--t-base);
  }
  [data-cover-img][hidden] { display: none; }

  .type-badge {
    position: absolute;
    top: var(--s-2);
    right: var(--s-2);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.7);
    color: var(--text-inverted);
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .status-overlay {
    position: absolute;
    bottom: var(--s-2);
    left: var(--s-2);
    z-index: 3;
  }

  .status-overlay span {
    text-transform: uppercase;
  }

  .anime-card .anime-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .anime-card .anime-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .anime-card .cover {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .anime-card .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to bottom, transparent 50%, rgba(0, 0, 0, 0.6) 100%);
    pointer-events: none;
    transition: opacity var(--t-fast);
  }

  .card-status {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    padding: 0.1875rem var(--s-2);
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .card-status[data-variant='default'] { background: var(--bg-surface); color: var(--text-secondary); }
  .card-status[data-variant='success'] { background: var(--success-soft); color: var(--success); }
  .card-status[data-variant='warning'] { background: var(--warning-soft); color: var(--warning); }
  .card-status[data-variant='accent']  { background: var(--accent); color: var(--accent-text); }

  .anime-card .info {
    padding: var(--s-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .anime-card .info h3 {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    margin: 0;
    min-width: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .relation-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 2px 6px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  .episodes {
    display: block;
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    font-weight: var(--fw-medium);
    line-height: 1.3;
  }
  .episodes[hidden] { display: none; }

  .anime-card-featured {
    background: transparent;
  }

  .preview {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: hsla(30, 3%, 5%, 0.94);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: var(--s-3);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--t-base);
    overflow: hidden;
  }

  .preview__inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    height: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .preview__title {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    flex-shrink: 0;
  }

  .preview__rating {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-xs);
    flex-shrink: 0;
  }
  .preview__rating[hidden] { display: none; }

  .preview__stars {
    position: relative;
    display: inline-block;
    font-size: var(--fs-sm);
    letter-spacing: 1px;
    line-height: 1;
    white-space: nowrap;
  }

  .preview__stars-bg { color: hsla(0, 0%, 100%, 0.25); }

  .preview__stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--gold);
    overflow: hidden;
    white-space: nowrap;
    transition: width var(--t-base);
  }

  .preview__score {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .preview__votes {
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }

  .preview__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--fs-xs);
    color: var(--text-primary);
    font-weight: var(--fw-medium);
    line-height: 1.3;
    flex-shrink: 0;
  }
  .preview__meta:empty { display: none; }

  .preview__excerpt {
    margin: 0;
    font-size: var(--fs-xs);
    line-height: 1.4;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    text-overflow: ellipsis;
  }
  .preview__excerpt:empty { display: none; }

  .preview__actions {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-top: auto;
    flex-shrink: 0;
    padding-top: var(--s-1);
  }

  .preview__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--accent);
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: color var(--t-fast);
  }
  .preview__btn svg { width: 1.333em; height: 1.333em; flex-shrink: 0; }
  .preview__btn:hover { color: var(--accent-hover); }
  .preview__btn.is-disabled {
    color: hsla(0, 0%, 100%, 0.3);
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .anime-card-rich:hover .preview { opacity: 1; }
    .anime-card-rich:hover .preview__btn { pointer-events: auto; }

    .anime-card-rich:hover .cover img,
    .anime-card-rich:hover .featured__cover img {
      opacity: 0.15;
