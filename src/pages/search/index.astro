---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../user-components/Icons.astro';
---

<BaseLayout
  title="Cari Anime"
  description="Cari anime di Qimochi."
  noindex={true}
>
  <div class="wrapper">
    <header class="page-header">
      <h1>Cari Anime</h1>
    </header>

    <form class="search-form" id="search-form">
      <input
        type="search"
        id="search-input"
        class="search-input"
        placeholder="Ketik judul anime..."
        autocomplete="off"
        autofocus
      />
      <button type="submit" class="search-btn">
        <Icon name="search" />
        <span>Cari</span>
      </button>
    </form>

    <div id="search-status" class="search-status" hidden></div>
    <div id="search-results" class="anime-grid"></div>
  </div>
</BaseLayout>

<script>
  import { STATUS_VARIANT, type Status } from '../../constants';

  interface Anime {
    id: string;
    title: string;
    cover: string;
    status: string;
    tahun: number;
    rating: number;
  }

  /* ----------------------------------------------------------
     FUZZY SEARCH
     ---------------------------------------------------------- */

  function normalize(s: string): string {
    return s
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9\s]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function levenshtein(a: string, b: string): number {
    if (a === b) return 0;
    if (a.length === 0) return b.length;
    if (b.length === 0) return a.length;

    const matrix: number[][] = [];
    for (let i = 0; i <= b.length; i++) matrix[i] = [i];
    for (let j = 0; j <= a.length; j++) matrix[0][j] = j;

    for (let i = 1; i <= b.length; i++) {
      for (let j = 1; j <= a.length; j++) {
        const cost = a[j - 1] === b[i - 1] ? 0 : 1;
        matrix[i][j] = Math.min(
          matrix[i - 1][j] + 1,
          matrix[i][j - 1] + 1,
          matrix[i - 1][j - 1] + cost
        );
      }
    }

    return matrix[b.length][a.length];
  }

  function scoreTitle(query: string, title: string): number {
    const q = normalize(query);
    const t = normalize(title);
    if (!q || !t) return 0;

    if (t.includes(q)) {
      const pos = t.indexOf(q);
      return 1 - (pos / t.length) * 0.3;
    }

    const words = t.split(' ');
    let best = 0;

    for (const word of words) {
      const dist = levenshtein(q, word);
      const maxLen = Math.max(q.length, word.length);
      const similarity = 1 - dist / maxLen;
      if (similarity > best) best = similarity;
    }

    if (q.length >= 3) {
      for (const word of words) {
        if (word.includes(q) || q.includes(word)) {
          best = Math.max(best, 0.85);
        }
      }
    }

    return best * 0.85;
  }

  /* ----------------------------------------------------------
     RENDER CARD
     ---------------------------------------------------------- */

  function renderCard(a: Anime): string {
    const variant = STATUS_VARIANT[a.status as Status] ?? 'default';
    return `
      <a href="/anime/${a.id}/" class="anime-card">
        <div class="cover">
          <img src="${a.cover}" alt="Cover ${a.title}" width="300" height="450" loading="lazy" decoding="async" />
        </div>
        <div class="info">
          <h3 class="title">${a.title}</h3>
          <div class="meta">
            <span class="badge badge-${variant}">${a.status}</span>
            ${a.tahun ? `<span class="year">${a.tahun}</span>` : ''}
          </div>
        </div>
      </a>
    `;
  }

  /* ----------------------------------------------------------
     INIT
     ---------------------------------------------------------- */

  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const status = document.getElementById('search-status')!;
  const results = document.getElementById('search-results')!;

  let allAnime: Anime[] = [];

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') || '';
  input.value = initialQuery;

  async function loadData() {
    if (allAnime.length > 0) return;
    try {
      const res = await fetch('/anime.json');
      allAnime = await res.json();
    } catch {
      status.textContent = 'Gagal memuat data.';
      status.hidden = false;
    }
  }

  function renderResults(items: Anime[]) {
    results.innerHTML = items.map(renderCard).join('');
  }

  async function runSearch(query: string) {
    await loadData();

    const q = query.trim();
    if (q.length < 2) {
      status.textContent = 'Ketik minimal 2 karakter.';
      status.hidden = false;
      results.innerHTML = '';
      return;
    }

    const scored = allAnime
      .map(a => ({ anime: a, score: scoreTitle(q, a.title) }))
      .filter(r => r.score > 0.4)
      .sort((a, b) => b.score - a.score);

    if (scored.length === 0) {
      status.textContent = `Tidak ada hasil untuk "${q}".`;
      status.hidden = false;
      results.innerHTML = '';
      return;
    }

    status.textContent = `${scored.length} hasil untuk "${q}"`;
    status.hidden = false;
    renderResults(scored.map(r => r.anime));
  }

  form.addEventListener('submit', e => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) return;
    const url = new URL(window.location.href);
    url.searchParams.set('q', q);
    window.history.pushState({}, '', url);
    runSearch(q);
  });

  window.addEventListener('popstate', () => {
    const p = new URLSearchParams(window.location.search);
    const q = p.get('q') || '';
    input.value = q;
    if (q) runSearch(q);
  });

  if (initialQuery) {
    runSearch(initialQuery);
  }
</script>

<style>
  .wrapper {
    padding-block: var(--s-8) var(--s-12);
  }

  .page-header {
    margin-bottom: var(--s-6);
  }

  .page-header h1 {
    margin: 0;
  }

  /* ----------------------------------------------------------
     FORM
     ---------------------------------------------------------- */
  .search-form {
    display: flex;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
  }

  .search-input {
    flex: 1;
    padding: var(--s-3) var(--s-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: var(--fs-base);
    transition: border-color var(--t-fast);
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-5);
    background: var(--accent);
    border: 1px solid var(--accent);
    color: var(--accent-text);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all var(--t-fast);
    cursor: pointer;
  }

  .search-btn:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .search-btn :global(svg) {
    width: 1em;
    height: 1em;
  }

  .search-status {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--s-4);
  }

  /* ----------------------------------------------------------
     GRID
     ---------------------------------------------------------- */
  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }

  @media (min-width: 48rem) {
    .anime-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-4);
    }
  }

  /* ----------------------------------------------------------
     CARD — match AnimeCard.astro
     ---------------------------------------------------------- */
  .anime-grid :global(.anime-card) {
    display: block;
    background: var(--bg-elevated);
    border: 1px solid transparent;
    overflow: hidden;
    transition: transform var(--t-fast), background var(--t-fast);
  }

  .anime-grid :global(.anime-card:hover) {
    background: var(--bg-surface);
    transform: translateY(-2px);
  }

  .anime-grid :global(.cover) {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .anime-grid :global(.cover img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-base);
  }

  .anime-grid :global(.anime-card:hover .cover img) {
    transform: scale(1.03);
  }

  .anime-grid :global(.info) {
    padding: var(--s-2) var(--s-3) var(--s-3);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .anime-grid :global(.title) {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
    line-height: var(--lh-snug);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .anime-grid :global(.meta) {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .anime-grid :global(.year) {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  /* ----------------------------------------------------------
     BADGE — match Badge.astro
     ---------------------------------------------------------- */
  .anime-grid :global(.badge) {
    display: inline-flex;
    align-items: center;
    padding: 0.1875rem var(--s-2);
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1px solid transparent;
    line-height: 1;
  }

  .anime-grid :global(.badge-default) {
    background: var(--bg-surface);
    color: var(--text-secondary);
  }

  .anime-grid :global(.badge-success) {
    background: var(--success-soft);
    color: var(--success);
  }

  .anime-grid :global(.badge-warning) {
    background: var(--warning-soft);
    color: var(--warning);
  }
</style>