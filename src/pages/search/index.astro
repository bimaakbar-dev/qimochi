---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import Icon from '~/user-components/Icons.astro';
import Button from '~/user-components/Button.astro';
---

<BaseLayout
  title="Cari Anime"
  description="Cari anime di Qimochi."
  noindex={true}
>
  <div class="wrapper">

    <Hero
      title="Cari Anime"
      description="Cari judul anime dengan cepat."
    />

    <form class="search-form" id="search-form">
      <div class="search-input-wrap">
        <span class="search-input-icon" aria-hidden="true">
          <Icon name="search" size={18} />
        </span>
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder="Ketik judul anime..."
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          class="search-clear"
          id="search-clear"
          aria-label="Hapus pencarian"
          hidden
        >
          <Icon name="close" size={16} />
        </button>
      </div>

      <Button type="submit" variant="accent" size="md">
        Cari
      </Button>
    </form>

    <div id="search-empty" class="search-empty">
      <p>Mulai ketik untuk mencari anime.</p>
      <p class="search-empty-hint">
        Atau jelajahi <a href="/anime/">archive lengkap</a>.
      </p>
    </div>

    <div id="search-status" class="search-status" hidden></div>

    <div id="search-results" class="anime-grid" hidden></div>

    <div class="load-more-wrap" id="load-more-wrap" hidden>
      <Button type="button" id="load-more-btn" variant="outline" size="md">
        <span id="load-more-text">Muat Lebih Banyak</span>
      </Button>
    </div>

    <div id="load-sentinel" aria-hidden="true"></div>

  </div>

  <template id="anime-card-template">
    <a class="anime-card" data-anime-title="">
      <div class="cover">
        <img
          data-cover-img
          alt=""
          width="300"
          height="450"
          loading="lazy"
          decoding="async"
        />
        <span class="type-badge"></span>
        <div class="status-overlay">
          <span class="badge badge-sm" data-badge></span>
        </div>
      </div>
      <div class="info">
        <h3></h3>
        <span class="episodes" hidden></span>
      </div>
    </a>
  </template>
</BaseLayout>

<script>
  (function () {
    const API = '/api/anime.json';
    const BATCH = 24;
    const DEBOUNCE_MS = 120;
    const MIN_QUERY = 2;
    const FUZZY_THRESHOLD = 0.55;

    type IndexItem = {
      i: string; t: string; c: string;
      s: string; y: string; e: number;
    };

    type Entry = {
      item: IndexItem;
      search: string;
    };

    const form = document.getElementById('search-form') as HTMLFormElement;
    const input = document.getElementById('search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('search-clear') as HTMLButtonElement;
    const emptyState = document.getElementById('search-empty')!;
    const status = document.getElementById('search-status')!;
    const results = document.getElementById('search-results')!;
    const loadMoreWrap = document.getElementById('load-more-wrap')!;
    const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement;
    const loadMoreText = document.getElementById('load-more-text')!;
    const sentinel = document.getElementById('load-sentinel')!;
    const tmpl = document.getElementById('anime-card-template') as HTMLTemplateElement | null;

    if (!form || !tmpl) return;

    let index: Entry[] = [];
    let matched: IndexItem[] = [];
    let visibleCount = 0;
    let ready = false;

    /* ---------- FUZZY (fallback only) ---------- */
    function levenshtein(a: string, b: string): number {
      if (a === b) return 0;
      if (a.length === 0) return b.length;
      if (b.length === 0) return a.length;

      const m: number[][] = [];
      for (let i = 0; i <= b.length; i++) m[i] = [i];
      for (let j = 0; j <= a.length; j++) m[0][j] = j;

      for (let i = 1; i <= b.length; i++) {
        for (let j = 1; j <= a.length; j++) {
          const cost = a[j - 1] === b[i - 1] ? 0 : 1;
          m[i][j] = Math.min(
            m[i - 1][j] + 1,
            m[i][j - 1] + 1,
            m[i - 1][j - 1] + cost
          );
        }
      }
      return m[b.length][a.length];
    }

    function fuzzyScore(q: string, t: string): number {
      if (!q || !t) return 0;

      const words = t.split(' ');
      let best = 0;
      for (const w of words) {
        const dist = levenshtein(q, w);
        const max = Math.max(q.length, w.length);
        const sim = 1 - dist / max;
        if (sim > best) best = sim;
      }
      return best;
    }

    /* ---------- CARD RENDER ---------- */
    function statusVariant(s: string): string {
      if (s === 'Ongoing') return 'badge-success';
      if (s === 'Hiatus') return 'badge-warning';
      return 'badge-default';
    }

    function makeCard(item: IndexItem): HTMLElement {
      const node = tmpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      node.setAttribute('href', `/anime/${item.i}/`);
      node.dataset.animeTitle = item.t;

      const img = node.querySelector('[data-cover-img]') as HTMLImageElement;
      if (item.c) {
        img.src = item.c;
        img.alt = `Cover ${item.t}`;
      }

      (node.querySelector('.type-badge') as HTMLElement).textContent = item.y;

      const badge = node.querySelector('[data-badge]') as HTMLElement;
      badge.classList.add(statusVariant(item.s));
      badge.textContent = item.s;

      (node.querySelector('h3') as HTMLElement).textContent = item.t;

      const eps = node.querySelector('.episodes') as HTMLElement;
      if (item.e > 0) {
        eps.textContent = `Ep ${item.e}`;
        eps.hidden = false;
      }

      return node;
    }

    function renderNext(): void {
      const end = Math.min(visibleCount + BATCH, matched.length);
      if (end <= visibleCount) return;

      const frag = document.createDocumentFragment();
      for (let i = visibleCount; i < end; i++) {
        frag.appendChild(makeCard(matched[i]!));
      }
      results.appendChild(frag);
      visibleCount = end;
      updateLoadMore();
    }

    function updateLoadMore(): void {
      const remaining = matched.length - visibleCount;
      loadMoreWrap.hidden = remaining <= 0;
      if (remaining > 0) {
        loadMoreText.textContent = `Muat Lebih Banyak (${remaining} lagi)`;
      }
    }

    function resetResults(): void {
      results.innerHTML = '';
      visibleCount = 0;
      matched = [];
    }

    /* ---------- FILTER ---------- */
    function runFilter(qRaw: string): IndexItem[] {
      const q = qRaw.toLowerCase().trim();
      if (!q) return [];

      const substring: IndexItem[] = [];
      for (const entry of index) {
        if (entry.search.includes(q)) substring.push(entry.item);
      }

      if (substring.length > 0) {
        substring.sort((a, b) => {
          const at = a.t.toLowerCase();
          const bt = b.t.toLowerCase();
          const ai = at.indexOf(q);
          const bi = bt.indexOf(q);
          if (ai !== bi) return ai - bi;
          return at.length - bt.length;
        });
        return substring;
      }

      const fuzzy = index
        .map(e => ({ item: e.item, score: fuzzyScore(q, e.search) }))
        .filter(({ score }) => score >= FUZZY_THRESHOLD)
        .sort((a, b) => b.score - a.score)
        .map(s => s.item);

      return fuzzy;
    }

    function applyFilter(query: string): void {
      const q = query.trim();

      if (!ready) return;

      if (q.length === 0) {
        resetResults();
        emptyState.hidden = false;
        status.hidden = true;
        results.hidden = true;
        loadMoreWrap.hidden = true;
        return;
      }

      if (q.length < MIN_QUERY) {
        resetResults();
        emptyState.hidden = true;
        status.textContent = `Ketik minimal ${MIN_QUERY} karakter.`;
        status.hidden = false;
        results.hidden = true;
        loadMoreWrap.hidden = true;
        return;
      }

      resetResults();
      matched = runFilter(q);

      emptyState.hidden = true;
      results.hidden = false;

      if (matched.length === 0) {
        status.textContent = `Tidak ada hasil untuk "${q}".`;
        status.hidden = false;
        results.hidden = true;
        loadMoreWrap.hidden = true;
        return;
      }

      status.textContent = `${matched.length} hasil untuk "${q}"`;
      status.hidden = false;
      renderNext();
    }

    /* ---------- EVENTS ---------- */
    let debounceId: number | null = null;
    function debouncedFilter(q: string): void {
      if (debounceId !== null) window.clearTimeout(debounceId);
      debounceId = window.setTimeout(() => applyFilter(q), DEBOUNCE_MS);
    }

    function updateClearBtn(): void {
      clearBtn.hidden = input.value.length === 0;
    }

    input.addEventListener('input', () => {
      updateClearBtn();
      debouncedFilter(input.value);
    });
    updateClearBtn();

    clearBtn.addEventListener('click', () => {
      input.value = '';
      input.focus();
      updateClearBtn();
      applyFilter('');
      const url = new URL(window.location.href);
      url.searchParams.delete('q');
      window.history.pushState({}, '', url);
    });

    form.addEventListener('submit', e => {
      e.preventDefault();
      if (debounceId !== null) window.clearTimeout(debounceId);
      const q = input.value.trim();
      const url = new URL(window.location.href);
      if (q) url.searchParams.set('q', q);
      else url.searchParams.delete('q');
      window.history.pushState({}, '', url);
      applyFilter(q);
    });

    loadMoreBtn.addEventListener('click', () => renderNext());

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          if (matched.length - visibleCount <= 0) return;
          renderNext();
        });
      }, { rootMargin: '400px 0px' });
      io.observe(sentinel);
    }

    window.addEventListener('popstate', () => {
      const p = new URLSearchParams(window.location.search);
      const q = p.get('q') || '';
      input.value = q;
      updateClearBtn();
      if (debounceId !== null) window.clearTimeout(debounceId);
      applyFilter(q);
    });

    /* ---------- INIT (fetch JSON) ---------- */
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') || '';
    input.value = initialQuery;
    updateClearBtn();

    fetch(API, { headers: { Accept: 'application/json' } })
      .then(res => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.json() as Promise<IndexItem[]>;
      })
      .then(json => {
        if (!Array.isArray(json)) {
          console.error('[Search] Invalid payload');
          return;
        }

        index = json.map(item => ({
          item,
          search: (item.t || '').toLowerCase(),
        }));

        ready = true;

        if (initialQuery.trim().length >= MIN_QUERY) {
          applyFilter(initialQuery);
        } else {
          applyFilter('');
        }
      })
      .catch(err => {
        console.error('[Search] fetch failed:', err);
        status.textContent = 'Gagal memuat data. Coba refresh halaman.';
        status.hidden = false;
      });
  })();
</script>

<style>
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .search-form {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .search-input-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .search-input {
    width: 100%;
    min-width: 0;
    min-height: 2.25rem;
    padding: var(--s-2) var(--s-10) var(--s-2) calc(var(--s-4) * 2.5);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    color: var(--text-primary);
    font-size: var(--fs-base);
    transition: border-color var(--t-fast);
  }

  .search-input-icon {
    position: absolute;
    left: var(--s-4);
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input-icon :global(svg) {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  .search-input::placeholder { color: var(--text-muted); }
  .search-input:focus { outline: none; border-color: var(--accent); }
  .search-input-wrap:focus-within .search-input-icon { color: var(--accent); }

  .search-input::-webkit-search-cancel-button,
  .search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-clear {
    position: absolute;
    right: var(--s-2);
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--t-fast);
  }

  .search-clear:hover { color: var(--text-primary); }
  .search-clear[hidden] { display: none; }
  .search-clear :global(svg) { width: 1em; height: 1em; flex-shrink: 0; }

  .search-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    text-align: center;
    padding: var(--s-12) var(--s-4);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .search-empty[hidden] { display: none; }
  .search-empty p { margin: 0; }
  .search-empty-hint { font-size: var(--fs-xs); }

  .search-empty a {
    position: relative;
    color: var(--accent);
    transition: color var(--t-fast);
    &::after {
      content: '';
      position: absolute;
      left: -3%;
      right: -3%;
      bottom: -0.1em;
      height: 0.45em;
      background-color: var(--accent);
      -webkit-mask-image: var(--underline);
      mask-image: var(--underline);
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--t-fast);
    }
    &:hover { color: var(--accent-hover); }
    &:hover::after { opacity: 1; }
  }

  .search-status {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
  .search-status[hidden] { display: none; }

  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }
  .anime-grid[hidden] { display: none; }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    padding-block: var(--s-4);
  }
  .load-more-wrap[hidden] { display: none; }

  @media (min-width: 50rem) {
    .search-form { flex-direction: row; align-items: center; }
    .anime-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }
</style>

<style is:global>
  .anime-card {
    display: block;
    min-width: 0;
    background: var(--bg-elevated);
    border: 1px solid transparent;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--t-fast);
  }

  .anime-card .cover {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .anime-card .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--t-base);
  }

  .anime-card:hover .cover img {
    transform: scale(1.03);
  }

  .anime-card:hover h3::after {
    opacity: 1;
  }

  .anime-card .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(0, 0, 0, 0.6) 100%
    );
    pointer-events: none;
  }

  .anime-card .type-badge {
    position: absolute;
    top: var(--s-2);
    right: var(--s-2);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.7);
    color: var(--text-inverted);
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .anime-card .status-overlay {
    position: absolute;
    bottom: var(--s-2);
    left: var(--s-2);
    z-index: 2;
  }

  .anime-card .status-overlay span {
    text-transform: uppercase;
  }

  .anime-card .info {
    padding: var(--s-3);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .anime-card .info h3 {
    position: relative;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    margin: 0;
    min-width: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .anime-card .info h3::after {
    content: '';
    position: absolute;
    left: -3%;
    right: -3%;
    bottom: -0.1em;
    height: 0.45em;
    background-color: var(--text-primary);
    -webkit-mask-image: var(--underline);
    mask-image: var(--underline);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--t-fast);
  }

  .anime-card .episodes {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    font-weight: var(--fw-medium);
  }

  .anime-card .episodes[hidden] {
    display: none;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    white-space: nowrap;
    border: 1px solid transparent;
    line-height: 1;
  }

  .badge-sm {
    padding: 0.1875rem var(--s-2);
    font-size: 0.625rem;
  }

  .badge-default {
    background: var(--bg-surface);
    color: var(--text-secondary);
  }

  .badge-success {
    background: var(--success-soft);
    color: var(--success);
  }

  .badge-warning {
    background: var(--warning-soft);
    color: var(--warning);
  }
</style>