---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV_LINKS } from '../constants';
---

<BaseLayout
  title="404 — Halaman Tidak Ditemukan"
  description="Halaman yang kamu cari tidak ditemukan."
  noindex={true}
>
  <div class="wrapper">
    <div class="error-page">
      <div class="error-code" aria-hidden="true">404</div>

      <h1 class="error-title">Halaman Tidak Ditemukan</h1>

      <p class="error-desc">
        Anime atau halaman yang kamu cari mungkin sudah dihapus,
        dipindahkan, atau tidak pernah ada.
      </p>

      <div class="error-actions">
        <a href="/" class="btn-primary">← Kembali ke Home</a>
      </div>

      <nav class="error-nav" aria-label="Navigasi cepat">
        <p class="error-nav-label">Atau jelajahi:</p>
        <div class="error-links">
          {NAV_LINKS.filter(l => l.href !== '/').map(link => (
            <a href={link.href} class="error-link">{link.label}</a>
          ))}
        </div>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-12);
  }

  .error-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--s-4);
    padding: var(--s-10) var(--s-4);
  }

  .error-code {
    font-size: clamp(5rem, 20vw, 10rem);
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.04em;
    opacity: 0.9;
    user-select: none;
  }

  .error-title {
    font-size: var(--fs-2xl);
    margin: 0;
  }

  .error-desc {
    color: var(--text-secondary);
    max-width: 40ch;
    margin: 0;
    line-height: var(--lh-relaxed);
  }

  .error-actions {
    margin-top: var(--s-2);
  }

  .btn-primary {
    display: inline-block;
    padding: var(--s-3) var(--s-6);
    background: var(--accent);
    color: var(--accent-text);
    border-radius: var(--r-md);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    transition: background var(--t-fast);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: var(--accent-text);
  }

  .error-nav {
    margin-top: var(--s-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
  }

  .error-nav-label {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .error-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
  }

  .error-link {
    padding: var(--s-1) var(--s-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    transition: all var(--t-fast);
  }

  .error-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>