---
import { render, getEntry } from 'astro:content';
import { getAllAnime } from '~/lib/anime';

import {
  SITE, URLS, ADS,
  SOURCE_LABEL,
  type Source,
} from '~/constants';

import BaseLayout from '~/layouts/BaseLayout.astro';
import AdSlot from '~/components/AdSlot.astro';

import AnimeHero from '~/components/AnimeHero.astro';
import AnimeInfo, { type InfoItem } from '~/components/AnimeInfo.astro';
import AnimeRatings from '~/components/AnimeRatings.astro';
import AnimeFranchise from '~/components/AnimeFranchise.astro';
import ShareButton from '~/components/ShareButton.astro';
import EpisodeList from '~/components/EpisodeList.astro';
import Comments from '~/components/Comments.astro';
import SectionLabel from '~/components/SectionLabel.astro';

export async function getStaticPaths() {
  const allAnime = await getAllAnime();
  return allAnime.map((anime) => ({
    params: { slug: anime.id },
    props: { anime },
  }));
}

const { anime } = Astro.props;
const { data } = anime;

const entry = await getEntry('anime', anime.id);
if (!entry) return Astro.redirect('/404/');
const { Content } = await render(entry);

const episodeNumbers = data.episodeList
  .map((e) => e.number)
  .sort((a, b) => a - b);

const hasEpisodes = episodeNumbers.length > 0;
const firstEpisode = episodeNumbers[0] ?? 1;
const totalEpisodes = episodeNumbers.length;

const heroImage = data.cover ?? '';

const genres: { name: string; slug: string }[] = [];
const rawGenres = data.genres ?? [];
for (let i = 0; i < rawGenres.length; i++) {
  const slug = rawGenres[i];
  const name = data.genre[i] ?? slug;
  if (slug && name && name !== 'Unknown') {
    genres.push({ name, slug });
  }
}
const MAX_GENRES = 3;
const visibleGenres = genres.slice(0, MAX_GENRES);

let airedLabel: string | null = null;
if (data.aired?.from) {
  const from = new Intl.DateTimeFormat(SITE.locale, {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(data.aired.from);
  const to = data.aired.to
    ? new Intl.DateTimeFormat(SITE.locale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      }).format(data.aired.to)
    : null;
  airedLabel = to ? `${from} – ${to}` : from;
}

const durationLabel = data.duration ? `${data.duration} menit / episode` : null;
const malScore = data.stats?.score ?? null;
const ageRating = data.rating ?? null;
const studioName = data.studio && data.studio !== 'Unknown' ? data.studio : null;
const sourceLabel = data.source
  ? SOURCE_LABEL[data.source as Source] ?? data.source
  : null;

const year = data.releaseDate?.getFullYear() ?? null;
const pageDescription = [
  `Nonton ${data.title} sub Indo.`,
  studioName,
  year ? String(year) : null,
].filter(Boolean).join(' ');

const infoItems: { label: string; value: string }[] = [];

if (data.type) infoItems.push({ label: 'Tipe', value: data.type });
if (totalEpisodes > 0) infoItems.push({ label: 'Episode', value: String(totalEpisodes) });
if (data.status) infoItems.push({ label: 'Status', value: data.status });
if (airedLabel) infoItems.push({ label: 'Rilis', value: airedLabel });
if (studioName) infoItems.push({ label: 'Studio', value: studioName });
if (sourceLabel) infoItems.push({ label: 'Sumber', value: sourceLabel });
if (malScore != null) infoItems.push({ label: 'Skor MAL', value: `${malScore.toFixed(1)} / 10` });
if (durationLabel) infoItems.push({ label: 'Durasi', value: durationLabel });
---

<BaseLayout
  title={data.title}
  description={pageDescription}
  image={heroImage}
  type="video.other"
>
  <article class="anime-page">
    <AnimeHero
      item={{
        id: anime.id,
        title: data.title,
        background: heroImage,
        age: ageRating,
        genreLinks: visibleGenres.map((g) => ({
          name: g.name,
          href: URLS.genre(g.name),
        })),
        excerpt: null,
        watchUrl: hasEpisodes ? URLS.watch(anime.id, firstEpisode) : undefined,
        watchLabel: hasEpisodes
          ? `Mulai Menonton E${firstEpisode}`
          : 'Belum Ada Episode',
        watchDisabled: !hasEpisodes,
      }}
      size="detail"
      titleTag="h1"
    >
      <Fragment slot="below-meta">
        <AnimeRatings animeId={anime.id} malScore={malScore} />
      </Fragment>

      <Fragment slot="actions">
        <ShareButton title={data.title} />
      </Fragment>
    </AnimeHero>

    <section class="content">
      <div class="content__grid" data-meta>
        <div class="synopsis">
          <SectionLabel>Sinopsis</SectionLabel>
          <div
            class="synopsis__body markdown markdown--prose"
            data-synopsis-body
          >
            <Content />
          </div>
          <button
            type="button"
            class="synopsis__toggle"
            data-synopsis-toggle
          >
            <span data-synopsis-label>Lebih Banyak</span>
          </button>
        </div>
        <AnimeInfo items={infoItems} />
      </div>
    </section>

    <section class="more">
      <EpisodeList
        slug={anime.id}
        episodes={episodeNumbers}
        currentEpisode={null}
      />

      <Comments slug={anime.id} />

      <AnimeFranchise
        currentSlug={anime.id}
        franchises={data.franchises}
      />

      <AdSlot
        format="leaderboard"
        id="ad-anime-inline"
        code={ADS.slots.animeDetailInline}
      />
    </section>
  </article>
</BaseLayout>

<script>
  (function () {
    const bodies = document.querySelectorAll<HTMLElement>('[data-synopsis-body]');
    if (bodies.length === 0) return;

    bodies.forEach((body) => {
      const block = body.closest<HTMLElement>('[data-meta]');
      const btn = block?.querySelector<HTMLButtonElement>('[data-synopsis-toggle]');
      const label = block?.querySelector<HTMLElement>('[data-synopsis-label]');
      if (!block || !btn || !label) return;

      function measure(): void {
        const overflow = body.scrollHeight > body.clientHeight + 2;
        btn!.classList.toggle('is-hidden', !overflow);
        if (!overflow) body.classList.add('is-short');
        else body.classList.remove('is-short');
      }

      if (document.readyState === 'complete') {
        requestAnimationFrame(measure);
      } else {
        window.addEventListener('load', () => requestAnimationFrame(measure), {
          once: true,
        });
      }

      btn.addEventListener('click', () => {
        const expanded = block.classList.toggle('is-expanded');
        label.textContent = expanded ? 'Sembunyikan' : 'Lebih Banyak';
      });
    });
  })();
</script>

<style>
  article.anime-page {
    display: flex;
    flex-direction: column;
  }
  .hero-subindo {
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: hsla(0, 0%, 100%, 0.82);
  }
  .content {
    max-width: var(--content-max-desktop);
    width: 100%;
    margin-inline: auto;
    padding: var(--s-8) var(--pad-x);
  }

  .content__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  .synopsis {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 0;
  }

  .synopsis__body {
    position: relative;
    max-height: calc(var(--fs-base) * var(--lh-relaxed) * 4);
    overflow: hidden;
    mask-image: linear-gradient(to bottom, black calc(100% - 3rem), transparent);
    -webkit-mask-image: linear-gradient(to bottom, black calc(100% - 3rem), transparent);
    color: var(--text-secondary);
    text-align: start;
    transition: max-height var(--t-base);
  }

  .synopsis__body.is-short {
    mask-image: none;
    -webkit-mask-image: none;
  }

  .content__grid.is-expanded .synopsis__body {
    max-height: none;
    mask-image: none;
    -webkit-mask-image: none;
  }

  .synopsis__toggle {
    align-self: flex-start;
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    transition: color var(--t-fast);
  }

  .synopsis__toggle:hover {
    color: var(--accent-hover);
  }

  .synopsis__toggle.is-hidden {
    display: none;
  }

  .more {
    max-width: var(--content-max-desktop);
    width: 100%;
    margin-inline: auto;
    padding: 0 var(--pad-x) var(--s-12);
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  @media (min-width: 50rem) {
    .content {
      padding: var(--s-10) var(--pad-x);
    }
    .content__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--s-10);
      align-items: start;
    }
  }
</style>