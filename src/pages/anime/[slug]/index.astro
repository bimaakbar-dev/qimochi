---
import { getCollection, render } from 'astro:content';
import { SITE, URLS, STATUS_VARIANT, type Status } from '~/constants';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import EpisodeList from '~/components/EpisodeList.astro';
import Badge from '~/user-components/Badge.astro';
import LinkButton from '~/user-components/LinkButton.astro';
import LinkCard from '~/user-components/LinkCard.astro';

export async function getStaticPaths() {
  const allAnime = await getCollection('anime');
  return allAnime.map(anime => ({
    params: { slug: anime.id },
    props: { anime },
  }));
}

const { anime } = Astro.props;
const { data } = anime;
const { Content } = await render(anime);

const episodeNumbers = data.episodes
  .map(e => e.number)
  .sort((a, b) => a - b);

const firstEpisode = episodeNumbers[0] ?? 1;
const statusVariant = STATUS_VARIANT[data.status as Status] ?? 'default';

const statusSlug = data.status.toLowerCase().replace('completed', 'complete');
const statusUrl = `/anime/${statusSlug}/`;

const releaseDate = new Intl.DateTimeFormat(`${SITE.locale}`, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(data.releaseDate);

const year = data.releaseDate.getFullYear();
---

<BaseLayout
  title={data.title}
  description={`Nonton dan download ${data.title} batch. ${data.studio}, ${year}.`}
  image={data.cover}
  type="video.other"
>
  <div class="wrapper">

    <div class="breadcrumb-wrap">
      <Breadcrumb items={[
        { label: 'Home', href: '/' },
        { label: data.status, href: statusUrl },
        { label: data.title },
      ]} />
    </div>

    <section class="hero">
      <div class="hero-cover">
        <img
          src={data.cover}
          alt={`Cover ${data.title}`}
          width="200"
          height="300"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="hero-info">
        <div class="hero-head">
          <Badge variant={statusVariant} size="sm">{data.status}</Badge>
          <h1 class="hero-title">{data.title}</h1>
        </div>

        <dl class="hero-meta">
          <div class="meta-item">
            <dt>Rating</dt>
            <dd>{data.rating} / 10</dd>
          </div>
          <div class="meta-item">
            <dt>Episode</dt>
            <dd>{data.episodes.length}</dd>
          </div>
          <div class="meta-item">
            <dt>Rilis</dt>
            <dd>{releaseDate}</dd>
          </div>
          <div class="meta-item">
            <dt>Studio</dt>
            <dd>{data.studio}</dd>
          </div>
        </dl>

        <ul class="hero-genres">
          {data.genre.map(g => (
            <li>
              <LinkCard
                href={URLS.genre(g)}
                variant="outline"
                padding="sm"
                lift={false}
                class="genre-chip"
              >
                {g}
              </LinkCard>
            </li>
          ))}
        </ul>

        <LinkButton
          href={URLS.watch(anime.id, firstEpisode)}
          variant="accent"
          size="lg"
          icon="play"
        >
          Mulai dari Episode {firstEpisode}
        </LinkButton>
      </div>
    </section>

    <!-- 2 KOLOM -->
    <div class="content-grid">
      <div class="content-main">
        <section class="synopsis-section">
          <h2 class="section-title">Sinopsis</h2>
          <div class="markdown markdown--prose">
            <Content />
          </div>
        </section>
      </div>

      <aside class="content-aside">
        <EpisodeList
          slug={anime.id}
          episodes={episodeNumbers}
          currentEpisode={null}
        />
      </aside>
    </div>

  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
  }

  .breadcrumb-wrap {
    margin-bottom: var(--s-5);
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: var(--s-5);
    margin-bottom: var(--s-6);
    text-align: center;
    justify-items: center;
  }

  .hero-cover {
    width: 100%;
    max-width: 200px;
  }

  .hero-cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
  }

  .hero-info {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    align-items: center;
    width: 100%;
  }

  .hero-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
  }

  .hero-title {
    font-size: var(--fs-xl);
    margin: 0;
    line-height: var(--lh-snug);
  }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3) var(--s-4);
    width: 100%;
    margin: 0;
    text-align: left;
    align-items: center;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .hero-meta dt {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-meta dd {
    font-size: var(--fs-sm);
    color: var(--text-primary);
    margin: 0;
    line-height: var(--lh-snug);
  }

  .hero-genres {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    align-items: start;
  }

  .content-main {
    min-width: 0;
  }

  .section-title {
    font-size: var(--fs-lg);
    margin: 0 0 var(--s-3);
  }

  @media (min-width: 50rem) {
    .hero {
      grid-template-columns: 200px 1fr;
      gap: var(--s-6);
      padding: var(--s-6);
      text-align: left;
      justify-items: start;
    }

    .hero-cover {
      max-width: none;
    }

    .hero-info {
      align-items: flex-start;
    }

    .hero-head {
      justify-content: flex-start;
    }

    .hero-title {
      font-size: var(--fs-2xl);
    }

    .hero-meta {
      grid-template-columns: repeat(4, 1fr);
    }

    .hero-genres {
      justify-content: flex-start;
    }

    .content-grid {
      grid-template-columns: 1fr var(--aside-width);
    }

    .content-aside {
      position: sticky;
      top: var(--sticky-top);
      max-height: calc(100vh - var(--sticky-top) - var(--s-4));
      overflow-y: auto;
    }
  }
</style>

<style is:global>
  .genre-chip {
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    line-height: 1;
  }
  .genre-chip:hover {
    color: var(--accent) !important;
  }
</style>