---
import { getAllAnime } from '~/lib/anime';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Player from '~/components/Player.astro';
import WatchTitle from '~/components/WatchTitle.astro';
import StreamSelector from '~/components/StreamSelector.astro';
import ActionBar from '~/components/ActionBar.astro';
import DownloadPanel from '~/components/DownloadPanel.astro';
import EpisodeList from '~/components/EpisodeList.astro';

export async function getStaticPaths() {
  const allAnime = await getAllAnime();
  return allAnime.map((anime) => ({
    params: { slug: anime.id },
    props: { anime },
  }));
}

const { anime } = Astro.props;
const { data } = anime;
---

<BaseLayout
  title={`Nonton ${data.title}`}
  description={`Nonton ${data.title} subtitle Indonesia.`}
  image={data.cover}
  type="video.other"
  canonical={`/anime/watch/${anime.id}/`}
  noindex={true}
>
  <div class="wrapper" data-watch-page>
    <!-- ============================================
         BLUR LOADER — nutupin halaman sampai data siap
         ============================================ -->
    <div class="page-loader" data-loader>
      <div class="page-loader__spinner" aria-hidden="true"></div>
      <p class="page-loader__text">Memuat episode...</p>
    </div>

    <!-- ============================================
         CONTENT — di-render kosong dulu, JS yang isi
         ============================================ -->
    <div class="watch-content" data-content>
      <section class="player-section">
        <Player />
      </section>

      <div class="content-grid">
        <div class="content-main">
          <WatchTitle title={data.title} slug={anime.id} />
          <StreamSelector />
          <ActionBar slug={anime.id} />
          <DownloadPanel />
        </div>

        <aside class="content-aside">
          <EpisodeList />
        </aside>
      </div>
    </div>

    <!-- ============================================
         ERROR — kalau fetch gagal
         ============================================ -->
    <div class="watch-state watch-state--error" data-error hidden>
      <p data-error-message>Anime tidak ditemukan.</p>
      <a href="/" class="watch-state__link">Kembali ke Home</a>
    </div>
  </div>

  <!-- ============================================
       STYLE INLINE — bypass Astro tree-shaking
       ============================================ -->
  <style is:inline>
    /* ---- Page Loader (blur overlay) ---- */
    .page-loader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      background: rgba(20, 18, 15, 0.5);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      opacity: 1;
      transition: opacity 0.35s ease;
      pointer-events: all;
    }

    .page-loader[data-hidden="true"] {
      opacity: 0;
      pointer-events: none;
    }

    .page-loader__spinner {
      width: 40px;
      height: 40px;
      border: 3px solid rgba(255, 255, 255, 0.2);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: page-loader-spin 0.8s linear infinite;
    }

    .page-loader__text {
      margin: 0;
      font-size: 0.875rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.85);
      letter-spacing: 0.05em;
    }

    @keyframes page-loader-spin {
      to { transform: rotate(360deg); }
    }

    /* ---- Watch page layout ---- */
    .wrapper {
      padding-block: var(--s-4) var(--s-12);
    }

    .watch-content {
      display: flex;
      flex-direction: column;
      gap: var(--s-5);
    }

    .watch-content[hidden] {
      display: none;
    }

    .player-section {
      margin-bottom: var(--s-5);
    }

    .content-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--s-4);
      align-items: start;
    }

    .content-main {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: var(--s-4);
    }

    .watch-state {
      text-align: center;
      padding: var(--s-12) var(--s-4);
      color: var(--text-muted);
      font-size: var(--fs-sm);
    }

    .watch-state--error p {
      margin: 0 0 var(--s-3);
    }

    .watch-state__link {
      color: var(--accent);
    }

    @media (min-width: 50rem) {
      .content-grid {
        grid-template-columns: 1fr var(--aside-width);
        gap: var(--s-6);
      }

      .content-aside {
        position: sticky;
        top: var(--sticky-top);
        max-height: calc(100vh - var(--sticky-top) - var(--s-4));
        overflow-y: auto;
      }
    }

    /* ==========================================
       WATCH COMPONENTS — bypass tree-shaking
       ========================================== */

    /* ---- Stream Selector ---- */
    .stream-picker {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
    }
    .stream-picker summary {
      display: flex;
      align-items: center;
      gap: var(--s-2);
      padding: var(--s-3) var(--s-4);
      cursor: pointer;
      font-size: var(--fs-sm);
      font-weight: var(--fw-medium);
      list-style: none;
      user-select: none;
    }
    .stream-picker summary::-webkit-details-marker { display: none; }
    .stream-picker summary .current {
      margin-left: auto;
      padding: var(--s-1) var(--s-3);
      background: var(--bg-surface);
      color: var(--accent);
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .stream-picker summary .chevron {
      display: inline-flex;
      align-items: center;
      color: var(--text-muted);
      transition: transform var(--t-base);
    }
    .stream-picker[open] summary .chevron {
      transform: rotate(180deg);
    }
    .stream-body {
      padding: 0 var(--s-4) var(--s-4);
      display: flex;
      flex-direction: column;
      gap: var(--s-3);
    }
    .stream-body .quality-group {
      display: flex;
      flex-direction: column;
      gap: var(--s-2);
    }
    .stream-body .quality-label {
      font-size: var(--fs-xs);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: var(--fw-semibold);
    }
    .stream-body .chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
    }
    .stream-body .chip {
      display: inline-block;
      padding: var(--s-1) var(--s-3);
      background: var(--bg-surface);
      border: 1px solid var(--border);
      font-size: var(--fs-xs);
      font-weight: var(--fw-medium);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all var(--t-fast);
    }
    .stream-body .chip:hover {
      border-color: var(--border-hover);
      color: var(--text-primary);
    }
    .stream-body input[type='radio']:checked + .chip {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-text);
    }

    /* ---- Episode List ---- */
    .episode-list {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      padding: var(--s-4);
    }
    .episode-list summary {
      display: flex;
      align-items: center;
      gap: var(--s-2);
      cursor: pointer;
      font-weight: var(--fw-medium);
      font-size: var(--fs-sm);
      list-style: none;
    }
    .episode-list summary::-webkit-details-marker { display: none; }
    .episode-list summary .count {
      color: var(--text-muted);
      font-weight: var(--fw-normal);
    }
    .episode-list summary .chevron {
      display: inline-flex;
      align-items: center;
      margin-left: auto;
      color: var(--text-muted);
      transition: transform var(--t-base);
    }
    .episode-list[open] summary .chevron {
      transform: rotate(180deg);
    }
    .episode-list .episode-items {
      padding: 0;
      margin: var(--s-3) 0 0;
      list-style: none;
    }
    .episode-list[open] .episode-items {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(2.75rem, 1fr));
      gap: var(--s-2);
    }
    .episode-list .episode-item {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 2.5rem;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      font-size: var(--fs-sm);
      font-weight: var(--fw-medium);
      font-variant-numeric: tabular-nums;
      transition: all var(--t-fast);
    }
    .episode-list .episode-item:hover {
      border-color: var(--border-hover);
      color: var(--text-primary);
    }
    .episode-list .episode-item.active {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-text);
      pointer-events: none;
    }

    /* ---- Download Panel ---- */
    .download-panel {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      padding: var(--s-4);
    }
    .download-panel[hidden] { display: none; }
    .download-panel .panel-title {
      font-size: var(--fs-base);
      font-weight: var(--fw-semibold);
      margin: 0 0 var(--s-3);
      color: var(--text-primary);
    }
    .download-panel .quality-item {
      border-top: 1px solid var(--border);
    }
    .download-panel .quality-item:first-of-type {
      border-top: none;
    }
    .download-panel .quality-item summary {
      display: flex;
      align-items: center;
      gap: var(--s-2);
      padding: var(--s-3) 0;
      cursor: pointer;
      list-style: none;
      font-size: var(--fs-sm);
      user-select: none;
    }
    .download-panel .quality-item summary::-webkit-details-marker { display: none; }
    .download-panel .quality {
      font-weight: var(--fw-semibold);
      color: var(--text-primary);
    }
    .download-panel .size { color: var(--text-muted); }
    .download-panel .chevron {
      display: inline-flex;
      align-items: center;
      margin-left: auto;
      color: var(--text-muted);
      transition: transform var(--t-base);
    }
    .download-panel .quality-item[open] .chevron {
      transform: rotate(180deg);
    }
    .download-panel .servers {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
      padding: 0 0 var(--s-3) 0;
    }
    .download-panel .dl-link {
      display: inline-flex;
      align-items: center;
      gap: var(--s-1);
      padding: var(--s-1) var(--s-3);
      background: var(--bg-surface);
      border: 1px solid var(--border);
      font-size: var(--fs-xs);
      font-weight: var(--fw-medium);
      color: var(--text-secondary);
      transition: all var(--t-fast);
    }
    .download-panel .dl-link:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .download-panel .dl-link svg {
      width: 0.9em;
      height: 0.9em;
    }

    /* ---- Reveal animation (konten muncul) ---- */
    .watch-content {
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    .watch-content[data-ready="true"] {
      opacity: 1;
    }
  </style>
</BaseLayout>

<script define:vars={{ slug: anime.id }}>
  // @ts-nocheck
  const SLUG = slug;

  const $ = (sel, root = document) => root.querySelector(sel);

  const page = $('[data-watch-page]');
  const loader = $('[data-loader]', page);
  const errorEl = $('[data-error]', page);
  const contentEl = $('[data-content]', page);

  function hideLoader() {
    if (!loader) return;
    loader.setAttribute('data-hidden', 'true');
    // Remove from DOM setelah fade selesai
    setTimeout(() => {
      if (loader.parentNode) loader.parentNode.removeChild(loader);
    }, 400);
  }

  function readEpFromUrl() {
    const params = new URLSearchParams(location.search);
    const n = parseInt(params.get('ep') || '1', 10);
    return Number.isNaN(n) || n < 1 ? 1 : n;
  }

  function buildUrl(ep) {
    return `/anime/watch/${SLUG}/?ep=${ep}`;
  }

  function renderPlayer(episode) {
    const iframe = $('#player-iframe');
    if (!iframe) return;
    const defaultStream = episode.streams?.[0];
    const defaultServer = defaultStream?.servers?.[0];
    iframe.src = defaultServer?.url ?? '';
  }

  function renderWatchTitle(episode) {
    const epEl = $('[data-watch-ep]');
    if (epEl) epEl.textContent = String(episode.number);
  }

  function renderStreamSelector(episode) {
    const body = $('[data-stream-body]');
    const currentLabel = $('[data-stream-current]');
    const groupTpl = $('[data-stream-group-template]');
    const chipTpl = $('[data-stream-chip-template]');
    if (!body || !groupTpl || !chipTpl) return;

    body.innerHTML = '';

    const savedId = localStorage.getItem('qimochi:stream');
    let defaultLabel = '—';

    episode.streams.forEach((s, i) => {
      const group = groupTpl.content.cloneNode(true);
      $('[data-quality-label]', group).textContent = s.quality;

      const chips = $('[data-quality-chips]', group);

      s.servers.forEach((srv, j) => {
        const frag = chipTpl.content.cloneNode(true);
        const chipId = `s-${i}-${j}`;

        const input = frag.querySelector('[data-stream-input]');
        const label = frag.querySelector('[data-stream-label]');

        input.id = chipId;
        input.value = srv.url;
        input.dataset.quality = s.quality;
        input.dataset.server = srv.name;

        label.htmlFor = chipId;
        label.textContent = srv.name;

        if (i === 0 && j === 0) {
          input.checked = true;
          defaultLabel = `${s.quality} · ${srv.name}`;
        }

        if (savedId === chipId) {
          input.checked = true;
          defaultLabel = `${s.quality} · ${srv.name}`;
        }

        chips.appendChild(frag);
      });

      body.appendChild(group);
    });

    if (currentLabel) currentLabel.textContent = defaultLabel;

    const selected = $('input[name="stream"]:checked', body);
    if (selected) {
      const iframe = $('#player-iframe');
      if (iframe) iframe.src = selected.value;
    }
  }

  function setupStreamEvents() {
    const body = $('[data-stream-body]');
    if (!body) return;

    body.addEventListener('change', (e) => {
      const radio = e.target;
      if (!radio.matches('input[name="stream"]')) return;
      if (!radio.checked) return;

      const iframe = $('#player-iframe');
      if (iframe) iframe.src = radio.value;

      const currentLabel = $('[data-stream-current]');
      if (currentLabel) {
        currentLabel.textContent = `${radio.dataset.quality} · ${radio.dataset.server}`;
      }

      localStorage.setItem('qimochi:stream', radio.id);
    });
  }

  function renderActionBar(episode, totalEpisodes) {
    const hasPrev = episode.number > 1;
    const hasNext = episode.number < totalEpisodes;
    const prevNum = hasPrev ? episode.number - 1 : null;
    const nextNum = hasNext ? episode.number + 1 : null;

    const prevLink = $('[data-prev-link]');
    const prevDisabled = $('[data-prev-disabled]');
    const nextLink = $('[data-next-link]');
    const nextDisabled = $('[data-next-disabled]');

    if (prevLink) {
      prevLink.hidden = !hasPrev;
      if (hasPrev) {
        prevLink.href = buildUrl(prevNum);
        const lbl = $('[data-prev-label]', prevLink);
        if (lbl) lbl.textContent = `Ep ${prevNum}`;
      }
    }
    if (prevDisabled) prevDisabled.hidden = hasPrev;

    if (nextLink) {
      nextLink.hidden = !hasNext;
      if (hasNext) {
        nextLink.href = buildUrl(nextNum);
        const lbl = $('[data-next-label]', nextLink);
        if (lbl) lbl.textContent = `Ep ${nextNum}`;
      }
    }
    if (nextDisabled) nextDisabled.hidden = hasNext;
  }

  function renderDownloads(episode) {
    const panel = $('[data-download-panel]');
    const list = $('[data-download-list]');
    const itemTpl = $('[data-download-item-template]');
    const serverTpl = $('[data-download-server-template]');
    if (!panel || !list || !itemTpl || !serverTpl) return;

    const downloads = episode.downloads ?? [];

    if (downloads.length === 0) {
      panel.hidden = true;
      return;
    }

    panel.hidden = false;
    list.innerHTML = '';

    downloads.forEach((d) => {
      const item = itemTpl.content.cloneNode(true);
      $('[data-download-quality]', item).textContent = d.quality;
      $('[data-download-size]', item).textContent = d.size;

      const servers = $('[data-download-servers]', item);
      d.servers.forEach((srv) => {
        const frag = serverTpl.content.cloneNode(true);
        const a = frag.querySelector('a');
        a.href = srv.url;
        $('[data-download-server-name]', frag).textContent = srv.name;
        servers.appendChild(frag);
      });

      list.appendChild(item);
    });
  }

  function renderEpisodeList(episodes, currentEp) {
    const list = $('[data-episode-items]');
    const count = $('[data-episode-count]');
    const tpl = $('[data-episode-item-template]');
    if (!list) return;

    if (count) count.textContent = String(episodes.length);
    list.innerHTML = '';

    const canClone = Boolean(tpl);

    episodes.forEach((ep) => {
      let a;
      if (canClone) {
        const li = tpl.content.cloneNode(true);
        a = li.querySelector('a');
        list.appendChild(li);
      } else {
        const li = document.createElement('li');
        a = document.createElement('a');
        a.className = 'episode-item';
        a.innerHTML = '<span class="num"></span>';
        li.appendChild(a);
        list.appendChild(li);
      }

      a.href = buildUrl(ep.number);
      a.dataset.ep = String(ep.number);
      const numEl = a.querySelector('.num');
      if (numEl) numEl.textContent = String(ep.number).padStart(2, '0');

      if (ep.number === currentEp) {
        a.classList.add('active');
        a.setAttribute('aria-current', 'page');
      } else {
        a.classList.remove('active');
        a.removeAttribute('aria-current');
      }
    });

    list.addEventListener('click', (e) => {
      const link = e.target.closest('a[data-ep]');
      if (!link) return;
      e.preventDefault();
      const ep = parseInt(link.dataset.ep, 10);
      if (!Number.isNaN(ep)) goToEpisode(ep);
    });
  }

  let cache = null;

  function renderEpisode(anime, epNumber) {
    const episode = anime.episodes.find((e) => e.number === epNumber);
    if (!episode) {
      showError(`Episode ${epNumber} tidak ditemukan.`);
      return;
    }

    document.title = `${anime.title} Episode ${episode.number}`;

    renderPlayer(episode);
    renderWatchTitle(episode);
    renderStreamSelector(episode);
    renderActionBar(episode, anime.episodes.length);
    renderDownloads(episode);
    renderEpisodeList(anime.episodes, epNumber);

    errorEl.hidden = true;
    contentEl.hidden = false;
    contentEl.setAttribute('data-ready', 'true');
  }

  function showError(msg) {
    contentEl.hidden = true;
    errorEl.hidden = false;
    const msgEl = $('[data-error-message]', errorEl);
    if (msgEl) msgEl.textContent = msg;
    hideLoader();
  }

  function goToEpisode(epNumber) {
    if (!cache) return;
    // Tampilkan loader sambil transisi
    showLoader();
    history.pushState({ ep: epNumber }, '', buildUrl(epNumber));
    renderEpisode(cache, epNumber);
    // Hide loader setelah frame berikutnya
    requestAnimationFrame(() => {
      requestAnimationFrame(() => hideLoader());
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showLoader() {
    let existing = $('[data-loader]');
    if (existing) {
      existing.setAttribute('data-hidden', 'false');
      return;
    }
    const newLoader = document.createElement('div');
    newLoader.className = 'page-loader';
    newLoader.setAttribute('data-loader', '');
    newLoader.innerHTML =
      '<div class="page-loader__spinner"></div>' +
      '<p class="page-loader__text">Memuat episode...</p>';
    document.body.appendChild(newLoader);
  }

  async function init() {
    try {
      const res = await fetch(`/anime/${SLUG}.json`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const anime = await res.json();
      cache = anime;

      setupStreamEvents();

      const ep = readEpFromUrl();
      renderEpisode(anime, ep);

      // Fade out loader setelah konten siap
      requestAnimationFrame(() => {
        requestAnimationFrame(() => hideLoader());
      });
    } catch (err) {
      showError('Gagal memuat data anime.');
      console.error('[watch]', err);
    }

    window.addEventListener('popstate', () => {
      if (!cache) return;
      const ep = readEpFromUrl();
      renderEpisode(cache, ep);
    });
  }

  init();
</script>