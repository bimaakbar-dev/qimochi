---
import {
  getAllWatchPaths,
  type HydratedAnime,
  type EpisodeData,
} from '~/lib/anime';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Player from '~/components/Player.astro';
import EpisodeHeader from '~/components/EpisodeHeader.astro';
import StreamSelector from '~/components/StreamSelector.astro';
import EpisodeActionBar from '~/components/EpisodeActionBar.astro';
import DownloadPanel from '~/components/DownloadPanel.astro';
import Page from '~/components/Page.astro';
import Icon from '~/user-components/Icons.astro';

export async function getStaticPaths() {
  const paths = await getAllWatchPaths();

  return paths.map((p) => ({
    params: { slug: p.slug },
    props: {
      anime: p.anime,
      episodes: p.episodes,
      totalEpisodes: p.totalEpisodes,
    },
  }));
}

interface Props {
  anime: HydratedAnime;
  episodes: EpisodeData[];
  totalEpisodes: number;
}

const { anime, episodes, totalEpisodes } = Astro.props as Props;
const { data } = anime;

const defaultEpisode = episodes[0]!;
const defaultStream = defaultEpisode.streams?.[0];
const defaultServer = defaultStream?.servers?.[0];
const playerSrc = defaultServer?.url ?? '';

const pageTitle = `${data.title} Sub Indo`;
const pageDesc = `Nonton ${data.title} subtitle Indonesia. Total ${totalEpisodes} episode.`;
const canonical = `/anime/watch/${anime.id}/`;

const votesApiBase = import.meta.env.PUBLIC_API_BASE ?? '';

const nextEpForSsr = episodes.find((e) => e.number === defaultEpisode.number + 1) ?? null;
const prevEpForSsr = episodes.find((e) => e.number === defaultEpisode.number - 1) ?? null;
const thumbnail = data.banner ?? data.cover ?? '';

const BATCH_SIZE = 50;
const showFilter = totalEpisodes > 30;
const showBatches = totalEpisodes > BATCH_SIZE;

interface Batch { start: number; end: number }
const batches: Batch[] = [];
if (showBatches) {
  for (let i = 0; i < episodes.length; i += BATCH_SIZE) {
    const chunk = episodes.slice(i, i + BATCH_SIZE);
    batches.push({
      start: chunk[0]!.number,
      end: chunk[chunk.length - 1]!.number,
    });
  }
} else {
  batches.push({
    start: episodes[0]!.number,
    end: episodes[episodes.length - 1]!.number,
  });
}

let activeBatchIdx = 0;
{
  const idx = batches.findIndex(
    (b) => defaultEpisode.number >= b.start && defaultEpisode.number <= b.end
  );
  if (idx >= 0) activeBatchIdx = idx;
}

function isInBatch(n: number, batchIdx: number): boolean {
  const b = batches[batchIdx];
  if (!b) return true;
  return n >= b.start && n <= b.end;
}

const watchData = {
  slug: anime.id,
  animeTitle: data.title,
  cover: data.cover,
  banner: data.banner ?? '',
  thumbnail,
  ageRating: data.rating ?? null,
  votesApiBase,
  episodes: episodes.map((e) => ({
    number: e.number,
    title: e.title ?? null,
    duration: e.duration ?? null,
    streams: e.streams,
    downloads: e.downloads ?? [],
  })),
};

const progressPayload = {
  slug: anime.id,
  title: data.title,
  cover: data.cover,
  episode: defaultEpisode.number,
  total: totalEpisodes,
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  image={data.cover}
  type="video.other"
  canonical={canonical}
  noindex={true}
>
  <section class="player-bleed">
    <Player
      src={playerSrc}
      title={`${data.title} Episode ${defaultEpisode.number}`}
    />
  </section>

  <Page class="wrapper">
    <div class="content-grid">
      <div class="content-main">
        <div data-episode-header>
          <EpisodeHeader
            animeSlug={anime.id}
            animeTitle={data.title}
            episodeNumber={defaultEpisode.number}
            episodeTitle={defaultEpisode.title ?? null}
            ageRating={data.rating ?? null}
            votesApiBase={votesApiBase}
            showReport={true}
          />
        </div>
        <div data-stream-selector>
          <StreamSelector streams={defaultEpisode.streams} />
        </div>
        <div data-download-panel>
          <DownloadPanel downloads={defaultEpisode.downloads ?? []} />
        </div>
      </div>

      <aside class="content-aside">
        <div data-episode-action-bar>
          <EpisodeActionBar
            slug={anime.id}
            animeTitle={data.title}
            currentEpisode={defaultEpisode.number}
            totalEpisodes={totalEpisodes}
            prevEpisode={
              prevEpForSsr
                ? {
                    number: prevEpForSsr.number,
                    title: prevEpForSsr.title ?? null,
                    duration: prevEpForSsr.duration ?? null,
                  }
                : null
            }
            nextEpisode={
              nextEpForSsr
                ? {
                    number: nextEpForSsr.number,
                    title: nextEpForSsr.title ?? null,
                    duration: nextEpForSsr.duration ?? null,
                  }
                : null
            }
            thumbnail={thumbnail}
            server={defaultStream?.quality ?? ''}
            quality={defaultStream?.quality ?? ''}
          />
        </div>
      </aside>
    </div>
  </Page>

  <dialog
    class="ep-modal"
    data-episodes-modal
    aria-labelledby="ep-modal-title"
  >
    <div class="ep-modal__inner">
      <header class="ep-modal__header">
        <div class="ep-modal__heading">
          <h2 class="ep-modal__title" id="ep-modal-title">Episode</h2>
          <p class="ep-modal__subtitle">
            {data.title} · {totalEpisodes} episode
          </p>
        </div>
        <button
          type="button"
          class="ep-modal__close"
          data-episodes-modal-close
          aria-label="Tutup"
        >
          <Icon name="close" size={20} />
        </button>
      </header>

      <div class="ep-modal__body">
        {(showFilter || showBatches) && (
          <div class="ep-modal__controls">
            {showFilter && (
              <input
                type="search"
                class="ep-modal__filter"
                data-episodes-filter
                placeholder="Cari episode..."
                inputmode="numeric"
                autocomplete="off"
                aria-label="Cari episode"
              />
            )}
            {showBatches && (
              <div class="ep-modal__batches" data-episodes-batches role="tablist">
                {batches.map((b, i) => (
                  <button
                    type="button"
                    class:list={[
                      'ep-modal__batch',
                      { 'is-active': i === activeBatchIdx },
                    ]}
                    data-batch-tab
                    data-batch-start={b.start}
                    data-batch-end={b.end}
                    role="tab"
                    aria-selected={i === activeBatchIdx ? 'true' : 'false'}
                  >
                    {b.start}–{b.end}
                  </button>
                ))}
              </div>
            )}
          </div>
        )}

        <div class="ep-modal__grid" data-episodes-grid>
          {episodes.map((ep) => (
            <button
              type="button"
              class:list={[
                'ep-modal__item',
                { 'is-active': ep.number === defaultEpisode.number },
              ]}
              data-episode-modal-item
              data-number={String(ep.number)}
              aria-current={
                ep.number === defaultEpisode.number ? 'page' : undefined
              }
              hidden={isInBatch(ep.number, activeBatchIdx) ? undefined : true}
            >
              <span class="ep-modal__num">
                {String(ep.number).padStart(2, '0')}
              </span>
              {ep.title && (
                <span class="ep-modal__label">{ep.title}</span>
              )}
            </button>
          ))}
        </div>

        <p class="ep-modal__empty" data-episodes-empty hidden>
          Tidak ada episode yang cocok.
        </p>
      </div>
    </div>
  </dialog>

  <script
    type="application/json"
    id="watch-data"
    is:inline
    set:html={JSON.stringify(watchData).replace(/</g, '\\u003c')}
  />

  <script
    type="application/json"
    id="progress-payload"
    is:inline
    set:html={JSON.stringify(progressPayload).replace(/</g, '\\u003c')}
  />

  <script>
    (function () {
      interface WatchEpisode {
        number: number;
        title: string | null;
        duration: number | null;
        streams: { quality: string; servers: { name: string; url: string }[] }[];
        downloads: { quality: string; size: string; servers: { name: string; url: string }[] }[];
      }

      interface WatchData {
        slug: string;
        animeTitle: string;
        cover: string;
        banner: string;
        thumbnail: string;
        ageRating: string | null;
        votesApiBase: string;
        episodes: WatchEpisode[];
      }

      const dataEl = document.getElementById('watch-data');
      if (!dataEl) return;

      let data: WatchData;
      try {
        data = JSON.parse(dataEl.textContent || '{}');
      } catch {
        return;
      }

      if (!data.slug || !data.episodes?.length) return;

      const defaultNumber = data.episodes[0]!.number;
      const modalThumb = data.thumbnail || data.banner || data.cover;

      function writeProgress(epNumber: number): void {
        const payload = {
          slug: data.slug,
          title: data.animeTitle,
          cover: data.cover,
          episode: epNumber,
          total: data.episodes.length,
        };
        try {
          const KEY = 'qimochi:continue';
          const raw = localStorage.getItem(KEY);
          let list: unknown[] = [];
          if (raw) {
            const parsed = JSON.parse(raw);
            if (Array.isArray(parsed)) list = parsed;
          }
          list = list.filter(
            (x): x is Record<string, unknown> =>
              !!x && typeof x === 'object' && (x as any).slug !== data.slug
          );
          list.unshift({ ...payload, ts: Date.now() });
          localStorage.setItem(KEY, JSON.stringify(list.slice(0, 20)));
        } catch {}
      }

      function getEpisode(n: number): WatchEpisode | null {
        return data.episodes.find((e) => e.number === n) ?? null;
      }

      function urlFor(n: number): string {
        return n === defaultNumber
          ? `/anime/watch/${data.slug}/`
          : `/anime/watch/${data.slug}/?ep=${n}`;
      }

      function readUrlEpisode(): number {
        const sp = new URLSearchParams(location.search);
        const n = parseInt(sp.get('ep') ?? '', 10);
        if (!isNaN(n) && getEpisode(n)) return n;

        const m = location.pathname.match(/\/episodes\/(\d+)\/?$/);
        if (m) {
          const n2 = parseInt(m[1] ?? '', 10);
          if (!isNaN(n2) && getEpisode(n2)) return n2;
        }
        return defaultNumber;
      }

      const modalEl = document.querySelector<HTMLDialogElement>('[data-episodes-modal]');
      const modalGrid = modalEl?.querySelector<HTMLElement>('[data-episodes-grid]') ?? null;
      const modalClose = modalEl?.querySelector<HTMLButtonElement>('[data-episodes-modal-close]') ?? null;
      const modalFilter = modalEl?.querySelector<HTMLInputElement>('[data-episodes-filter]') ?? null;
      const modalBatches = modalEl?.querySelector<HTMLElement>('[data-episodes-batches]') ?? null;
      const modalEmpty = modalEl?.querySelector<HTMLElement>('[data-episodes-empty]') ?? null;
      const modalBatchTabs = Array.from(
        modalEl?.querySelectorAll<HTMLButtonElement>('[data-batch-tab]') ?? []
      );
      const modalItems = Array.from(
        modalEl?.querySelectorAll<HTMLElement>('[data-episode-modal-item]') ?? []
      );
      const openModalBtn = document.querySelector<HTMLButtonElement>('[data-open-episodes-modal]');

      let modalBatchIdx = modalBatchTabs.findIndex((t) => t.classList.contains('is-active'));
      if (modalBatchIdx < 0) modalBatchIdx = 0;

      function isInModalBatch(n: number): boolean {
        if (modalBatchTabs.length === 0) return true;
        const tab = modalBatchTabs[modalBatchIdx];
        if (!tab) return true;
        const s = Number(tab.dataset.batchStart);
        const e = Number(tab.dataset.batchEnd);
        return n >= s && n <= e;
      }

      function applyModalVisibility(): void {
        if (!modalEl) return;
        const q = (modalFilter?.value ?? '').trim();
        const filtering = q.length > 0;
        if (modalBatches) modalBatches.hidden = filtering;

        let visible = 0;
        for (const el of modalItems) {
          const num = el.dataset.number ?? '';
          const n = Number(num);
          const show = filtering ? num.includes(q) : isInModalBatch(n);
          el.hidden = !show;
          if (show) visible++;
        }
        if (modalEmpty) modalEmpty.hidden = visible > 0;
      }

      function syncModalActive(n: number): void {
        for (const el of modalItems) {
          const num = Number(el.dataset.number);
          const active = num === n;
          el.classList.toggle('is-active', active);
          if (active) el.setAttribute('aria-current', 'page');
          else el.removeAttribute('aria-current');
        }
      }

      let currentNumber = defaultNumber;

      function openModal(): void {
        if (!modalEl) return;

        if (modalBatchTabs.length > 0) {
          const idx = modalBatchTabs.findIndex((t) => {
            const s = Number(t.dataset.batchStart);
            const e = Number(t.dataset.batchEnd);
            return currentNumber >= s && currentNumber <= e;
          });
          if (idx >= 0) {
            modalBatchIdx = idx;
            modalBatchTabs.forEach((t, j) => {
              t.classList.toggle('is-active', j === idx);
              t.setAttribute('aria-selected', j === idx ? 'true' : 'false');
            });
          }
        }

        if (modalFilter) modalFilter.value = '';
        syncModalActive(currentNumber);
        applyModalVisibility();

        modalEl.showModal();
        document.body.style.overflow = 'hidden';
      }

      function closeModal(): void {
        if (!modalEl) return;
        if (modalEl.open) modalEl.close();
      }

      if (modalEl) {
        modalEl.addEventListener('close', () => {
          document.body.style.overflow = '';
        });
        modalEl.addEventListener('click', (e) => {
          if (e.target === modalEl) closeModal();
        });
      }

      if (openModalBtn) openModalBtn.addEventListener('click', openModal);
      if (modalClose) modalClose.addEventListener('click', closeModal);
      if (modalFilter) modalFilter.addEventListener('input', applyModalVisibility);

      modalBatchTabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
          modalBatchIdx = i;
          modalBatchTabs.forEach((t, j) => {
            t.classList.toggle('is-active', j === i);
            t.setAttribute('aria-selected', j === i ? 'true' : 'false');
          });
          applyModalVisibility();
        });
      });

      if (modalGrid) {
        modalGrid.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLElement>(
            '[data-episode-modal-item]'
          );
          if (!btn) return;
          const n = Number(btn.dataset.number);
          if (isNaN(n) || !getEpisode(n)) return;
          switchEpisode(n);
          closeModal();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      function switchEpisode(n: number, push = true): void {
        const ep = getEpisode(n);
        if (!ep) return;
        if (n === currentNumber && !push) return;

        currentNumber = n;

        const firstServer = ep.streams[0]?.servers[0];

        const player = (window as any).__qimochiPlayer;
        if (player?.load && firstServer) {
          player.load(firstServer.url, `Ep ${n}`);
        } else if (firstServer) {
          const iframe = document.getElementById('player-iframe') as HTMLIFrameElement | null;
          if (iframe) iframe.src = firstServer.url;
        }

        const headingEl = document.querySelector<HTMLElement>(
          '[data-episode-header] .ep-header__episode'
        );
        if (headingEl) {
          headingEl.textContent = ep.title?.trim() ? ep.title : `Episode ${n}`;
        }

        const votesRoot = document.querySelector<HTMLElement>(
          '[data-episode-header] [data-votes]'
        );
        if (votesRoot) {
          votesRoot.dataset.ep = String(n);
          const reloadFn = (window as any).__qimochiVotes?.reload;
          if (typeof reloadFn === 'function') {
            reloadFn(votesRoot, data.slug, n, data.votesApiBase);
          }
        }

        const streamRoot = document.querySelector<HTMLElement>('[data-stream-selector]');
        if (streamRoot) {
          const mountFn = (window as any).__qimochiStream?.mount;
          if (typeof mountFn === 'function') {
            mountFn(streamRoot, ep.streams);
          }
        }

        const dlRoot = document.querySelector<HTMLElement>('[data-download-panel]');
        if (dlRoot) {
          const mountDl = (window as any).__qimochiDownload?.mount;
          if (typeof mountDl === 'function') {
            mountDl(dlRoot, ep.downloads);
          }
        }

        const actionRoot = document.querySelector<HTMLElement>('[data-episode-action-bar]');
        if (actionRoot) {
          const mountAction = (window as any).__qimochiActionBar?.mount;
          if (typeof mountAction === 'function') {
            const prevEp = data.episodes.find((e) => e.number === n - 1) ?? null;
            const nextEp = data.episodes.find((e) => e.number === n + 1) ?? null;

            mountAction(actionRoot, {
              slug: data.slug,
              current: n,
              total: data.episodes.length,
              thumbnail: modalThumb,
              prev: prevEp
                ? {
                    number: prevEp.number,
                    title: prevEp.title ?? null,
                    duration: prevEp.duration ?? null,
                  }
                : null,
              next: nextEp
                ? {
                    number: nextEp.number,
                    title: nextEp.title ?? null,
                    duration: nextEp.duration ?? null,
                  }
                : null,
            });
          }
        }

        syncModalActive(n);

        if (push) {
          const target = urlFor(n);
          history.pushState({ ep: n }, '', target);
        }

        writeProgress(n);
        document.title = `${data.animeTitle} Episode ${n} | Qimochi`;
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        const actionLink = target.closest<HTMLAnchorElement>('[data-episode-nav]');
        if (actionLink) {
          const n = Number(actionLink.dataset.episodeNav);
          if (!isNaN(n) && getEpisode(n)) {
            e.preventDefault();
            switchEpisode(n);
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }
        }
      });

      window.addEventListener('popstate', () => {
        const n = readUrlEpisode();
        if (n !== currentNumber) switchEpisode(n, false);
      });

      const initial = readUrlEpisode();
      if (initial !== defaultNumber) {
        switchEpisode(initial, false);
        const target = urlFor(initial);
        history.replaceState({ ep: initial }, '', target);
      } else {
        writeProgress(defaultNumber);
      }
    })();
  </script>
</BaseLayout>

<style>
  .player-bleed {
    width: 100%;
    background: #000;
    display: flex;
    justify-content: center;
  }

  .player-bleed :global(.player-wrapper) {
    width: min(100%, calc(min(480px, 60vh) * 16 / 9));
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    border: none;
  }

  .wrapper {
    padding-block: var(--s-4) var(--s-12);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
    align-items: start;
  }

  .content-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .content-aside {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  @media (min-width: 50rem) {
    .content-grid {
      grid-template-columns: 1fr var(--aside-width);
      gap: var(--s-6);
    }

    .content-aside {
      position: sticky;
      top: var(--sticky-top);
      max-height: calc(100vh - var(--sticky-top) - var(--s-4));
      overflow-y: auto;
    }
  }
</style>

<style is:global>
  .ep-modal {
    width: 100%;
    max-width: 52rem;
    max-height: calc(100vh - 2rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    margin: auto;
    overflow: hidden;
  }

  .ep-modal::backdrop {
    background: hsla(0, 0%, 0%, 0.7);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .ep-modal[open] {
    animation: ep-modal-in 0.18s ease-out;
  }

  @keyframes ep-modal-in {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ep-modal[open] { animation: none; }
  }

  .ep-modal__inner {
    display: flex;
    flex-direction: column;
    max-height: inherit;
    min-height: 0;
  }

  .ep-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .ep-modal__heading {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ep-modal__title {
    margin: 0;
    font-family: var(--font-montserrat);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .ep-modal__subtitle {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ep-modal__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: color var(--t-fast), background var(--t-fast);
  }

  .ep-modal__close:hover {
    color: var(--text-primary);
    background: var(--bg-surface);
  }

  .ep-modal__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-5) var(--s-5);
    overflow-y: auto;
    min-height: 0;
    flex: 1 1 auto;
  }

  .ep-modal__controls {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    flex-shrink: 0;
  }

  .ep-modal__filter {
    width: 100%;
    padding: var(--s-2) var(--s-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: var(--fs-sm);
    border-radius: var(--r-sm);
    transition: border-color var(--t-fast);
  }
  .ep-modal__filter::placeholder { color: var(--text-muted); }
  .ep-modal__filter:focus {
    outline: none;
    border-color: var(--accent);
  }
  .ep-modal__filter::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .ep-modal__batches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }

  .ep-modal__batches[hidden] { display: none; }

  .ep-modal__batch {
    padding: var(--s-1) var(--s-3);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: inherit;
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
