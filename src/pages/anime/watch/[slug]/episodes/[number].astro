---
import {
  getAllEpisodePaths,
  type HydratedAnime,
  type EpisodeData,
} from '~/lib/anime';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import Player from '~/components/Player.astro';
import WatchTitle from '~/components/WatchTitle.astro';
import StreamSelector from '~/components/StreamSelector.astro';
import ActionBar from '~/components/ActionBar.astro';
import DownloadPanel from '~/components/DownloadPanel.astro';
import EpisodeList from '~/components/EpisodeList.astro';
import AnimeFranchise from '~/components/AnimeFranchise.astro';

export async function getStaticPaths() {
  const paths = await getAllEpisodePaths();

  return paths.map((p) => ({
    params: {
      slug: p.slug,
      number: String(p.episode.number),
    },
    props: {
      anime: p.anime,
      episode: p.episode,
      totalEpisodes: p.totalEpisodes,
    },
  }));
}

interface Props {
  anime: HydratedAnime;
  episode: EpisodeData;
  totalEpisodes: number;
}

const { anime, episode, totalEpisodes } = Astro.props as Props;
const { data } = anime;

const episodeNumbers = data.episodes
  .map((e) => e.number)
  .sort((a, b) => a - b);

const defaultStream = episode.streams?.[0];
const defaultServer = defaultStream?.servers?.[0];
const playerSrc = defaultServer?.url ?? '';

const pageTitle = `${data.title} Episode ${episode.number}`;
const pageDesc = `Nonton ${data.title} Episode ${episode.number} subtitle Indonesia.`;
const canonical = `/anime/watch/${anime.id}/episodes/${episode.number}/`;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Archive', href: '/anime/' },
  { label: data.title, href: `/anime/${anime.id}/` },
  { label: `Episode ${episode.number}` },
];

const progressPayload = {
  slug: anime.id,
  title: data.title,
  cover: data.cover,
  episode: episode.number,
  total: totalEpisodes,
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  image={data.cover}
  type="video.other"
  canonical={canonical}
  noindex={true}
>
  <div class="wrapper">
    <div class="breadcrumb-wrap">
      <Breadcrumb items={breadcrumbItems} />
    </div>

    <section class="player-section">
      <Player
        src={playerSrc}
        title={`${data.title} Episode ${episode.number}`}
      />
    </section>

    <div class="content-grid">
      <div class="content-main">
        <WatchTitle
          title={data.title}
          slug={anime.id}
          episodeNumber={episode.number}
        />

        <StreamSelector streams={episode.streams} />

        <ActionBar
          slug={anime.id}
          episodeNumber={episode.number}
          totalEpisodes={totalEpisodes}
        />

        <DownloadPanel downloads={episode.downloads ?? []} />

        <AnimeFranchise
          currentSlug={anime.id}
          franchises={data.franchises}
        />
      </div>

      <aside class="content-aside">
        <EpisodeList
          slug={anime.id}
          episodes={episodeNumbers}
          currentEpisode={episode.number}
        />
      </aside>
    </div>
  </div>

  <script
    type="application/json"
    id="progress-payload"
    is:inline
    set:html={JSON.stringify(progressPayload).replace(/</g, '\\u003c')}
  />

  <script>
    (function () {
      const KEY = 'qimochi:continue';
      const MAX_ITEMS = 20;
      const el = document.getElementById('progress-payload');
      if (!el) return;

      type ProgressItem = {
        slug: string;
        title: string;
        cover: string;
        episode: number;
        total: number;
        ts: number;
      };

      let payload: Omit<ProgressItem, 'ts'>;
      try {
        payload = JSON.parse(el.textContent || '{}');
      } catch {
        return;
      }

      if (!payload.slug) return;

      let list: ProgressItem[] = [];
      try {
        const raw = localStorage.getItem(KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) list = parsed;
        }
      } catch {}

      list = list.filter(x => x && typeof x.slug === 'string');
      list = list.filter(x => x.slug !== payload.slug);

      list.unshift({
        ...payload,
        ts: Date.now(),
      });

      if (list.length > MAX_ITEMS) list = list.slice(0, MAX_ITEMS);

      try {
        localStorage.setItem(KEY, JSON.stringify(list));
      } catch {}

      if (payload.episode < payload.total) {
        const NEXT_KEY = 'qimochi:auto-next';
        try {
          localStorage.setItem(NEXT_KEY, '1');
        } catch {}
      }
    })();
  </script>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-2) var(--s-12);
  }

  .breadcrumb-wrap {
    padding-block: var(--s-2) var(--s-3);
    min-width: 0;
  }

  .player-section {
    margin-bottom: var(--s-5);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    align-items: start;
  }

  .content-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  @media (min-width: 50rem) {
    .content-grid {
      grid-template-columns: 1fr var(--aside-width);
      gap: var(--s-6);
    }

    .content-aside {
      position: sticky;
      top: var(--sticky-top);
      max-height: calc(100vh - var(--sticky-top) - var(--s-4));
      overflow-y: auto;
    }
  }
</style>