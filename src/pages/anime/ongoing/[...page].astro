---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnimeCard from '../../../components/AnimeCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getStatusData, buildStatusPaths, paginate } from '../../../lib/status';

export async function getStaticPaths() {
  const { anime, totalPages } = await getStatusData('ongoing');
  return buildStatusPaths('ongoing', anime, totalPages);
}

const { anime, totalPages, pageNumber } = Astro.props;
const items = paginate(anime, pageNumber);
const isFirstPage = pageNumber === 1;
---

<BaseLayout
  title={isFirstPage ? 'Anime Ongoing' : `Anime Ongoing — Halaman ${pageNumber}`}
  description={`Koleksi ${anime.length} anime yang sedang tayang.`}
  canonical="/anime/ongoing/"
  noindex={!isFirstPage}
>
  <div class="wrapper">
    <header class="page-header">
      <h1>Anime Ongoing</h1>
      <p class="subtitle">
        {anime.length} anime
        {!isFirstPage && ` · Halaman ${pageNumber} dari ${totalPages}`}
      </p>
    </header>

    {items.length > 0 ? (
      <div class="anime-grid">
        {items.map(a => <AnimeCard anime={a} />)}
      </div>
    ) : (
      <p class="empty">Belum ada anime ongoing.</p>
    )}

    <Pagination
      current={pageNumber}
      total={totalPages}
      base="/anime/ongoing"
    />
  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-8) var(--s-12);
  }

  .page-header {
    margin-bottom: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .page-header h1 {
    margin: 0;
    font-size: var(--fs-2xl);
  }

  .subtitle {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }

  @media (min-width: 48rem) {
    .anime-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-4);
    }
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: var(--s-12) 0;
  }
</style>