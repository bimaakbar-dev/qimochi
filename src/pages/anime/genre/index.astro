---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import LinkCard from '~/user-components/LinkCard.astro';
import { URLS } from '~/constants';
import Page from '~/components/Page.astro';

const allGenres = await getCollection('genres');

const categoryOrder = { genre: 0, theme: 1, demographic: 2 } as const;

const genres = allGenres
  .map(g => ({
    id: g.data.id,
    name: g.data.name,
    category: g.data.category,
  }))
  .sort((a, b) => {
    const diff = categoryOrder[a.category] - categoryOrder[b.category];
    if (diff !== 0) return diff;
    return a.name.localeCompare(b.name, 'id-ID');
  });
---

<BaseLayout
  title="Semua Genre"
  description="Jelajahi anime berdasarkan genre."
  canonical="/anime/genre/"
>
  <Page class="wrapper">

    <Hero title="Semua Genre" />

    <div class="genre-grid">
      {genres.map(g => (
        <LinkCard
          href={URLS.genre(g.id)}
          variant="outline"
          padding="md"
        >
          <div class="genre-content">
            <span class="genre-name">{g.name}</span>
          </div>
        </LinkCard>
      ))}
    </div>

  </Page>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
    gap: var(--s-6);
  }

  .genre-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  @media (min-width: 48rem) {
    .genre-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }

  .genre-content {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .genre-name {
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    font-size: var(--fs-base);
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
