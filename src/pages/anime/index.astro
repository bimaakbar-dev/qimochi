---
import { getAllAnime } from '~/lib/anime';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import Badge from '~/user-components/Badge.astro';
import { URLS, STATUS_VARIANT, type Status } from '~/constants';
import Page from '~/components/Page.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.qimochi.web.id';

const allAnime = await getAllAnime();

const sorted = [...allAnime].sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'id-ID')
);

function getFirstLetter(title: string): string {
  const first = title[0]?.toUpperCase() ?? '';
  if (/[A-Z]/.test(first)) return first;
  return '#';
}

const letters = new Set<string>();
sorted.forEach(a => letters.add(getFirstLetter(a.data.title)));

const activeLetters = Array.from(letters).sort((a, b) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b);
});

const totalAnime = allAnime.length;

const groups = activeLetters.map(letter => ({
  letter,
  items: sorted.filter(a => getFirstLetter(a.data.title) === letter),
}));
---

<BaseLayout
  title="Archive Anime"
  description="Daftar anime di Qimochi"
  canonical="/anime/"
>
  <Page class="wrapper">

    <Hero
      title="Archive Anime"
      description={`Daftar lengkap ${totalAnime} anime di Qimochi.`}
    />

    <div class="archive-tabs" role="tablist" data-archive>
      <button
        type="button"
        class="archive-tab is-active"
        data-tab="az"
        role="tab"
        aria-selected="true"
      >A - Z</button>
      <button
        type="button"
        class="archive-tab"
        data-tab="top"
        role="tab"
        aria-selected="false"
      >Rating Tertinggi</button>
    </div>

    <div class="archive-panel" data-panel="az">
      {activeLetters.length > 1 && (
        <nav class="letter-nav" aria-label="Navigasi huruf">
          <ul class="letter-list">
            {activeLetters.map(letter => (
              <li><a href={`#letter-${letter}`}>{letter}</a></li>
            ))}
          </ul>
        </nav>
      )}

      {groups.map(({ letter, items }) => (
        <section class="letter-group" id={`letter-${letter}`}>
          <h2 class="letter-heading">{letter}</h2>

          <ol class="anime-list">
            {items.map(anime => (
              <li>
                <a href={URLS.anime(anime.id)} class="anime-link">
                  <span class="anime-title">{anime.data.title}</span>
                  {anime.data.status !== 'Completed' && (
                    <Badge
                      variant={STATUS_VARIANT[anime.data.status as Status]}
                      size="sm"
                    >
                      {anime.data.status}
                    </Badge>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}

      {totalAnime === 0 && (
        <p class="empty">Belum ada anime di database.</p>
      )}
    </div>

    <div class="archive-panel" data-panel="top" hidden>
      <div class="top-filters" data-top-filters hidden>
        <button type="button" class="top-filter is-active" data-min="0">Semua</button>
        <button type="button" class="top-filter" data-min="9">9.0+</button>
        <button type="button" class="top-filter" data-min="8">8.0+</button>
        <button type="button" class="top-filter" data-min="7">7.0+</button>
        <button type="button" class="top-filter" data-min="6">6.0+</button>
      </div>

      <p class="top-status" data-top-status>Memuat rating tertinggi…</p>

      <div class="top-grid" data-top-grid hidden></div>

      <p class="top-empty" data-top-empty hidden>
        Tidak ada anime dengan rating di rentang ini.
      </p>
    </div>

  </Page>
</BaseLayout>

<style>
  .wrapper {
    gap: var(--s-6);
  }

  .archive-tabs {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    padding: 3px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    align-self: flex-start;
  }

  .archive-tab {
    padding: var(--s-2) var(--s-4);
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all var(--t-fast);
  }

  .archive-tab:hover {
    color: var(--text-primary);
  }

  .archive-tab.is-active {
    background: var(--accent);
    color: var(--accent-text);
  }

  .archive-panel[hidden] {
    display: none;
  }

  .letter-nav {
    position: sticky;
    top: var(--header-height);
    z-index: 50;
    background: var(--bg-base);

    margin-inline: calc(var(--pad-x) * -1);
    padding-block: var(--s-3);
    padding-inline: var(--pad-x);
  }

  .letter-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .letter-list a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 var(--s-2);
    background: var(--bg-surface);
    border: 1px solid transparent;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--text-secondary);
    transition: all var(--t-fast);
  }

  .letter-list a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .letter-group {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    scroll-margin-top: calc(var(--header-height) + 4rem);
    margin-bottom: var(--s-4);
  }

  .letter-heading {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    color: var(--accent);
    margin: 0;
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--border);
    letter-spacing: 0.05em;
  }

  .anime-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .anime-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    padding-block: var(--s-3);
    transition: all var(--t-fast);
  }

  .anime-title {
    position: relative;
    font-size: var(--fs-sm);
    color: var(--text-primary);
    font-weight: var(--fw-medium);
    min-width: 0;
    overflow-wrap: anywhere;
    &::after {
      content: '';
      position: absolute;
      left: -3%;
      right: -3%;
      bottom: -0.2em;
      height: 0.45em;
      background-color: var(--accent);
      -webkit-mask-image: var(--underline);
      mask-image: var(--underline);
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--t-fast);
    }
  }

  .anime-link:hover .anime-title {
    color: var(--accent);
  }
  .anime-link:hover .anime-title::after {
    opacity: 1;
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: var(--s-12) 0;
    font-size: var(--fs-sm);
  }

  /* ---------- TOP RATED ---------- */

  .top-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1);
    margin-bottom: var(--s-4);
  }

  .top-filters[hidden] {
    display: none;
  }

  .top-filter {
    padding: var(--s-1) var(--s-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: all var(--t-fast);
  }

  .top-filter:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .top-filter.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .top-status {
    color: var(--text-muted);
    text-align: center;
    padding: var(--s-8) 0;
    font-size: var(--fs-sm);
    margin: 0;
  }

  .top-status[hidden] {
    display: none;
  }

  .top-empty {
    color: var(--text-muted);
    text-align: center;
    padding: var(--s-8) 0;
    font-size: var(--fs-sm);
    margin: 0;
  }

  .top-empty[hidden] {
    display: none;
  }

  .top-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .top-grid[hidden] {
    display: none;
  }

  @media (min-width: 50rem) {
    .top-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }

  .top-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid transparent;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform var(--t-fast), border-color var(--t-fast);
  }

  .top-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .top-cover-wrap {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .top-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--t-base);
  }

  .top-card:hover .top-cover {
    transform: scale(1.04);
  }

  .top-cover-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 55%,
      rgba(0, 0, 0, 0.7) 100%
    );
    pointer-events: none;
  }

  .top-rank {
    position: absolute;
    top: var(--s-2);
    left: var(--s-2);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    height: 1.75rem;
    padding: 0 var(--s-1);
    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    border-radius: var(--r-sm);
    backdrop-filter: blur(6px);
    line-height: 1;
  }

  .top-rank.rank-1 {
    background: var(--gold);
    color: #1a1a1a;
  }
  .top-rank.rank-2 {
    background: #c0c0c0;
    color: #1a1a1a;
  }
  .top-rank.rank-3 {
    background: #cd7f32;
    color: #ffffff;
  }

  .top-score-badge {
    position: absolute;
    bottom: var(--s-2);
    right: var(--s-2);
    z-index: 2;
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.75);
    color: var(--gold);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    border-radius: var(--r-sm);
    backdrop-filter: blur(6px);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .top-score-badge .votes {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.625rem;
    font-weight: var(--fw-medium);
  }

  .top-info {
    padding: var(--s-3);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .top-info h3 {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    margin: 0;
    line-height: var(--lh-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .top-card:hover .top-info h3 {
    color: var(--accent);
  }

  .top-info .top-meta {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>

<script define:vars={{ apiBase }}>
  (function () {
    const wrap = document.querySelector('[data-archive]');
    if (!wrap) return;
    const tabs = wrap.querySelectorAll('[data-tab]');
    const panels = document.querySelectorAll('[data-panel]');
    const filtersEl = document.querySelector('[data-top-filters]');
    const topStatus = document.querySelector('[data-top-status]');
    const topGrid = document.querySelector('[data-top-grid]');
    const topEmpty = document.querySelector('[data-top-empty]');
    const filterBtns = filtersEl
      ? filtersEl.querySelectorAll('[data-min]')
      : [];
    if (!tabs.length || !panels.length || !topStatus || !topGrid || !topEmpty)
      return;

    let loaded = false;
    let loadPromise = null;
    let allScored = [];
    let minRating = 0;

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function renderGrid() {
      const filtered = allScored.filter((a) => a.rating >= minRating);
      topGrid.innerHTML = '';

      if (filtered.length === 0) {
        topGrid.hidden = true;
        topEmpty.hidden = false;
        return;
      }

      topEmpty.hidden = true;
      topGrid.hidden = false;

      const frag = document.createDocumentFragment();
      filtered.forEach((it, i) => {
        const rank = i + 1;
        const rankClass =
          rank === 1 ? 'rank-1' : rank === 2 ? 'rank-2' : rank === 3 ? 'rank-3' : '';
        const a = document.createElement('a');
        a.className = 'top-card';
        a.href = `/anime/${encodeURIComponent(it.slug)}/`;
        a.innerHTML = `
          <div class="top-cover-wrap">
            ${it.cover ? `<img class="top-cover" src="${escapeHtml(it.cover)}" alt="" width="300" height="450" loading="lazy" decoding="async" />` : ''}
            <span class="top-rank ${rankClass}">#${rank}</span>
            <span class="top-score-badge">
              ${it.rating.toFixed(1)}
              <span class="votes">(${it.votes})</span>
            </span>
          </div>
          <div class="top-info">
            <h3>${escapeHtml(it.title)}</h3>
            ${it.type ? `<span class="top-meta">${escapeHtml(it.type)}</span>` : ''}
          </div>
        `;
        frag.appendChild(a);
      });

      topGrid.appendChild(frag);
    }

    function applyFilter(value) {
      minRating = value;
      filterBtns.forEach((b) => {
        b.classList.toggle(
          'is-active',
          Number(b.dataset.min) === minRating
        );
      });
      renderGrid();
    }

    async function loadTop() {
      if (loaded) return;
      if (loadPromise) return loadPromise;

      loadPromise = (async () => {
        topStatus.hidden = false;
        topStatus.textContent = 'Memuat rating tertinggi…';
        topGrid.hidden = true;
        topEmpty.hidden = true;
        if (filtersEl) filtersEl.hidden = true;

        try {
          const [animeRes, ratingsRes] = await Promise.all([
            fetch('/api/anime.json').then((r) => r.json()),
            fetch(`${apiBase}/api/v1/ratings`).then((r) => r.json()),
          ]);

          const animeList = Array.isArray(animeRes) ? animeRes : [];
          const ratingMap = ratingsRes?.data ?? {};

          allScored = animeList
            .map((a) => ({
              slug: a.i,
              title: a.t,
              cover: a.c,
              type: a.y,
              rating: ratingMap[a.i]?.average ?? 0,
              votes: ratingMap[a.i]?.votes ?? 0,
            }))
            .filter((a) => a.votes > 0)
            .sort((a, b) => {
              if (b.rating !== a.rating) return b.rating - a.rating;
              return b.votes - a.votes;
            })
            .slice(0, 100);

          if (allScored.length === 0) {
            topStatus.textContent = 'Belum ada rating.';
            topStatus.hidden = false;
            topGrid.hidden = true;
            topEmpty.hidden = true;
            loaded = true;
            return;
          }

          topStatus.hidden = true;
          if (filtersEl) filtersEl.hidden = false;
          applyFilter(minRating);
          loaded = true;
        } catch (err) {
          console.error('[archive] top load failed', err);
          topStatus.textContent = 'Gagal memuat. Coba refresh.';
        }
      })();

      return loadPromise;
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const v = Number(btn.dataset.min || '0');
        applyFilter(v);
      });
    });

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        tabs.forEach((t) => {
          const isActive = t === tab;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', String(isActive));
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.panel !== target;
        });
        if (target === 'top') loadTop();
      });
    });
  })();
</script>
