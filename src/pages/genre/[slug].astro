---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimeCard from '../../components/AnimeCard.astro';
import Pagination from '../../components/Pagination.astro';
import { GENRES, PER_PAGE } from '../../constants';

export async function getStaticPaths() {
  const allAnime = await getCollection('anime');

  return GENRES.map(genre => {
    const slug = genre.toLowerCase().replace(/\s+/g, '-');
    const anime = allAnime.filter(a => a.data.genre.includes(genre));
    const totalPages = Math.ceil(anime.length / PER_PAGE);

    return {
      params: { slug },
      props: { genre, anime, totalPages },
    };
  });
}

const { genre, anime, totalPages } = Astro.props;
const items = anime.slice(0, PER_PAGE);
const slug = genre.toLowerCase().replace(/\s+/g, '-');

// Halaman 1 = index.astro di dalam folder [slug]
// Jadi kita pakai getStaticPaths untuk halaman 2+ saja
// Solusi: pakai [...page].astro atau folder + index
// Untuk MVP: kita pakai file terpisah (index + [page])
---

<BaseLayout
  title={`Anime ${genre}`}
  description={`Koleksi ${anime.length} anime genre ${genre}.`}
  canonical={`/genre/${slug}/`}
>
  <div class="wrapper">
    <header class="page-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/genre/">← Semua Genre</a>
      </nav>
      <h1>{genre}</h1>
      <p class="subtitle">{anime.length} anime</p>
    </header>

    {items.length > 0 ? (
      <div class="anime-grid">
        {items.map(a => <AnimeCard anime={a} />)}
      </div>
    ) : (
      <p class="empty">Belum ada anime untuk genre ini.</p>
    )}

    <Pagination current={1} total={totalPages} base={`/genre/${slug}`} />
  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-8) var(--s-12);
  }

  .page-header {
    margin-bottom: var(--s-6);
  }

  .breadcrumb {
    margin-bottom: var(--s-3);
    font-size: var(--fs-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .page-header h1 {
    margin: 0 0 var(--s-1);
  }

  .subtitle {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }

  @media (min-width: 48rem) {
    .anime-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-4);
    }
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: var(--s-12) 0;
  }
</style>