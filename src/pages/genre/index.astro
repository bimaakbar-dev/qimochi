---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LinkCard from '../../user-components/LinkCard.astro';
import { GENRES, URLS } from '../../constants';

const allAnime = await getCollection('anime');

const genreCounts: Record<string, number> = {};
allAnime.forEach(a => {
  a.data.genre.forEach(g => {
    genreCounts[g] = (genreCounts[g] || 0) + 1;
  });
});

const genres = GENRES
  .map(name => ({ name, count: genreCounts[name] || 0 }))
  .filter(g => g.count > 0)
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<BaseLayout
  title="Semua Genre"
  description="Jelajahi anime berdasarkan genre."
>
  <div class="wrapper">
    <header class="page-header">
      <h1>Semua Genre</h1>
      <p class="subtitle">{genres.length} genre · {allAnime.length} anime</p>
    </header>

    <div class="genre-grid">
      {genres.map(g => (
        <LinkCard
          href={URLS.genre(g.name)}
          variant="outline"
          padding="md"
        >
          <div class="genre-content">
            <span class="genre-name">{g.name}</span>
            <span class="genre-count">{g.count}</span>
          </div>
        </LinkCard>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-8) var(--s-12);
  }

  .page-header {
    margin-bottom: var(--s-8);
  }

  .page-header h1 {
    margin: 0 0 var(--s-1);
  }

  .subtitle {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .genre-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }

  @media (min-width: 48rem) {
    .genre-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-4);
    }
  }

  /* Space-between: nama kiri, count kanan */
  .genre-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .genre-name {
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    font-size: var(--fs-base);
  }

  .genre-count {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>