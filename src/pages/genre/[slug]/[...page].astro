---
import { getGenreData, paginate, allGenreSlugs } from '~/lib/genre';

import BaseLayout from '~/layouts/BaseLayout.astro';
import AnimeCard from '~/components/AnimeCard.astro';
import Pagination from '~/components/Pagination.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';

export async function getStaticPaths() {
  const paths = [];

  for (const { genre, slug } of allGenreSlugs()) {
    const { anime, totalPages } = await getGenreData(genre);

    if (anime.length === 0) continue;

    paths.push({
      params: { slug, page: undefined },
      props: { genre, anime, totalPages, pageNumber: 1 },
    });

    for (let page = 2; page <= totalPages; page++) {
      paths.push({
        params: { slug, page: String(page) },
        props: { genre, anime, totalPages, pageNumber: page },
      });
    }
  }

  return paths;
}

const { genre, anime, totalPages, pageNumber } = Astro.props;
const items = paginate(anime, pageNumber);
const slug = Astro.params.slug;
const isFirstPage = pageNumber === 1;
---

<BaseLayout
  title={isFirstPage ? `Anime ${genre}` : `Anime ${genre} — Halaman ${pageNumber}`}
  description={`Koleksi ${anime.length} anime genre ${genre}.`}
  canonical={`/genre/${slug}/`}
  noindex={!isFirstPage}
>
  <div class="wrapper">
    <header class="page-header">
      <Breadcrumb items={[
        { label: 'Genre', href: '/genre/' },
        { label: genre },
      ]} />

      <h1>{genre}</h1>
      <p class="subtitle">
        {anime.length} anime
        {!isFirstPage && ` · Halaman ${pageNumber} dari ${totalPages}`}
      </p>
    </header>

    {items.length > 0 ? (
      <div class="anime-grid">
        {items.map(a => <AnimeCard anime={a} />)}
      </div>
    ) : (
      <p class="empty">Belum ada anime untuk genre ini.</p>
    )}

    <Pagination
      current={pageNumber}
      total={totalPages}
      base={`/genre/${slug}`}
    />
  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-8) var(--s-12);
  }

  .page-header {
    margin-bottom: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .page-header h1 {
    margin: 0;
    font-size: var(--fs-2xl);
  }

  .subtitle {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }

  @media (min-width: 48rem) {
    .anime-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-4);
    }
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: var(--s-12) 0;
  }
</style>