---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimeCard from '../components/AnimeCard.astro';
import Badge from '../user-components/Badge.astro';
import LinkButton from '../user-components/LinkButton.astro';
import LinkCard from '../user-components/LinkCard.astro';
import { GENRES, PER_PAGE, URLS } from '../constants';

const allAnime = await getCollection('anime');

// Hero — 3 terbaru
const latest = allAnime
  .sort((a, b) => b.data.addedAt.getTime() - a.data.addedAt.getTime())
  .slice(0, 3);

// Ongoing — 8
const ongoing = allAnime
  .filter(a => a.data.status === 'Ongoing')
  .slice(0, PER_PAGE - 1);

// Completed — 8
const completed = allAnime
  .filter(a => a.data.status === 'Completed')
  .slice(0, PER_PAGE - 1);

// Genre — ambil 8 teratas berdasarkan jumlah anime
const genreCounts: Record<string, number> = {};
allAnime.forEach(a => {
  a.data.genre.forEach(g => {
    genreCounts[g] = (genreCounts[g] || 0) + 1;
  });
});
const genres = GENRES
  .map(name => ({ name, count: genreCounts[name] || 0 }))
  .filter(g => g.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);
---

<BaseLayout title="Qimochi — Nonton & Download Anime Batch">
  <div class="wrapper">

    <!-- 1. HERO CAROUSEL -->
    {latest.length > 0 && (
      <section class="hero-carousel" aria-label="Anime terbaru">
        <div class="hero-track">
          {latest.map((anime, i) => (
            <article class="hero-slide" id={`slide-${i + 1}`}>
              <div class="hero-text">
                <Badge variant="accent" mark>Baru Ditambahkan</Badge>

                <h2 class="hero-title">{anime.data.title}</h2>

                <p class="hero-meta">
                  {anime.data.status} · {anime.data.tahun} · Rating {anime.data.rating}
                </p>

                <LinkButton
                  href={URLS.anime(anime.id)}
                  variant="accent"
                  size="lg"
                  icon="play"
                >
                  Tonton
                </LinkButton>
              </div>

              <div class="hero-cover">
                <img
                  src={anime.data.cover}
                  alt={`Cover ${anime.data.title}`}
                  width="300"
                  height="450"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  decoding="async"
                />
              </div>
            </article>
          ))}
        </div>

        <nav class="hero-dots" aria-label="Navigasi slide">
          {latest.map((_, i) => (
            <a
              href={`#slide-${i + 1}`}
              class:list={['hero-dot', { active: i === 0 }]}
              aria-label={`Slide ${i + 1}`}
            ></a>
          ))}
        </nav>
      </section>
    )}

    <!-- 2. SEARCH -->
    <section class="search-section">
      <form action="/search/" method="get" class="search-form">
        <input
          type="search"
          name="q"
          placeholder="Cari anime..."
          class="search-input"
          aria-label="Cari anime"
        />
      </form>
    </section>

    <!-- 3. ONGOING -->
    {ongoing.length > 0 && (
      <section class="landing-section">
        <header class="section-header">
          <h2 class="section-title">Ongoing</h2>
          <LinkButton
            href={URLS.status('Ongoing')}
            variant="ghost"
            size="sm"
            icon="arrow-right"
            iconPos="suffix"
          >
            Lihat Semua
          </LinkButton>
        </header>
        <div class="anime-grid">
          {ongoing.map(anime => <AnimeCard anime={anime} />)}
        </div>
      </section>
    )}

    <!-- 4. COMPLETED -->
    {completed.length > 0 && (
      <section class="landing-section">
        <header class="section-header">
          <h2 class="section-title">Completed</h2>
          <LinkButton
            href={URLS.status('Completed')}
            variant="ghost"
            size="sm"
            icon="arrow-right"
            iconPos="suffix"
          >
            Lihat Semua
          </LinkButton>
        </header>
        <div class="anime-grid">
          {completed.map(anime => <AnimeCard anime={anime} />)}
        </div>
      </section>
    )}

    <!-- 5. GENRE -->
    {genres.length > 0 && (
      <section class="landing-section">
        <header class="section-header">
          <h2 class="section-title">Genre</h2>
          <LinkButton
            href="/genre/"
            variant="ghost"
            size="sm"
            icon="arrow-right"
            iconPos="suffix"
          >
            Lihat Semua
          </LinkButton>
        </header>
        <div class="genre-grid">
          {genres.map(g => (
            <LinkCard
              href={URLS.genre(g.name)}
              variant="outline"
              padding="md"
            >
              <span class="genre-name">{g.name}</span>
            </LinkCard>
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<script>
  const track = document.querySelector<HTMLElement>('.hero-track');
  const dots = document.querySelectorAll<HTMLElement>('.hero-dot');

  if (track && dots.length > 0) {
    const slides = track.querySelectorAll<HTMLElement>('.hero-slide');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(slides).indexOf(entry.target as HTMLElement);
            dots.forEach((dot, i) => {
              dot.classList.toggle('active', i === index);
            });
          }
        });
      },
      { root: track, threshold: 0.6 }
    );

    slides.forEach((slide) => observer.observe(slide));
  }
</script>

<style>
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
    display: flex;
    flex-direction: column;
    gap: var(--s-10);
  }

  /* ----------------------------------------------------------
     HERO
     ---------------------------------------------------------- */
  .hero-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    scrollbar-width: none;
  }

  .hero-track::-webkit-scrollbar {
    display: none;
  }

  .hero-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    padding: var(--s-5);
    align-items: center;
  }

  .hero-cover {
    order: -1;
    width: 100%;
  }

  .hero-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    text-align: center;
    align-items: center;
  }

  .hero-title {
    font-size: var(--fs-2xl);
    margin: 0;
    color: var(--text-primary);
  }

  .hero-meta {
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .hero-dots {
    display: flex;
    justify-content: center;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    background: var(--border);
    transition: background var(--t-fast), transform var(--t-fast);
  }

  .hero-dot:hover {
    background: var(--border-hover);
  }

  .hero-dot.active {
    background: var(--accent);
    transform: scale(1.3);
  }

  /* ----------------------------------------------------------
     SEARCH
     ---------------------------------------------------------- */
  .search-form {
    width: 100%;
  }

  .search-input {
    width: 100%;
    padding: var(--s-3) var(--s-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: var(--fs-base);
    transition: border-color var(--t-fast);
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  /* ----------------------------------------------------------
     SECTION
     ---------------------------------------------------------- */
  .landing-section {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .section-title {
    font-size: var(--fs-lg);
    margin: 0;
    color: var(--text-primary);
  }

  /* ----------------------------------------------------------
     ANIME GRID
     ---------------------------------------------------------- */
  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }

  @media (min-width: 48rem) {
    .anime-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-4);
    }
  }

  /* ----------------------------------------------------------
     GENRE GRID
     ---------------------------------------------------------- */
  .genre-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }

  @media (min-width: 48rem) {
    .genre-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-4);
    }
  }

  .genre-name {
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
  }

  /* ----------------------------------------------------------
     DESKTOP — HERO SIDE-BY-SIDE
     ---------------------------------------------------------- */
  @media (min-width: 48rem) {
    .hero-slide {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--s-8);
      padding: var(--s-8);
      min-height: 320px;
    }

    .hero-cover {
      order: 0;
      width: auto;
    }

    .hero-cover img {
      max-height: 280px;
      width: auto;
      margin-inline: auto;
    }

    .hero-text {
      text-align: left;
      align-items: flex-start;
    }

    .hero-title {
      font-size: var(--fs-2xl);
    }
  }
</style>