---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import PostCard from '~/components/PostCard.astro';
import { getPublishedPosts } from '~/lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Artikel, berita, dan review anime terbaru dari Qimochi."
  canonical="/blog/"
>
  <div class="wrapper">

    <header class="blog-header">
      <Breadcrumb items={[
        { label: 'Home', href: '/' },
        { label: 'Blog' },
      ]} />
      <h1 class="blog-title">Blog</h1>
    </header>

    <div class="content-grid">
      <section class="content-main">
        {posts.length > 0 ? (
          <div class="post-grid">
            {posts.map((post, i) => (
              <PostCard post={post} featured={i === 0} />
            ))}
          </div>
        ) : (
          <p class="empty">Belum ada artikel.</p>
        )}
      </section>

      <aside class="content-aside">
        <section class="aside-section">
          <h2 class="aside-title">RSS Feed</h2>
          <p class="aside-desc">
            Dapatkan notifikasi saat ada artikel baru tanpa harus buka situs.
          </p>
          <a href="/rss.xml" class="aside-btn">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <circle cx="3" cy="13" r="2"/>
              <path d="M1 6v3a6 6 0 0 1 6 6h3a9 9 0 0 0-9-9zM1 1v3a11 11 0 0 1 11 11h3A14 14 0 0 0 1 1z"/>
            </svg>
            <span>Subscribe</span>
          </a>
        </section>
      </aside>
    </div>

  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  /* ----------------------------------------------------------
     COMPACT HEADER
     ---------------------------------------------------------- */
  .blog-header {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .blog-title {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    margin: 0;
    color: var(--text-primary);
  }

  /* ----------------------------------------------------------
     GRID — main + aside
     ---------------------------------------------------------- */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .content-grid {
      grid-template-columns: 1fr var(--aside-width);
    }

    .content-aside {
      position: sticky;
      top: var(--sticky-top);
      max-height: calc(100vh - var(--sticky-top) - var(--s-4));
      overflow-y: auto;
    }
  }

  .content-main {
    min-width: 0;
  }

  /* ----------------------------------------------------------
     BENTO GRID
     - Mobile: 1 kolom, full-bleed (edge to edge)
     - Desktop: 2 kolom
     - Item pertama: span full width (di semua ukuran)
     ---------------------------------------------------------- */
  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);

    /* Full-bleed di mobile */
    margin-inline: calc(var(--pad-x) * -1);
  }

  @media (min-width: 40rem) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      /* Kembalikan margin di desktop */
      margin-inline: 0;
    }

    /* Featured span 2 kolom — pakai :global untuk tembus ke PostCard */
    .post-grid > :global(:first-child) {
      grid-column: 1 / -1;
    }
  }

  /* ----------------------------------------------------------
     EMPTY
     ---------------------------------------------------------- */
  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: var(--s-12) 0;
    font-size: var(--fs-sm);
  }

  /* ----------------------------------------------------------
     ASIDE
     ---------------------------------------------------------- */
  .content-aside {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .aside-section {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .aside-title {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .aside-desc {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  .aside-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-4);
    background: var(--accent);
    color: var(--accent-text);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: background var(--t-fast);
    align-self: flex-start;
  }

  .aside-btn:hover {
    background: var(--accent-hover);
    color: var(--accent-text);
  }

  .aside-btn svg {
    width: 0.9em;
    height: 0.9em;
  }
</style>