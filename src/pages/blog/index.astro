---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import PostCard from '~/components/PostCard.astro';
import { getPublishedPosts } from '~/lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Artikel, berita, dan review anime terbaru dari Qimochi."
  canonical="/blog/"
>
  <div class="wrapper">
    <header class="page-header">
      <Breadcrumb items={[
        { label: 'Home', href: '/' },
        { label: 'Blog' },
      ]} />

      <h1>Blog</h1>
      <p class="subtitle">{posts.length} artikel</p>
    </header>

    {posts.length > 0 ? (
      <div class="post-grid">
        {posts.map(post => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="empty">Belum ada artikel.</p>
    )}
  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-8) var(--s-12);
  }

  .page-header {
    margin-bottom: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .page-header h1 {
    margin: 0;
    font-size: var(--fs-2xl);
  }

  .subtitle {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }

  @media (min-width: 30rem) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-5);
    }
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: var(--s-12) 0;
  }
</style>